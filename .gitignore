# API keys + secrets
.env
.env.*

# LLM + CLOB response cache (huge, ephemeral, regenerable)
.enhance-cache/

# Internal prep docs (cost projections, research notes, issue pack)
_internal-*.md

# Per-specimen review aids (internal workflow, not for public consumption)
samples/**/ai-review.md

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# enriched data bundle — regenerated by the pipeline, never commit (48M)
web/data/*.json

# API: generated D1 seed (32M, regenerable via npm run export) + wrangler state
api/seed/*.sql
api/.wrangler/
api/node_modules/

# Scratch / experiments / caches (bake-offs, spread experiments, multi-MB intermediates)
_*
marks.jsonl
.kalshi-series-cache/

# scratch logs / wrangler state / backups — declutter `git status` for fresh terminals
.fetch-universe-*.log
.g.html
.wrangler/
*.bak.json
*-bak.json
web/.backup/
web/.retired-routes/
