---
import Base from '../../layouts/Base.astro';
import DemoSwitcher from '../../components/DemoSwitcher.astro';

// Sample JSON brief for the hero — same atomic-claim shape as /signals/[slug] pages
const sampleSignal = {
  signal_id: "CMSIG2026051100001",
  published_at: "2026-05-11T09:30:00-04:00",
  type: "XVD",
  topic: "macro",
  pre_news: false,
  headline: "Fed June 25bp cut: Polymarket 41%, Kalshi 32% — 9pp spread",
  event_id: "CMFEDJUN25C1",
  bullets: [
    "Polymarket prices June 25bp cut at 41.0% on $1.82M 24h volume; Kalshi parallel at 32.0% on $0.61M",
    "9.0pp cross-venue spread up from 4.0pp on May 4, widening over a week",
    "CME FedWatch implied path sits at 36% — both venues bracket the futures-implied probability"
  ],
  primary_market: {
    venue: "polymarket",
    last: 0.410,
    "24h_chg_pp": 3.0,
    "vol_24h_usd": 1820000,
    resolves_at: "2026-06-12",
    arbitration_model: "uma_oracle"
  }
};
const sampleJson = JSON.stringify(sampleSignal, null, 2);
---
<Base title="ClearMarket Signal — Pre-news intelligence (Firecrawl-shape)" description="Pre-news intelligence from prediction markets, structured for institutional research desks and AI agents." noindex bare>
  <DemoSwitcher current="f" />

  <div class="vf">
    <header class="vf-head">
      <a class="vf-brand" href="/demo/f/">
        <span class="vf-mark"></span>
        <span class="vf-wm">ClearMarket<span class="vf-wm-slash">/</span><span class="vf-wm-sub">SIGNAL</span></span>
      </a>
      <nav>
        <a href="/methodology/">Methodology</a>
        <a href="/demo/e/">Signals</a>
        <a href="/api/">API · coming</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="https://github.com/JDSource/clearmarket">GitHub</a>
        <a class="vf-cta-mini" href="mailto:hello@clearmarket.fyi">Contact</a>
      </nav>
    </header>

    <main class="vf-main">
      <div class="vf-corner vf-corner-tl" aria-hidden="true">
        <span class="vf-tag">[ .JSON ]</span>
        <pre class="vf-ascii">{`+++++++++++++++
+ ============= +
+ ============= +
+ ============= +
+++++++++++++++`}</pre>
      </div>
      <div class="vf-corner vf-corner-tr" aria-hidden="true">
        <span class="vf-tag">[ .MCP ]</span>
        <pre class="vf-ascii">{`==--=---=--==
==-=--==-=-==
=---======-==
==-==-==--=--`}</pre>
      </div>
      <div class="vf-corner vf-corner-bl" aria-hidden="true">
        <pre class="vf-ascii vf-ascii-faint">{`. . . . . . . . . .
 . . . . . . . . . .
. . . . . . . . . .
 . . . . . . . . . .`}</pre>
      </div>
      <div class="vf-corner vf-corner-br" aria-hidden="true">
        <span class="vf-tag">[ .ATOMIC ]</span>
        <pre class="vf-ascii">{`========++=
=+=++=+==+=
+=++==+==++
==+==+==+==`}</pre>
      </div>

      <section class="vf-hero">
        <div class="vf-eyebrow">PRE-NEWS · INTELLIGENCE · FOR INVESTORS</div>
        <h1>
          <span class="vf-h1-line">signal before</span>
          <span class="vf-h1-line vf-h1-accent">the headline</span>
        </h1>
        <p class="vf-lede">
          Prediction markets price the gap between when something happens and when news confirms it.
          We surface those signals daily — structured, atomic, machine-readable.
        </p>
        <div class="vf-cta">
          <a class="vf-btn vf-btn-primary" href="/demo/e/">See today&apos;s signals →</a>
          <a class="vf-btn vf-btn-secondary" href="/api/">API · coming soon</a>
        </div>
        <div class="vf-meta">
          <span>Kalshi × Polymarket</span>
          <span class="vf-dot">·</span>
          <span>Daily 04:00 ET</span>
          <span class="vf-dot">·</span>
          <span>Atomic claims + JSON-LD + MCP</span>
        </div>
      </section>

      <section class="vf-sample">
        <div class="vf-sample-frame">
          <div class="vf-sample-bar">
            <span class="vf-sample-dots"><i></i><i></i><i></i></span>
            <span class="vf-sample-title">CM-SIGNAL/atomic-claim · v0.1.0</span>
            <span class="vf-sample-flag">JSON</span>
          </div>
          <pre class="vf-sample-code"><code>{sampleJson}</code></pre>
        </div>
        <p class="vf-sample-cap">
          Every signal is published as an atomic-claim JSON record with field-level provenance, plus Article and Dataset JSON-LD on its own page. Per Marconi&apos;s April 2026 thesis: structured, retrievable, contextualized.
        </p>
      </section>
    </main>

    <footer class="vf-foot">
      <div class="vf-foot-row">
        <a href="/demo/e/">Signals</a>
        <a href="/demo/d/">Data view</a>
        <a href="/methodology/">Methodology</a>
        <a href="/api/">API · coming</a>
        <a href="/mcp/">MCP · coming</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="https://github.com/JDSource/clearmarket">GitHub</a>
        <a href="mailto:hello@clearmarket.fyi">hello@clearmarket.fyi</a>
      </div>
      <div class="vf-foot-mono">Daily 04:00 ET · v0.1.0</div>
    </footer>
  </div>

  <style>
    .vf {
      --vf-bg: #fbf9f3;
      --vf-bg-2: #f5f2e8;
      --vf-surface: #ffffff;
      --vf-fg: #0e1014;
      --vf-fg-muted: #4a4f56;
      --vf-fg-faint: #97968a;
      --vf-border: #d4cfbe;
      --vf-rule: #e6e1d0;
      --vf-accent: #c5481e;    /* signal-orange, sharper than Firecrawl */
      --vf-accent-2: #1a4a8c;  /* deep blue secondary */
      --vf-up: #2d7a4f;
      --vf-down: #b34a3a;
      --vf-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      --vf-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background:
        radial-gradient(circle at 1px 1px, rgba(40,40,40,0.06) 1px, transparent 0),
        var(--vf-bg);
      background-size: 24px 24px, auto;
      color: var(--vf-fg);
      font-family: var(--vf-sans);
      min-height: 100vh;
      margin: -48px -24px -96px;
      padding: 0;
    }
    .vf a { color: inherit; }

    .vf-head {
      max-width: 1240px;
      margin: 0 auto;
      padding: 26px 40px;
      display: flex; justify-content: space-between; align-items: center;
      position: relative; z-index: 2;
    }
    .vf-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .vf-mark {
      width: 24px; height: 24px;
      background: var(--vf-accent);
      border-radius: 50%;
      box-shadow: 0 0 0 4px rgba(197,72,30,0.12);
      display: inline-block;
    }
    .vf-wm {
      font-family: var(--vf-mono);
      font-size: 14px; font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--vf-fg);
    }
    .vf-wm-slash { color: var(--vf-fg-faint); margin: 0 1px; font-weight: 400; }
    .vf-wm-sub { color: var(--vf-accent); font-weight: 700; }
    .vf-head nav { display: flex; gap: 22px; align-items: center; }
    .vf-head nav a {
      font-family: var(--vf-mono); font-size: 11.5px;
      color: var(--vf-fg-muted); text-decoration: none;
      letter-spacing: 0.04em;
    }
    .vf-head nav a:hover { color: var(--vf-fg); }
    .vf-cta-mini {
      border: 1px solid var(--vf-border);
      padding: 6px 12px; border-radius: 2px;
      background: var(--vf-surface);
    }
    .vf-cta-mini:hover { border-color: var(--vf-fg); }

    .vf-main {
      max-width: 1240px;
      margin: 0 auto;
      padding: 40px 40px 80px;
      position: relative;
    }

    .vf-corner {
      position: absolute;
      font-family: var(--vf-mono);
      pointer-events: none;
      z-index: 0;
    }
    .vf-corner-tl { top: 0; left: 16px; }
    .vf-corner-tr { top: 0; right: 16px; text-align: right; }
    .vf-corner-bl { bottom: 60px; left: 16px; }
    .vf-corner-br { bottom: 60px; right: 16px; text-align: right; }
    .vf-tag {
      display: block;
      font-size: 10.5px;
      color: var(--vf-accent);
      letter-spacing: 0.1em;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .vf-ascii {
      font-size: 11px;
      color: var(--vf-fg-faint);
      line-height: 1.3;
      margin: 0;
      white-space: pre;
      letter-spacing: 0.02em;
    }
    .vf-ascii-faint { color: var(--vf-border); }

    .vf-hero {
      text-align: center;
      padding: 60px 24px 72px;
      max-width: 880px;
      margin: 0 auto;
      position: relative; z-index: 1;
    }
    .vf-eyebrow {
      font-family: var(--vf-mono);
      font-size: 11px;
      color: var(--vf-accent);
      letter-spacing: 0.16em;
      font-weight: 600;
      margin-bottom: 22px;
    }
    .vf-hero h1 {
      font-family: var(--vf-sans);
      font-size: clamp(54px, 8vw, 104px);
      font-weight: 800;
      line-height: 0.92;
      letter-spacing: -0.04em;
      margin: 0 0 28px;
      color: var(--vf-fg);
    }
    .vf-h1-line { display: block; }
    .vf-h1-accent { color: var(--vf-accent); }
    .vf-lede {
      font-family: var(--vf-sans);
      font-size: 18px;
      line-height: 1.55;
      color: var(--vf-fg-muted);
      max-width: 580px;
      margin: 0 auto 32px;
      font-weight: 400;
    }
    .vf-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px; }
    .vf-btn {
      display: inline-flex; align-items: center;
      font-family: var(--vf-mono); font-size: 12px;
      padding: 13px 22px;
      border-radius: 2px;
      text-decoration: none;
      letter-spacing: 0.04em;
      border: 1px solid transparent;
    }
    .vf-btn-primary { background: var(--vf-fg); color: var(--vf-bg); font-weight: 600; }
    .vf-btn-primary:hover { background: var(--vf-accent); }
    .vf-btn-secondary { background: var(--vf-surface); color: var(--vf-fg); border-color: var(--vf-border); }
    .vf-btn-secondary:hover { border-color: var(--vf-fg); }
    .vf-meta {
      font-family: var(--vf-mono); font-size: 11px;
      color: var(--vf-fg-faint);
      letter-spacing: 0.04em;
      display: flex; gap: 8px; flex-wrap: wrap; justify-content: center;
    }
    .vf-dot { color: var(--vf-border); }

    .vf-sample {
      max-width: 760px;
      margin: 32px auto 0;
      position: relative; z-index: 1;
    }
    .vf-sample-frame {
      background: var(--vf-surface);
      border: 1px solid var(--vf-border);
      border-radius: 6px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(20,20,20,0.05);
    }
    .vf-sample-bar {
      display: flex; align-items: center; gap: 12px;
      padding: 10px 14px;
      background: var(--vf-bg-2);
      border-bottom: 1px solid var(--vf-border);
      font-family: var(--vf-mono); font-size: 11px;
      color: var(--vf-fg-muted);
    }
    .vf-sample-dots { display: flex; gap: 5px; }
    .vf-sample-dots i {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--vf-border); display: inline-block;
    }
    .vf-sample-title { flex: 1; }
    .vf-sample-flag {
      background: var(--vf-accent); color: var(--vf-bg);
      padding: 2px 7px; border-radius: 2px; font-weight: 600;
      letter-spacing: 0.06em; font-size: 10px;
    }
    .vf-sample-code {
      margin: 0; padding: 18px 22px;
      font-family: var(--vf-mono); font-size: 12px;
      line-height: 1.55;
      color: var(--vf-fg);
      overflow-x: auto;
      max-height: 380px;
    }
    /* JSON syntax highlighting via regex-ish styling — simulated */
    .vf-sample-code code {
      color: var(--vf-fg);
      white-space: pre;
    }
    .vf-sample-cap {
      font-family: var(--vf-sans); font-size: 13px;
      line-height: 1.55;
      color: var(--vf-fg-muted);
      margin: 14px 2px 0;
      max-width: 600px;
    }

    .vf-foot {
      max-width: 1240px;
      margin: 32px auto 0;
      padding: 24px 40px 60px;
      border-top: 1px solid var(--vf-border);
      display: flex; justify-content: space-between; flex-wrap: wrap;
      gap: 14px;
    }
    .vf-foot-row { display: flex; gap: 20px; flex-wrap: wrap; }
    .vf-foot-row a {
      font-family: var(--vf-mono); font-size: 11px;
      color: var(--vf-fg-muted); text-decoration: none;
      letter-spacing: 0.04em;
    }
    .vf-foot-row a:hover { color: var(--vf-fg); }
    .vf-foot-mono {
      font-family: var(--vf-mono); font-size: 10.5px;
      color: var(--vf-fg-faint); letter-spacing: 0.04em;
    }

    @media (max-width: 720px) {
      .vf-corner { display: none; }
      .vf-hero h1 { font-size: 48px; }
      .vf-sample-code { font-size: 11px; padding: 14px; }
    }
  </style>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
</Base>
