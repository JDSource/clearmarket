---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DemoSwitcher from '../../components/DemoSwitcher.astro';

const signals = (await getCollection('signals'))
  .sort((a, b) => new Date(b.data.published_at).getTime() - new Date(a.data.published_at).getTime());

function formatTime(iso: string) {
  const d = new Date(iso);
  return d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }) + ' ET';
}
function fmtPct(n: number) { return (n * 100).toFixed(1) + '%'; }
function fmtPp(n: number | undefined, ref: number | undefined) {
  if (n === undefined || ref === undefined) return '—';
  const d = ref - n;
  const s = d >= 0 ? '+' : '';
  return `${s}${(d * 100).toFixed(1)}pp`;
}
function fmtVol(n: number | undefined) {
  if (!n) return '—';
  if (n >= 1_000_000) return `$${(n/1_000_000).toFixed(2)}M`;
  if (n >= 1_000) return `$${(n/1_000).toFixed(0)}K`;
  return `$${n}`;
}

const categories = Array.from(new Set(signals.map((s) => s.data.category_tag)));
const venues = Array.from(new Set(signals.flatMap((s) => [s.data.primary_market.platform, ...(s.data.related_markets ?? []).map((r) => r.platform)])));

const latestCycle = signals[0]?.data.published_at ?? new Date().toISOString();
const cycleAge = Math.round((Date.now() - new Date(latestCycle).getTime()) / 60000);
---
<Base title="ClearMarket Signal — Demo B" description="Data-forward variant — CoinGecko-shape" noindex bare>
  <DemoSwitcher current="b" />

  <div class="variant-b">
    <header class="bhead">
      <div class="bhead-left">
        <a class="bbrand" href="/demo/b/">ClearMarket<span>·</span>Signal</a>
        <span class="bcycle">Last cycle <strong>{cycleAge}m</strong> ago · Universe <strong>2,847</strong> markets · <strong>{signals.length}</strong> signals today</span>
      </div>
      <nav>
        <a href="/methodology/">Methodology</a>
        <a href="/api/">API</a>
        <a href="https://github.com/JDSource/clearmarket">GitHub</a>
        <a href="/feed.json">JSON</a>
      </nav>
    </header>

    <div class="bfilters">
      <span class="bfilter-label">FILTER</span>
      <button class="fp fp-active">All ({signals.length})</button>
      {categories.map((c) => <button class="fp">{c}</button>)}
      <span class="bfilter-sep">·</span>
      {venues.map((v) => <button class="fp fp-venue">{v}</button>)}
    </div>

    <table class="btable">
      <thead>
        <tr>
          <th class="tcol-time">TIME</th>
          <th class="tcol-tag">TAG</th>
          <th class="tcol-pn">CLASS</th>
          <th class="tcol-headline">HEADLINE</th>
          <th class="tcol-price">PRICE</th>
          <th class="tcol-move">24H</th>
          <th class="tcol-vol">24H VOL</th>
          <th class="tcol-venue">VENUE</th>
          <th class="tcol-link">JSON</th>
        </tr>
      </thead>
      <tbody>
        {signals.map((s) => {
          const m = s.data.primary_market;
          const move = m.price_24h_ago !== undefined ? m.current_price - m.price_24h_ago : null;
          return (
            <tr>
              <td class="tcol-time"><a href={`/signals/${s.data.signal_slug}/`}>{formatTime(s.data.published_at)}</a></td>
              <td class="tcol-tag"><span class={`btag btag-${s.data.category_tag}`}>{s.data.category_tag}</span></td>
              <td class="tcol-pn"><span class={`bpn bpn-${s.data.pre_news_classification}`}>{s.data.pre_news_classification.replace('_', '-')}</span></td>
              <td class="tcol-headline"><a href={`/signals/${s.data.signal_slug}/`}>{s.data.headline}</a></td>
              <td class="tcol-price">{fmtPct(m.current_price)}</td>
              <td class={`tcol-move ${move !== null && move >= 0 ? 'up' : 'down'}`}>
                {move !== null ? (move >= 0 ? '+' : '') + (move * 100).toFixed(1) + 'pp' : '—'}
              </td>
              <td class="tcol-vol">{fmtVol(m.volume_24h_usd)}</td>
              <td class="tcol-venue">{m.platform}{(s.data.related_markets ?? []).length > 0 ? ` + ${(s.data.related_markets ?? [])[0].platform}` : ''}</td>
              <td class="tcol-link"><a href={`/signals/${s.data.signal_slug}/`}>{ }JSON{ }</a></td>
            </tr>
          );
        })}
      </tbody>
    </table>

    <div class="bfooter">
      <span>Open methodology · Public schema · <a href="https://github.com/JDSource/clearmarket">github.com/JDSource/clearmarket</a></span>
      <span><a href="/methodology/">How signals are detected</a> · <a href="mailto:hello@clearmarket.fyi">hello@clearmarket.fyi</a></span>
      <span class="bfooter-mono">Daily cycle · 04:00 ET · CFTC ANPRM RIN 3038-AF65 informed schema</span>
    </div>
  </div>

  <style>
    .variant-b {
      --bb-bg: #f7f8fa;
      --bb-fg: #14181d;
      --bb-fg-muted: #555c66;
      --bb-fg-faint: #8b929a;
      --bb-border: #d8dde3;
      --bb-row-hover: #eef0f4;
      --bb-up: #1d6f42;
      --bb-down: #b34a4a;
      --bb-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      --bb-sans: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
      background: var(--bb-bg);
      color: var(--bb-fg);
      font-family: var(--bb-sans);
      font-size: 13px;
      min-height: 100vh;
      margin: -48px -24px -96px;
      padding: 0;
    }
    .variant-b a { color: inherit; }
    .bhead {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 24px;
      border-bottom: 1px solid var(--bb-border);
      background: #fff;
      gap: 16px;
      flex-wrap: wrap;
    }
    .bhead-left { display: flex; gap: 20px; align-items: baseline; flex-wrap: wrap; }
    .bbrand { font-weight: 700; font-size: 15px; letter-spacing: -0.01em; text-decoration: none; }
    .bbrand span { color: var(--bb-fg-faint); margin: 0 4px; font-weight: 400; }
    .bcycle { font-family: var(--bb-mono); font-size: 11px; color: var(--bb-fg-muted); }
    .bcycle strong { color: var(--bb-fg); font-weight: 600; }
    .bhead nav { display: flex; gap: 16px; font-size: 12px; }
    .bhead nav a { color: var(--bb-fg-muted); text-decoration: none; font-family: var(--bb-mono); letter-spacing: 0.02em; }
    .bhead nav a:hover { color: var(--bb-fg); }

    .bfilters {
      padding: 12px 24px;
      display: flex;
      gap: 6px;
      align-items: center;
      flex-wrap: wrap;
      background: #fcfcfd;
      border-bottom: 1px solid var(--bb-border);
    }
    .bfilter-label, .bfilter-sep { font-family: var(--bb-mono); font-size: 10px; color: var(--bb-fg-faint); letter-spacing: 0.08em; margin-right: 4px; }
    .fp {
      background: #fff;
      border: 1px solid var(--bb-border);
      padding: 4px 10px;
      border-radius: 3px;
      font-family: var(--bb-mono);
      font-size: 10px;
      color: var(--bb-fg-muted);
      cursor: pointer;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .fp:hover { background: var(--bb-row-hover); color: var(--bb-fg); }
    .fp-active { background: var(--bb-fg); color: var(--bb-bg); border-color: var(--bb-fg); }
    .fp-venue { text-transform: capitalize; letter-spacing: 0; }

    .btable {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      background: #fff;
    }
    .btable th {
      text-align: left;
      font-family: var(--bb-mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      color: var(--bb-fg-faint);
      padding: 8px 12px;
      border-bottom: 1px solid var(--bb-border);
      background: #fcfcfd;
      position: sticky;
      top: 0;
    }
    .btable td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--bb-border);
      vertical-align: top;
    }
    .btable tr:hover td { background: var(--bb-row-hover); }
    .btable a { text-decoration: none; }
    .btable a:hover { text-decoration: underline; }

    .tcol-time, .tcol-price, .tcol-move, .tcol-vol { font-family: var(--bb-mono); white-space: nowrap; font-variant-numeric: tabular-nums; }
    .tcol-time { color: var(--bb-fg-muted); font-size: 11px; }
    .tcol-tag, .tcol-pn { white-space: nowrap; }
    .tcol-headline { font-weight: 500; }
    .tcol-price { font-weight: 600; }
    .tcol-move.up { color: var(--bb-up); font-weight: 600; }
    .tcol-move.down { color: var(--bb-down); font-weight: 600; }
    .tcol-venue { font-family: var(--bb-mono); font-size: 11px; color: var(--bb-fg-muted); text-transform: capitalize; }
    .tcol-link { text-align: right; }
    .tcol-link a { font-family: var(--bb-mono); font-size: 10px; color: var(--bb-fg-faint); letter-spacing: 0.06em; padding: 2px 6px; border: 1px solid var(--bb-border); border-radius: 3px; }
    .tcol-link a:hover { background: var(--bb-fg); color: var(--bb-bg); border-color: var(--bb-fg); text-decoration: none; }

    .btag {
      display: inline-block;
      font-family: var(--bb-mono);
      font-size: 9.5px;
      padding: 2px 6px;
      letter-spacing: 0.05em;
      border: 1px solid var(--bb-border);
      border-radius: 3px;
    }
    .btag-CROSS_VENUE_DIVERGENCE { background: #fff4d6; border-color: #e8d77a; color: #6b5400; }
    .btag-MOMENTUM_REPRICING { background: #e0eaf5; border-color: #a8c5e3; color: #2c4d70; }
    .btag-PRE_NEWS_PRICING { background: #d6f0dc; border-color: #6fb88a; color: #1d6f42; }
    .btag-VOLUME_SPIKE { background: #fae5e0; border-color: #d8a59a; color: #7a3b2a; }
    .btag-VS_BENCHMARK_DRIFT { background: #ece0f0; border-color: #b89cc5; color: #5b3576; }
    .btag-COVERAGE_GAP { background: #f0f0f0; border-color: #c0c0c0; color: #4a4a4a; }
    .btag-RESOLUTION_DISPUTED { background: #ffd9d9; border-color: #d68080; color: #8b1a1a; }
    .btag-NEW_LISTING { background: #fff; border-color: var(--bb-border); color: var(--bb-fg-muted); }

    .bpn { font-family: var(--bb-mono); font-size: 10px; letter-spacing: 0.04em; }
    .bpn-pre_news { color: var(--bb-up); font-weight: 700; }
    .bpn-concurrent { color: var(--bb-fg-faint); }
    .bpn-lagging { color: var(--bb-down); }

    .bfooter {
      padding: 16px 24px;
      border-top: 1px solid var(--bb-border);
      background: #fcfcfd;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 12px;
      color: var(--bb-fg-muted);
    }
    .bfooter-mono { font-family: var(--bb-mono); font-size: 11px; color: var(--bb-fg-faint); }
    .bfooter a { color: var(--bb-fg); text-decoration: underline; text-underline-offset: 2px; }

    @media (prefers-color-scheme: dark) {
      .variant-b {
        --bb-bg: #0d1014;
        --bb-fg: #e6e8eb;
        --bb-fg-muted: #aab0b8;
        --bb-fg-faint: #6c727a;
        --bb-border: #232830;
        --bb-row-hover: #1a1e25;
      }
      .bhead, .btable, .btable th, .bfilters, .bfooter { background: #11151b; }
      .btable th { background: #14181f; }
      .fp { background: #14181f; }
    }
  </style>
</Base>
