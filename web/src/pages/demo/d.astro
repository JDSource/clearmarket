---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DemoSwitcher from '../../components/DemoSwitcher.astro';

const signals = (await getCollection('signals'))
  .sort((a, b) => new Date(b.data.published_at).getTime() - new Date(a.data.published_at).getTime());

// Derived for demo — production reads events.category from the schema
function topicFromEventId(eventId: string): string {
  const id = eventId.toUpperCase();
  if (id.includes('FED') || id.includes('CPI') || id.includes('ARG')) return 'macro';
  if (id.includes('IRIL') || id.includes('IRAN') || id.includes('RUCN')) return 'geopolitics';
  if (id.includes('ETF')) return 'crypto';
  if (id.includes('CITI')) return 'crypto';
  return 'macro';
}
function eventShortName(eventSlug: string): string {
  const map: Record<string, string> = {
    'fed-june-2026-25bp-cut': 'Fed Jun · 25bp cut',
    'kalshi-may-cpi-yoy-35-plus': 'May CPI YoY ≥3.5%',
    'argentina-april-inflation-above-3': 'Argentina Apr CPI >3%',
    'putin-xi-may-summit-joint-statement': 'Putin–Xi May summit',
    'blackrock-eth-spot-etf-q2-approval': 'BlackRock ETH ETF Q2',
    'citigroup-ceo-resign-2026': 'Citi CEO resign 2026',
    'iran-israel-ceasefire-may-2026': 'Iran–Israel ceasefire',
    'us-iran-peace-deal-may-2026': 'US–Iran peace deal',
  };
  return map[eventSlug] ?? eventSlug.slice(0, 28);
}

// 3-letter TYPE codes — Bloomberg-shape. Maps schema's category_tag enum to compact codes.
const TYPE_CODE: Record<string, string> = {
  CROSS_VENUE_DIVERGENCE: 'XVD',
  MOMENTUM_REPRICING: 'MOM',
  VS_BENCHMARK_DRIFT: 'BND',
  VOLUME_SPIKE: 'VOL',
  PRE_NEWS_PRICING: 'PRE',
  COVERAGE_GAP: 'COV',
  RESOLUTION_DISPUTED: 'DSP',
  NEW_LISTING: 'NEW',
};

// MECH codes — maps schema's arbitration_model enum to compact codes.
const MECH_CODE: Record<string, string> = {
  uma_oracle: 'UMA',
  kalshi_staff: 'KAL',
  polymarket_staff: 'POL',
  platform_auto: 'AUTO',
  determinations_committee: 'DC',
  other: 'OTH',
};

function formatTime(iso: string) {
  return new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }) + ' ET';
}
function formatRes(iso: string | undefined) {
  if (!iso) return '—';
  return new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric' });
}
function fmtProb(n: number) { return (n * 100).toFixed(1) + '%'; }
function fmtVol(n: number | undefined) {
  if (!n) return '—';
  if (n >= 1_000_000) return `$${(n/1_000_000).toFixed(2)}M`;
  if (n >= 1_000) return `$${(n/1_000).toFixed(0)}K`;
  return `$${n}`;
}
function sparkline(currentPrice: number, prev: number | undefined, seed: number): string {
  const points = 12;
  const start = prev ?? currentPrice;
  const range = currentPrice - start;
  const noise = (i: number) => Math.sin(seed * 7 + i * 1.7) * 0.012;
  const pts: [number, number][] = [];
  for (let i = 0; i < points; i++) {
    const t = i / (points - 1);
    const v = start + range * t + noise(i);
    pts.push([i * (60 / (points - 1)), 18 - v * 16]);
  }
  return pts.map(([x, y], i) => (i === 0 ? `M${x.toFixed(1)},${y.toFixed(1)}` : `L${x.toFixed(1)},${y.toFixed(1)}`)).join(' ');
}

const totalSignals = signals.length;
const preNewsCount = signals.filter((s) => s.data.pre_news_classification === 'pre_news').length;

const enriched = signals.map((s, idx) => ({
  ...s,
  topic: topicFromEventId(s.data.event_id),
  eventShort: eventShortName(s.data.event_slug),
  typeCode: TYPE_CODE[s.data.category_tag] ?? '—',
  mechCode: MECH_CODE[s.data.primary_market.arbitration_model ?? ''] ?? '—',
  spark: sparkline(s.data.primary_market.current_price, s.data.primary_market.price_24h_ago, idx),
  sparkUp: s.data.primary_market.price_24h_ago !== undefined && s.data.primary_market.current_price >= s.data.primary_market.price_24h_ago,
}));

const todaysBrief = `Cross-venue divergence dominates today's set: Polymarket prices the Fed June 25bp cut 9pp wider than Kalshi (41% vs 32%), and the Iran–Israel ceasefire spread sits at 14pp after a week with no convergence. Two flow-only signals — Argentina April CPI and a Citigroup CEO resignation contract — repriced with no public catalyst, flagged pre-news. May CPI on Kalshi prints 10pp below FedWatch consensus, the strongest benchmark-divergence signal of the week.`;
---
<Base title="ClearMarket Signal — Demo D (event-shape headlines, Bloomberg-aligned columns)" description="Event-centric data table with editorial overlay" noindex bare>
  <DemoSwitcher current="d" />

  <div class="variant-d">
    <header class="dhead">
      <div class="dhead-row">
        <a class="dbrand" href="/demo/d/">
          <span class="dbrand-mark">CM</span>
          <span class="dbrand-text">ClearMarket Signal</span>
        </a>
        <nav>
          <a href="/methodology/">Methodology</a>
          <a href="https://github.com/JDSource/clearmarket/tree/main/schema">Schema</a>
          <a href="/api/">API</a>
          <a href="/llms.txt">llms.txt</a>
          <a href="https://github.com/JDSource/clearmarket">GitHub</a>
        </nav>
      </div>
      <p class="dabout">
        Daily structured signals on prediction markets. Built on the open-source <strong>ClearMarket</strong> schema (events, markets, marks, resolution_log). Free public publication; data feed available for institutional redistribution.
      </p>
    </header>

    <div class="dstatus">
      <div class="ds-cell"><span class="ds-label">Cycle</span><span class="ds-val">04:00 ET daily</span></div>
      <div class="ds-cell"><span class="ds-label">Universe</span><span class="ds-val">2,847 markets</span></div>
      <div class="ds-cell"><span class="ds-label">Signals today</span><span class="ds-val">{totalSignals}</span></div>
      <div class="ds-cell"><span class="ds-label">Pre-news flagged</span><span class="ds-val">{preNewsCount}</span></div>
      <div class="ds-cell"><span class="ds-label">Schema</span><span class="ds-val">v0.1.0</span></div>
      <div class="ds-cell ds-cell-right">
        <a href="/feed.json" class="ds-feed">JSON →</a>
        <a href="/rss.xml" class="ds-feed">RSS →</a>
      </div>
    </div>

    <section class="dbrief">
      <div class="dbrief-mark">TODAY'S BRIEF</div>
      <p>{todaysBrief}</p>
      <div class="dbrief-byline">ClearMarket Signal desk · Mon May 11, 2026 · 04:00 ET cycle</div>
    </section>

    <div class="dfilters">
      <span class="df-label">TOPIC</span>
      <button class="fp fp-active">All</button>
      <button class="fp">macro</button>
      <button class="fp">geopolitics</button>
      <button class="fp">politics</button>
      <button class="fp">crypto</button>
      <button class="fp">sports</button>
      <span class="df-sep">·</span>
      <span class="df-label">TYPE</span>
      <button class="fp" title="Cross-venue divergence">XVD</button>
      <button class="fp" title="Vs-benchmark drift">BND</button>
      <button class="fp" title="Momentum repricing on news">MOM</button>
      <button class="fp" title="Volume spike">VOL</button>
      <button class="fp" title="Pre-news pricing">PRE</button>
      <button class="fp" title="Coverage gap">COV</button>
    </div>

    <table class="dtable">
      <thead>
        <tr>
          <th class="c-time">TIME ↓</th>
          <th class="c-event">EVENT</th>
          <th class="c-signal">SIGNAL</th>
          <th class="c-last">LAST</th>
          <th class="c-24h">24H</th>
          <th class="c-spark">7D</th>
          <th class="c-vol">VOL 24H</th>
          <th class="c-res">RES</th>
          <th class="c-mech">MECH</th>
          <th class="c-venue">VENUE</th>
          <th class="c-link"></th>
        </tr>
      </thead>
      <tbody>
        {enriched.map((s) => {
          const m = s.data.primary_market;
          const move = m.price_24h_ago !== undefined ? (m.current_price - m.price_24h_ago) * 100 : null;
          return (
            <tr>
              <td class="c-time">{formatTime(s.data.published_at)}</td>
              <td class="c-event">
                <div class="event-name">{s.eventShort}</div>
                <div class="event-meta">
                  <span class={`topic-pill topic-${s.topic}`}>{s.topic}</span>
                  <span class="event-id">{s.data.event_id}</span>
                </div>
              </td>
              <td class="c-signal">
                <a href={`/signals/${s.data.signal_slug}/`}>{s.data.headline}</a>
                <span class={`type-code type-${s.typeCode}`}>{s.typeCode}</span>
                {s.data.pre_news_classification === 'pre_news' && <span class="type-code type-PRE-flag">PRE</span>}
              </td>
              <td class="c-last">{fmtProb(m.current_price)}</td>
              <td class={`c-24h ${move !== null && move >= 0 ? 'up' : 'down'}`}>
                {move !== null ? (move >= 0 ? '+' : '') + move.toFixed(1) + 'pp' : '—'}
              </td>
              <td class="c-spark">
                <svg width="60" height="20" viewBox="0 0 60 20" class={`spark ${s.sparkUp ? 'spark-up' : 'spark-down'}`}>
                  <path d={s.spark} fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </td>
              <td class="c-vol">{fmtVol(m.volume_24h_usd)}</td>
              <td class="c-res">{formatRes(m.resolves_at)}</td>
              <td class="c-mech">{s.mechCode}</td>
              <td class="c-venue">{m.platform}</td>
              <td class="c-link"><a href={`/signals/${s.data.signal_slug}/`}>json →</a></td>
            </tr>
          );
        })}
      </tbody>
    </table>

    <section class="dlegend">
      <span class="dlegend-label">TYPE</span>
      <span class="dlegend-item"><span class="type-code type-XVD">XVD</span> cross-venue divergence</span>
      <span class="dlegend-item"><span class="type-code type-BND">BND</span> vs-benchmark drift</span>
      <span class="dlegend-item"><span class="type-code type-MOM">MOM</span> news-driven repricing</span>
      <span class="dlegend-item"><span class="type-code type-VOL">VOL</span> volume spike</span>
      <span class="dlegend-item"><span class="type-code type-PRE">PRE</span> pre-news pricing</span>
      <span class="dlegend-item"><span class="type-code type-COV">COV</span> coverage gap</span>
      <span class="dlegend-sep">·</span>
      <span class="dlegend-label">MECH</span>
      <span class="dlegend-item">UMA = UMA oracle</span>
      <span class="dlegend-item">KAL = Kalshi staff</span>
      <span class="dlegend-item">POL = Polymarket staff</span>
    </section>

    <section class="dcode">
      <div class="dcode-label">FOR AGENTS · REAL ENDPOINTS</div>
      <pre><code>curl https://clearmarket.fyi/feed.json          # atomic claims, last 24h
curl https://clearmarket.fyi/api/v1/signals/recent
mcp connect clearmarket-signal                  # tools: list_signals, get_signal_by_id
# Schema: github.com/JDSource/clearmarket/tree/main/schema
# Per-signal page: JSON-LD (Article + Dataset) + visible JSON block</code></pre>
    </section>

    <footer class="dfooter">
      <div class="dfooter-row">
        <a href="/methodology/">Methodology</a>
        <a href="https://github.com/JDSource/clearmarket/tree/main/schema">Public schema</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="mailto:hello@clearmarket.fyi">Contact</a>
      </div>
      <div class="df-mono">
        Daily cycle · Atomic claims · JSON-LD per page · MCP server · Open methodology · v0.1.0
      </div>
    </footer>
  </div>

  <style>
    .variant-d {
      --d-bg: #f7f8fa;
      --d-surface: #fff;
      --d-fg: #14181d;
      --d-fg-muted: #555c66;
      --d-fg-faint: #8b929a;
      --d-border: #d8dde3;
      --d-rule: #eaeef2;
      --d-hover: #f0f3f7;
      --d-up: #1d6f42;
      --d-down: #b34a4a;
      --d-accent: #1f3a5f;
      --d-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      --d-sans: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
      --d-serif: "Source Serif 4", "Iowan Old Style", "Charter", Georgia, serif;
      background: var(--d-bg);
      color: var(--d-fg);
      font-family: var(--d-sans);
      font-size: 13px;
      min-height: 100vh;
      margin: -48px -24px -96px;
      padding: 0;
    }
    .variant-d a { color: inherit; }

    .dhead { background: var(--d-surface); border-bottom: 1px solid var(--d-border); }
    .dhead-row {
      max-width: 1320px; margin: 0 auto;
      padding: 14px 24px 4px;
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 16px;
    }
    .dbrand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--d-serif); }
    .dbrand-mark {
      display: inline-flex; align-items: center; justify-content: center;
      width: 28px; height: 28px;
      background: var(--d-fg); color: var(--d-surface);
      font-family: var(--d-mono); font-size: 11px; font-weight: 700;
      letter-spacing: 0.04em; border-radius: 3px;
    }
    .dbrand-text { font-size: 19px; font-weight: 700; letter-spacing: -0.015em; }
    .dhead nav { display: flex; gap: 18px; font-family: var(--d-mono); font-size: 11px; }
    .dhead nav a { color: var(--d-fg-muted); text-decoration: none; letter-spacing: 0.04em; }
    .dhead nav a:hover { color: var(--d-fg); }
    .dabout {
      max-width: 1320px; margin: 0 auto;
      padding: 8px 24px 16px;
      font-size: 13px; color: var(--d-fg-muted); line-height: 1.55;
    }
    .dabout strong { color: var(--d-fg); font-weight: 600; }

    .dstatus {
      max-width: 1320px; margin: 0 auto;
      padding: 12px 24px;
      display: flex; flex-wrap: wrap; gap: 24px; align-items: center;
      border-bottom: 1px solid var(--d-border);
      background: var(--d-surface);
      font-family: var(--d-mono); font-size: 12px;
    }
    .ds-cell { display: flex; flex-direction: column; gap: 2px; }
    .ds-cell-right { margin-left: auto; flex-direction: row; gap: 14px; align-items: center; }
    .ds-label { color: var(--d-fg-faint); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }
    .ds-val { color: var(--d-fg); font-weight: 600; }
    .ds-feed { color: var(--d-fg-muted); text-decoration: none; font-size: 11px; letter-spacing: 0.04em; }
    .ds-feed:hover { color: var(--d-fg); }

    .dbrief {
      max-width: 1320px; margin: 0 auto;
      padding: 20px 24px 18px;
      background: var(--d-surface); border-bottom: 1px solid var(--d-border);
    }
    .dbrief-mark {
      font-family: var(--d-mono); font-size: 10px; color: var(--d-accent);
      letter-spacing: 0.08em; margin-bottom: 8px; font-weight: 600;
    }
    .dbrief p {
      margin: 0 0 8px;
      font-family: var(--d-serif); font-size: 16px; line-height: 1.55;
      max-width: 920px; color: var(--d-fg);
    }
    .dbrief-byline {
      font-family: var(--d-mono); font-size: 10.5px;
      color: var(--d-fg-faint); letter-spacing: 0.04em;
    }

    .dfilters {
      max-width: 1320px; margin: 0 auto;
      padding: 10px 24px;
      display: flex; gap: 6px; align-items: center; flex-wrap: wrap;
      background: #fcfcfd; border-bottom: 1px solid var(--d-border);
    }
    .df-label { font-family: var(--d-mono); font-size: 10px; color: var(--d-fg-faint); letter-spacing: 0.08em; margin-right: 4px; }
    .df-sep { color: var(--d-fg-faint); margin: 0 6px; }
    .fp {
      background: var(--d-surface); border: 1px solid var(--d-border);
      padding: 3px 9px; border-radius: 3px;
      font-family: var(--d-mono); font-size: 10px; color: var(--d-fg-muted);
      cursor: pointer; letter-spacing: 0.04em; text-transform: lowercase;
    }
    .fp:hover { background: var(--d-hover); color: var(--d-fg); }
    .fp-active { background: var(--d-fg); color: var(--d-bg); border-color: var(--d-fg); }

    .dtable {
      width: 100%; max-width: 1320px; margin: 0 auto;
      border-collapse: collapse; background: var(--d-surface); font-size: 13px;
    }
    .dtable th {
      text-align: left; font-family: var(--d-mono); font-size: 10px;
      letter-spacing: 0.08em; color: var(--d-fg-faint);
      padding: 10px 12px; border-bottom: 1px solid var(--d-border);
      background: #fcfcfd; position: sticky; top: 0; white-space: nowrap;
    }
    .dtable td { padding: 12px 12px; border-bottom: 1px solid var(--d-rule); vertical-align: top; }
    .dtable tr:hover td { background: var(--d-hover); }
    .dtable a { text-decoration: none; }
    .dtable a:hover { text-decoration: underline; }

    .c-time, .c-last, .c-24h, .c-vol, .c-res, .c-mech, .c-venue, .c-link {
      font-family: var(--d-mono); white-space: nowrap; font-variant-numeric: tabular-nums;
    }
    .c-time { color: var(--d-fg-muted); font-size: 11px; }
    .c-event { font-family: var(--d-serif); min-width: 180px; max-width: 220px; }
    .event-name { font-size: 13.5px; font-weight: 600; color: var(--d-fg); line-height: 1.3; }
    .event-meta { margin-top: 4px; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .event-id { font-family: var(--d-mono); font-size: 9.5px; color: var(--d-fg-faint); letter-spacing: 0.04em; }
    .c-signal { min-width: 280px; max-width: 380px; line-height: 1.4; font-weight: 500; position: relative; }
    .c-signal a { color: var(--d-fg); display: inline; }
    .c-signal a:hover { color: var(--d-accent); }
    .c-last { text-align: right; font-weight: 700; font-size: 14px; }
    .c-24h { text-align: right; font-weight: 600; font-size: 12.5px; }
    .c-24h.up { color: var(--d-up); }
    .c-24h.down { color: var(--d-down); }
    .c-spark { padding: 12px 8px; }
    .spark.spark-up { color: var(--d-up); }
    .spark.spark-down { color: var(--d-down); }
    .c-vol { text-align: right; color: var(--d-fg-muted); font-size: 12px; }
    .c-res { color: var(--d-fg-muted); font-size: 11.5px; }
    .c-mech { font-size: 10.5px; color: var(--d-fg-muted); letter-spacing: 0.04em; }
    .c-venue { font-size: 11px; color: var(--d-fg-muted); text-transform: capitalize; }
    .c-link a {
      font-family: var(--d-mono); font-size: 10px; color: var(--d-fg-faint);
      letter-spacing: 0.06em;
    }
    .c-link a:hover { color: var(--d-fg); }

    .topic-pill {
      display: inline-block; font-family: var(--d-mono); font-size: 9.5px;
      padding: 1px 6px; letter-spacing: 0.05em; border-radius: 2px;
      text-transform: lowercase; font-weight: 500;
    }
    .topic-macro { background: #e0eaf5; color: #2c4d70; }
    .topic-geopolitics { background: #fff4d6; color: #6b5400; }
    .topic-politics { background: #ece0f0; color: #5b3576; }
    .topic-crypto { background: #fae5e0; color: #7a3b2a; }
    .topic-sports { background: #f0f0f0; color: #4a4a4a; }

    .type-code {
      display: inline-block; font-family: var(--d-mono); font-size: 9.5px;
      padding: 1px 5px; margin-left: 8px;
      letter-spacing: 0.06em; border-radius: 2px;
      font-weight: 600; vertical-align: 1px;
    }
    .type-XVD { background: #fff4d6; color: #6b5400; border: 1px solid #e8d77a; }
    .type-MOM { background: #e0eaf5; color: #2c4d70; border: 1px solid #a8c5e3; }
    .type-BND { background: #ece0f0; color: #5b3576; border: 1px solid #b89cc5; }
    .type-VOL { background: #fae5e0; color: #7a3b2a; border: 1px solid #d8a59a; }
    .type-PRE { background: #d6f0dc; color: #1d6f42; border: 1px solid #6fb88a; }
    .type-COV { background: #f0f0f0; color: #4a4a4a; border: 1px solid #c0c0c0; }
    .type-DSP { background: #ffd9d9; color: #8b1a1a; border: 1px solid #d68080; }
    .type-NEW { background: #fff; color: #555; border: 1px solid #d8dde3; }
    .type-PRE-flag { background: var(--d-up); color: #fff; border-color: var(--d-up); }

    .dlegend {
      max-width: 1320px; margin: 16px auto 0;
      padding: 12px 24px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center;
      font-family: var(--d-mono); font-size: 10.5px; color: var(--d-fg-muted);
    }
    .dlegend-label { color: var(--d-fg-faint); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }
    .dlegend-item { display: flex; gap: 4px; align-items: center; }
    .dlegend-item .type-code { margin-left: 0; }
    .dlegend-sep { color: var(--d-fg-faint); }

    .dcode {
      max-width: 1320px; margin: 28px auto;
      padding: 18px 22px; background: #14181d; color: #cbd1d8;
      font-family: var(--d-mono); font-size: 12px; border-radius: 4px;
    }
    .dcode-label { font-size: 10px; letter-spacing: 0.08em; color: #8b929a; margin-bottom: 12px; }
    .dcode pre { margin: 0; }
    .dcode code { color: #cbd1d8; line-height: 1.7; }

    .dfooter {
      max-width: 1320px; margin: 24px auto 0;
      padding: 20px 24px; border-top: 1px solid var(--d-border);
      display: flex; justify-content: space-between; flex-wrap: wrap;
      gap: 12px; font-size: 12px; color: var(--d-fg-muted);
    }
    .dfooter-row { display: flex; gap: 18px; flex-wrap: wrap; }
