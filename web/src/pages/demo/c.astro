---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DemoSwitcher from '../../components/DemoSwitcher.astro';

const signals = (await getCollection('signals'))
  .sort((a, b) => new Date(b.data.published_at).getTime() - new Date(a.data.published_at).getTime());

const lead = signals[0];
const secondary = signals.slice(1, 4);
const tail = signals.slice(4);

function fmtTime(iso: string) {
  return new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
}
function fmtPct(n: number) { return (n * 100).toFixed(1) + '%'; }
function fmtPp(curr: number, prev: number | undefined) {
  if (prev === undefined) return null;
  const d = (curr - prev) * 100;
  return { sign: d >= 0 ? '+' : '', val: d.toFixed(1) };
}
---
<Base title="ClearMarket Signal — Demo C" description="Hybrid newsroom variant — FT/Bloomberg-shape" noindex bare>
  <DemoSwitcher current="c" />

  <div class="variant-c">
    <header class="chead">
      <div class="chead-row">
        <a class="cbrand" href="/demo/c/">ClearMarket Signal</a>
        <div class="cdate">Monday · May 11, 2026 · 09:30 ET</div>
        <nav>
          <a href="#feed">Today</a>
          <a href="/methodology/">Methodology</a>
          <a href="/api/">API</a>
          <a href="https://github.com/JDSource/clearmarket">GitHub</a>
        </nav>
      </div>
      <div class="cticker">
        <span class="cticker-label">LIVE</span>
        {signals.slice(0, 6).map((s) => {
          const m = s.data.primary_market;
          const move = m.price_24h_ago !== undefined ? (m.current_price - m.price_24h_ago) * 100 : null;
          return (
            <span class="cticker-item">
              <span class="cticker-name">{m.platform_market_id.length > 14 ? m.platform_market_id.slice(0,14) + '…' : m.platform_market_id}</span>
              <span class="cticker-price">{fmtPct(m.current_price)}</span>
              {move !== null && <span class={`cticker-move ${move >= 0 ? 'up' : 'down'}`}>{move >= 0 ? '+' : ''}{move.toFixed(1)}pp</span>}
            </span>
          );
        })}
      </div>
    </header>

    <div class="cgrid">
      <main class="cmain">
        <article class="lead">
          <div class="lead-eyebrow">
            <span class={`ctag ctag-${lead.data.category_tag}`}>{lead.data.category_tag}</span>
            <span class="lead-time">{fmtTime(lead.data.published_at)}</span>
            <span class={`lead-pn pn-${lead.data.pre_news_classification}`}>{lead.data.pre_news_classification.replace('_', '-')}</span>
          </div>
          <h1><a href={`/signals/${lead.data.signal_slug}/`}>{lead.data.headline}</a></h1>
          <div class="lead-body">
            <ol class="lead-bullets">
              {lead.data.bullets.slice(0, 3).map((b) => <li>{b}</li>)}
            </ol>
            <a class="lead-more" href={`/signals/${lead.data.signal_slug}/`}>Read 5-bullet brief & JSON →</a>
          </div>
          <aside class="lead-market">
            <div class="lm-label">PRIMARY MARKET</div>
            <div class="lm-platform">{lead.data.primary_market.platform}</div>
            <div class="lm-q">{lead.data.primary_market.question_raw}</div>
            <div class="lm-price">{fmtPct(lead.data.primary_market.current_price)}</div>
            {lead.data.primary_market.price_24h_ago !== undefined && (
              <div class={`lm-move ${lead.data.primary_market.current_price >= lead.data.primary_market.price_24h_ago ? 'up' : 'down'}`}>
                {(() => {
                  const d = (lead.data.primary_market.current_price - lead.data.primary_market.price_24h_ago) * 100;
                  return (d >= 0 ? '+' : '') + d.toFixed(1) + 'pp 24h';
                })()}
              </div>
            )}
            {lead.data.primary_market.volume_24h_usd && (
              <div class="lm-vol">Vol 24h ${(lead.data.primary_market.volume_24h_usd/1_000_000).toFixed(2)}M</div>
            )}
            <div class="lm-resolves">Resolves {new Date(lead.data.primary_market.resolves_at ?? '').toLocaleDateString()}</div>
          </aside>
        </article>

        <section id="feed" class="secondary-row">
          {secondary.map((s) => (
            <article class="sec-card">
              <div class="sec-eyebrow">
                <span class={`ctag ctag-${s.data.category_tag}`}>{s.data.category_tag}</span>
                <span class="sec-time">{fmtTime(s.data.published_at)}</span>
              </div>
              <h2><a href={`/signals/${s.data.signal_slug}/`}>{s.data.headline}</a></h2>
              <p>{s.data.bullets[0]}</p>
              <div class="sec-stats">
                <span class="sec-price">{fmtPct(s.data.primary_market.current_price)}</span>
                {s.data.primary_market.price_24h_ago !== undefined && (() => {
                  const d = (s.data.primary_market.current_price - s.data.primary_market.price_24h_ago) * 100;
                  return <span class={`sec-move ${d >= 0 ? 'up' : 'down'}`}>{d >= 0 ? '+' : ''}{d.toFixed(1)}pp</span>;
                })()}
                <span class="sec-venue">{s.data.primary_market.platform}</span>
              </div>
            </article>
          ))}
        </section>

        {tail.length > 0 && (
        <section class="tail">
          <div class="tail-label">MORE FROM TODAY</div>
          <ul>
            {tail.map((s) => (
              <li>
                <a href={`/signals/${s.data.signal_slug}/`}>
                  <span class={`tail-tag ctag-${s.data.category_tag}`}>{s.data.category_tag}</span>
                  <span class="tail-head">{s.data.headline}</span>
                  <span class="tail-price">{fmtPct(s.data.primary_market.current_price)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
        )}
      </main>

      <aside class="csidebar">
        <section class="sb-card">
          <div class="sb-label">TODAY'S CYCLE</div>
          <div class="sb-stat"><span>Detection cycle</span><strong>14 min ago</strong></div>
          <div class="sb-stat"><span>Universe scanned</span><strong>2,847 markets</strong></div>
          <div class="sb-stat"><span>Signals surfaced</span><strong>{signals.length}</strong></div>
          <div class="sb-stat"><span>Pre-news flagged</span><strong>{signals.filter((s) => s.data.pre_news_classification === 'pre_news').length}</strong></div>
        </section>

        <section class="sb-card">
          <div class="sb-label">DETECTION PATHS</div>
          <ul class="sb-paths">
            <li><span class="dot dot-news"></span>News-driven <em>{signals.filter((s) => s.data.detection_path === 'news_driven').length}</em></li>
            <li><span class="dot dot-bench"></span>Benchmark divergence <em>{signals.filter((s) => s.data.detection_path === 'benchmark_divergence').length}</em></li>
            <li><span class="dot dot-cross"></span>Cross-venue divergence <em>{signals.filter((s) => s.data.detection_path === 'cross_venue_divergence').length}</em></li>
            <li><span class="dot dot-vol"></span>Volume spike <em>{signals.filter((s) => s.data.detection_path === 'volume_spike').length}</em></li>
          </ul>
        </section>

        <section class="sb-card">
          <div class="sb-label">COVERAGE</div>
          <p class="sb-text">Geopolitics, central bank, macro, regulatory, named-firm events, US politics (Polymarket), macro-shape crypto. Excluded: sports, entertainment, prop bets.</p>
        </section>

        <section class="sb-card sb-card-dark">
          <div class="sb-label" style="color: #fff;">OPEN INFRASTRUCTURE</div>
          <p class="sb-text">Methodology and schema in the public repo. Atomic claims with field-level provenance. Signal JSON + Article + Dataset JSON-LD on every page.</p>
          <a href="https://github.com/JDSource/clearmarket" class="sb-cta">github.com/JDSource/clearmarket →</a>
        </section>
      </aside>
    </div>
  </div>

  <style>
    .variant-c {
      --vc-bg: #fdfcfa;
      --vc-fg: #181818;
      --vc-fg-muted: #555;
      --vc-fg-faint: #8a8580;
      --vc-border: #e2dfd7;
      --vc-rule: #c8c4ba;
      --vc-accent: #a8332a;
      --vc-serif: "Source Serif 4", "Source Serif Pro", "Times New Roman", Georgia, serif;
      --vc-sans: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
      --vc-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      --vc-up: #1d6f42;
      --vc-down: #b34a4a;
      background: var(--vc-bg);
      color: var(--vc-fg);
      font-family: var(--vc-serif);
      min-height: 100vh;
      margin: -48px -24px -96px;
      padding: 0 0 80px;
    }
    .variant-c a { color: inherit; }

    .chead { border-bottom: 2px solid var(--vc-fg); background: var(--vc-bg); }
    .chead-row {
      max-width: 1200px;
      margin: 0 auto;
      padding: 18px 24px 14px;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 24px;
      flex-wrap: wrap;
    }
    .cbrand { font-family: var(--vc-serif); font-size: 28px; font-weight: 700; letter-spacing: -0.02em; text-decoration: none; }
    .cdate { font-family: var(--vc-sans); font-size: 12px; color: var(--vc-fg-muted); letter-spacing: 0.04em; text-transform: uppercase; }
    .chead nav { display: flex; gap: 18px; font-family: var(--vc-sans); font-size: 13px; }
    .chead nav a { color: var(--vc-fg-muted); text-decoration: none; }
    .chead nav a:hover { color: var(--vc-fg); }

    .cticker {
      max-width: 1200px;
      margin: 0 auto;
      padding: 8px 24px;
      display: flex;
      gap: 18px;
      overflow-x: auto;
      font-family: var(--vc-mono);
      font-size: 11px;
      border-top: 1px solid var(--vc-border);
      align-items: center;
    }
    .cticker-label { color: var(--vc-accent); font-weight: 700; letter-spacing: 0.1em; }
    .cticker-item { display: flex; gap: 6px; align-items: baseline; white-space: nowrap; }
    .cticker-name { color: var(--vc-fg-faint); }
    .cticker-price { font-weight: 600; }
    .cticker-move.up { color: var(--vc-up); }
    .cticker-move.down { color: var(--vc-down); }

    .cgrid {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 24px;
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 40px;
    }
    @media (max-width: 920px) { .cgrid { grid-template-columns: 1fr; } }

    .lead {
      display: grid;
      grid-template-columns: 1fr 220px;
      gap: 24px;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--vc-rule);
      margin-bottom: 32px;
    }
    @media (max-width: 720px) { .lead { grid-template-columns: 1fr; } }
    .lead-eyebrow {
      grid-column: 1 / -1;
      display: flex;
      gap: 12px;
      align-items: center;
      font-family: var(--vc-mono);
      font-size: 11px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }
    .lead-time { color: var(--vc-fg-faint); }
    .lead-pn.pn-pre_news { color: var(--vc-up); font-weight: 700; }
    .lead-pn.pn-concurrent { color: var(--vc-fg-faint); }
    .lead h1 { grid-column: 1 / -1; font-size: 36px; line-height: 1.15; letter-spacing: -0.02em; font-weight: 700; margin: 0 0 16px; }
    .lead h1 a { text-decoration: none; }
    .lead-body { font-family: var(--vc-sans); font-size: 15px; line-height: 1.6; }
    .lead-bullets { list-style: none; counter-reset: x; padding: 0; margin: 0 0 16px; }
    .lead-bullets li {
      counter-increment: x;
      padding-left: 26px;
      position: relative;
      margin-bottom: 10px;
    }
    .lead-bullets li::before {
      content: counter(x);
      position: absolute;
      left: 0;
      top: 3px;
      font-family: var(--vc-mono);
      font-size: 10px;
      color: var(--vc-fg-faint);
      width: 18px; height: 18px;
      border: 1px solid var(--vc-rule);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
    }
    .lead-more { font-family: var(--vc-sans); font-size: 13px; color: var(--vc-accent); text-decoration: none; font-weight: 500; }
    .lead-more:hover { text-decoration: underline; }
    .lead-market {
      background: #f4f1ea;
      border-left: 3px solid var(--vc-fg);
      padding: 16px;
      font-family: var(--vc-sans);
      font-size: 12px;
    }
    .lm-label { font-family: var(--vc-mono); font-size: 10px; color: var(--vc-fg-faint); letter-spacing: 0.08em; margin-bottom: 8px; }
    .lm-platform { font-family: var(--vc-mono); font-size: 11px; text-transform: uppercase; color: var(--vc-fg-muted); margin-bottom: 4px; letter-spacing: 0.05em; }
    .lm-q { font-size: 13px; line-height: 1.4; margin-bottom: 12px; font-weight: 500; }
    .lm-price { font-family: var(--vc-mono); font-size: 28px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
    .lm-move { font-family: var(--vc-mono); font-size: 13px; font-weight: 600; margin-top: 4px; }
    .lm-move.up { color: var(--vc-up); }
    .lm-move.down { color: var(--vc-down); }
    .lm-vol, .lm-resolves { font-family: var(--vc-mono); font-size: 11px; color: var(--vc-fg-muted); margin-top: 8px; }

    .secondary-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 32px; }
    @media (max-width: 780px) { .secondary-row { grid-template-columns: 1fr; } }
    .sec-card { border-top: 1px solid var(--vc-rule); padding-top: 16px; }
    .sec-eyebrow { display: flex; gap: 8px; font-family: var(--vc-mono); font-size: 10px; color: var(--vc-fg-faint); margin-bottom: 8px; flex-wrap: wrap; align-items: center; }
    .sec-card h2 { font-size: 18px; line-height: 1.25; margin: 0 0 10px; font-weight: 600; letter-spacing: -0.005em; }
    .sec-card h2 a { text-decoration: none; }
    .sec-card p { font-family: var(--vc-sans); font-size: 13px; color: var(--vc-fg-muted); line-height: 1.5; margin: 0 0 10px; }
    .sec-stats { display: flex; gap: 10px; font-family: var(--vc-mono); font-size: 11px; align-items: baseline; }
    .sec-price { font-weight: 700; font-size: 13px; }
    .sec-move.up { color: var(--vc-up); font-weight: 600; }
    .sec-move.down { color: var(--vc-down); font-weight: 600; }
    .sec-venue { color: var(--vc-fg-faint); text-transform: capitalize; }

    .tail { border-top: 1px solid var(--vc-rule); padding-top: 16px; }
    .tail-label { font-family: var(--vc-mono); font-size: 11px; color: var(--vc-fg-faint); letter-spacing: 0.08em; margin-bottom: 10px; }
    .tail ul { list-style: none; padding: 0; margin: 0; }
    .tail li { border-bottom: 1px solid var(--vc-border); }
    .tail li a {
      display: grid;
      grid-template-columns: 200px 1fr 80px;
      gap: 16px;
      align-items: center;
      padding: 12px 0;
      text-decoration: none;
    }
    .tail-tag { font-family: var(--vc-mono); font-size: 10px; padding: 2px 6px; border: 1px solid var(--vc-border); border-radius: 3px; letter-spacing: 0.04em; }
    .tail-head { font-family: var(--vc-serif); font-size: 15px; font-weight: 600; line-height: 1.3; }
    .tail-price { font-family: var(--vc-mono); font-size: 13px; font-weight: 600; text-align: right; }

    .csidebar { display: flex; flex-direction: column; gap: 16px; }
    .sb-card { background: #fff; border: 1px solid var(--vc-border); padding: 16px; font-family: var(--vc-sans); }
    .sb-card-dark { background: #1a1a1a; color: #ddd; border: none; }
    .sb-card-dark a { color: #fff; }
    .sb-label { font-family: var(--vc-mono); font-size: 10px; color: var(--vc-fg-faint); letter-spacing: 0.1em; margin-bottom: 10px; }
    .sb-stat { display: flex; justify-content: space-between; font-size: 12px; padding: 4px 0; }
    .sb-stat strong { font-family: var(--vc-mono); font-weight: 600; }
    .sb-paths { list-style: none; padding: 0; margin: 0; font-size: 12px; }
    .sb-paths li { display: flex; align-items: center; gap: 8px; padding: 4px 0; }
    .sb-paths em { margin-left: auto; font-style: normal; font-family: var(--vc-mono); color: var(--vc-fg-muted); }
    .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .dot-news { background: #2c4d70; }
    .dot-bench { background: #5b3576; }
    .dot-cross { background: #6b5400; }
    .dot-vol { background: #7a3b2a; }
    .sb-text { font-size: 12px; line-height: 1.55; margin: 0 0 8px; color: var(--vc-fg-muted); }
    .sb-card-dark .sb-text { color: #bbb; }
    .sb-cta { font-family: var(--vc-mono); font-size: 11px; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; }

    .ctag {
      display: inline-block;
      font-family: var(--vc-mono);
      font-size: 9.5px;
      padding: 2px 6px;
      letter-spacing: 0.05em;
      border-radius: 3px;
      border: 1px solid var(--vc-border);
    }
    .ctag-CROSS_VENUE_DIVERGENCE { background: #fff4d6; border-color: #e8d77a; color: #6b5400; }
    .ctag-MOMENTUM_REPRICING { background: #e0eaf5; border-color: #a8c5e3; color: #2c4d70; }
    .ctag-PRE_NEWS_PRICING { background: #d6f0dc; border-color: #6fb88a; color: #1d6f42; }
    .ctag-VOLUME_SPIKE { background: #fae5e0; border-color: #d8a59a; color: #7a3b2a; }
    .ctag-VS_BENCHMARK_DRIFT { background: #ece0f0; border-color: #b89cc5; color: #5b3576; }
    .ctag-COVERAGE_GAP { background: #f0f0f0; border-color: #c0c0c0; color: #4a4a4a; }

    @media (prefers-color-scheme: dark) {
      .variant-c {
        --vc-bg: #121110;
        --vc-fg: #ece8df;
        --vc-fg-muted: #aaa49a;
        --vc-fg-faint: #6c685f;
        --vc-border: #2a2823;
        --vc-rule: #3a382f;
      }
      .lead-market { background: #1c1a16; border-left-color: #ece8df; }
      .sb-card { background: #1a1814; }
      .ctag { filter: brightness(0.85); }
    }
  </style>
</Base>
