---
import Site from '../layouts/Site.astro';
import { coverageLabel } from '../lib/universe';

// Production endpoints (custom domains cut over at go-live; Worker is the backing host).
const API = 'https://api.clearmarket.fyi';
const MCP = 'https://api.clearmarket.fyi/mcp';
const sampleSlug = 'kxgdpyear-26';
const updated = '2026-05-29';
---
<Site title="ClearMarket API + MCP" description="Open REST API and MCP server for ClearMarket: graded, cross-venue reference data for prediction markets across Kalshi and Polymarket.">
  <div class="doc">
    <aside class="doc-gutter">
      <div class="dg-meta">
        <div class="dg-row"><span class="dg-k">doc_id</span><span class="dg-v">cm-api-mcp</span></div>
        <div class="dg-row"><span class="dg-k">version</span><span class="dg-v">v0.2</span></div>
        <div class="dg-row"><span class="dg-k">updated</span><span class="dg-v">{updated}</span></div>
        <div class="dg-row"><span class="dg-k">access</span><span class="dg-v">open · free</span></div>
        <div class="dg-row"><span class="dg-k">transport</span><span class="dg-v">REST · MCP</span></div>
      </div>
      <nav class="dg-nav">
        <a href="#overview">Overview</a>
        <a href="#access">Access</a>
        <a href="#rest">REST API</a>
        <a href="#mcp">MCP server</a>
        <a href="#agent">Agent / llms.txt</a>
        <a href="#schema">Schema</a>
      </nav>
    </aside>

    <div class="doc-body">
      <header class="doc-head" id="overview">
        <h1>API <span class="dh-plus">+</span> MCP</h1>
        <p class="doc-lede">Open JSON over HTTPS, and a live MCP server for agents. {coverageLabel()} across Kalshi and Polymarket, each with a <a href="/methodology/">Resolution Clarity Grade</a> — the named resolution source where one is committed, and a graded <code>source_status</code> when it isn't. No key required.</p>
        <p class="doc-note">Every event is single-venue; the same question priced on both venues is linked by a shared <code>question_id</code>, and each market's <code>also_on</code> lists its cross-venue twins. Prices refresh hourly. Catalyst dates (CPI, FOMC, jobs, earnings) are joined per event. Read-only.</p>
      </header>

      <section class="surface" id="access">
        <div class="surface-tab">ACCESS</div>
        <p><strong>Open by default.</strong> Full universe, no key, <code>1,000</code> requests/day per IP. Drop your email for a free key and <code>10,000</code>/day — issued instantly, no confirmation step:</p>

        <form class="keyform" id="keyform" novalidate>
          <input type="email" id="keyemail" name="email" placeholder="you@firm.com" autocomplete="email" aria-label="Email address" required />
          <button type="submit" id="keybtn">Get a free key</button>
        </form>
        <p class="keyerr" id="keyerr" hidden></p>

        <div class="keyout" id="keyout" hidden>
          <div class="keyout-l">YOUR API KEY</div>
          <div class="keyout-row">
            <input type="text" id="keyval" readonly aria-label="Your API key" />
            <button type="button" id="keycopy">Copy</button>
          </div>
          <p class="doc-note">Send it as <code>Authorization: Bearer &lt;key&gt;</code> or <code>?key=&lt;key&gt;</code>. 10,000 requests/day, resets 00:00 UTC. Save it now — for your records; you can always request a new one.</p>
        </div>

        <details class="keycurl">
          <summary>Prefer the API? Request a key with curl</summary>
          <pre><code>{`curl -s -X POST ${API}/v1/keys \\
  -H 'content-type: application/json' \\
  -d '{"email":"you@firm.com"}'`}</code></pre>
        </details>
        <p class="doc-note">Anonymous access works too — just omit the key. CORS open.</p>
      </section>

      <script is:inline define:vars={{ apiBase: API }}>
        (function () {
          var form = document.getElementById('keyform');
          if (!form) return;
          var btn = document.getElementById('keybtn');
          var out = document.getElementById('keyout');
          var val = document.getElementById('keyval');
          var err = document.getElementById('keyerr');
          var copy = document.getElementById('keycopy');
          function fail(msg) { err.textContent = msg; err.hidden = false; btn.disabled = false; btn.textContent = 'Get a free key'; }
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            err.hidden = true;
            var email = document.getElementById('keyemail').value.trim();
            if (!email || email.indexOf('@') < 1 || email.indexOf('.') < 0) { fail('Enter a valid email address.'); return; }
            btn.disabled = true; btn.textContent = 'Issuing…';
            fetch(apiBase + '/v1/keys', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ email: email })
            }).then(function (r) {
              return r.json().then(function (data) { return { ok: r.ok, data: data }; });
            }).then(function (res) {
              if (res.ok && res.data && res.data.key) {
                val.value = res.data.key; out.hidden = false; form.hidden = true; err.hidden = true;
              } else {
                fail((res.data && (res.data.hint || res.data.error)) || 'Could not issue a key. Try the curl command below.');
              }
            }).catch(function () { fail('Network error. Try the curl command below.'); });
          });
          copy.addEventListener('click', function () {
            val.select();
            if (navigator.clipboard) { navigator.clipboard.writeText(val.value); }
            else { document.execCommand('copy'); }
            copy.textContent = 'Copied';
            setTimeout(function () { copy.textContent = 'Copy'; }, 1500);
          });
        })();
      </script>

      <section class="surface" id="rest">
        <div class="surface-tab">REST · THE WORKBENCH</div>
        <p>Query and filter the universe directly. Every response is the canonical schema with derived fields added at serve time.</p>

        <div class="ep"><span class="ep-verb">GET</span><span class="ep-path">/v1/events?category=&platform=&grade=&q=&limit=&offset=</span></div>
        <pre><code>{`curl -s '${API}/v1/events?category=economics&grade=A&limit=5' \\
  | jq '.events[] | {slug, grade, question}'`}</code></pre>

        <div class="ep"><span class="ep-verb">GET</span><span class="ep-path">/v1/events/{`{slug}`}?detail=concise</span></div>
        <p class="ep-desc">Full event: linked markets, grades, windowed catalysts. <code>?detail=concise</code> trims each market to the essentials (grade, price, source) for large multi-market events.</p>
        <pre><code>{`curl -s ${API}/v1/events/${sampleSlug} \\
  | jq '{question, catalyst_dates, markets: (.markets | length)}'`}</code></pre>

        <div class="ep"><span class="ep-verb">GET</span><span class="ep-path">/v1/markets/{`{market_id}`}</span></div>
        <p class="ep-desc">Single market: price, Resolution Clarity Grade, resolution provenance.</p>

        <div class="ep"><span class="ep-verb">GET</span><span class="ep-path">/v1/catalysts/upcoming?days=N</span></div>
        <p class="ep-desc">Scheduled catalysts across all events, cross-event view.</p>
        <pre><code>{`curl -s '${API}/v1/catalysts/upcoming?days=14' | jq '.catalysts'`}</code></pre>
      </section>

      <section class="surface" id="mcp">
        <div class="surface-tab">MCP · THE HANDSHAKE</div>
        <p>The agent-first surface. Same data, spoken as tools an agent calls directly. No HTML to crawl, no REST to compose. Streamable HTTP at <code>{`${MCP}`}</code>. Open, read-only.</p>
        <p class="mcp-note">Note: the endpoint is the path <code>/mcp</code> on the API domain — <code>api.clearmarket.fyi/mcp</code>, not an <code>mcp.</code> subdomain. POST JSON-RPC (<code>application/json</code> is enough; <code>text/event-stream</code> is only needed if you consume the SSE stream).</p>

        <div class="console">
          <div class="console-h">tools</div>
          <div class="tool"><span class="tool-name">list_events</span><span class="tool-desc">browse / search the universe (set <code>q</code>)</span></div>
          <div class="tool"><span class="tool-name">get_event</span><span class="tool-desc">full graded record for one event. <code>detail=concise</code> trims each market to grade + price + source (much smaller for many-market events)</span></div>
          <div class="tool"><span class="tool-name">get_market</span><span class="tool-desc">price + resolution provenance. Accepts a ClearMarket id (<code>CM-MKT-…</code>), a venue-native id / Kalshi ticker, or a market URL (best-effort — Kalshi URLs resolve; Polymarket needs the conditionId) — returns the canonical <code>CM-MKT-…</code> id</span></div>
          <div class="tool"><span class="tool-name">list_upcoming_catalysts</span><span class="tool-desc">scheduled catalysts, next N days</span></div>
          <div class="tool"><span class="tool-name">list_signals</span><span class="tool-desc">browse the CM Signal wire (filter by event, category, venue, type)</span></div>
          <div class="tool"><span class="tool-name">get_signal</span><span class="tool-desc">full wire bulletin by slug</span></div>
        </div>

        <h3>Connect your agent</h3>
        <p class="ep-desc">One step on most platforms — the server is open, read-only, no auth, so there is nothing to configure beyond the URL.</p>

        <h4>Claude Code</h4>
        <pre><code>{`claude mcp add clearmarket --transport http ${MCP}`}</code></pre>

        <h4>Claude Desktop</h4>
        <p class="ep-desc"><strong>Settings → Connectors → Add custom connector</strong>, then paste <code>{`${MCP}`}</code>.</p>

        <h4>ChatGPT</h4>
        <p class="ep-desc">Turn on <strong>Developer Mode</strong>, then <strong>Settings → Apps → Create app</strong> and paste <code>{`${MCP}`}</code>.</p>

        <h4>Codex CLI</h4>
        <pre><code>{`codex mcp add clearmarket --url ${MCP}`}</code></pre>

        <h4>Cursor</h4>
        <p class="ep-desc">Add to <code>~/.cursor/mcp.json</code>:</p>
        <pre><code>{`{
  "mcpServers": {
    "clearmarket": { "url": "${MCP}" }
  }
}`}</code></pre>

        <h4>Grok</h4>
        <p class="ep-desc">In a chat: <strong>+ → Add connector → Custom</strong>, then paste <code>{`${MCP}`}</code>.</p>

        <h4>Other platforms / stdio-only clients</h4>
        <p class="ep-desc">Any MCP client that takes a remote URL works with <code>{`${MCP}`}</code> directly. Clients that only speak stdio can bridge via <code>mcp-remote</code>:</p>
        <pre><code>{`{
  "mcpServers": {
    "clearmarket": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "${MCP}"]
    }
  }
}`}</code></pre>

        <h3>Verify (raw JSON-RPC)</h3>
        <pre><code>{`curl -s -X POST ${MCP} -H 'content-type: application/json' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \\
  | jq '.result.tools[].name'`}</code></pre>
      </section>

      <section class="surface" id="agent">
        <div class="surface-tab">AGENT · THE MANIFEST</div>
        <p>A plain-text surface engineered for LLM context windows. Zero markup, token-optimized, enumerates every endpoint and tool.</p>
        <div class="manifest">
          <a href="/llms.txt">/llms.txt</a> <span class="manifest-tag">[density: high] [context: token-optimized]</span>
        </div>
      </section>

      <section class="surface" id="schema">
        <div class="surface-tab">SCHEMA</div>
        <p>JSON Schema (draft 2020-12). API responses are the schema with derived fields added at serve time.</p>
        <ul class="schema-list">
          <li><a href="https://raw.githubusercontent.com/JDSource/clearmarket/main/schema/events.schema.json"><code>events.schema.json</code></a></li>
          <li><a href="https://raw.githubusercontent.com/JDSource/clearmarket/main/schema/markets.schema.json"><code>markets.schema.json</code></a></li>
          <li><a href="https://raw.githubusercontent.com/JDSource/clearmarket/main/schema/marks.schema.json"><code>marks.schema.json</code></a></li>
          <li><a href="https://raw.githubusercontent.com/JDSource/clearmarket/main/schema/resolution_log.schema.json"><code>resolution_log.schema.json</code></a></li>
        </ul>
        <p class="doc-note">Repository: <a href="https://github.com/JDSource/clearmarket">github.com/JDSource/clearmarket</a></p>
      </section>
    </div>
  </div>

  <style>
    .doc {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 40px;
      align-items: start;
    }
    /* Left gutter — sticky doc metadata + section nav */
    .doc-gutter { position: sticky; top: 120px; font-family: var(--va-mono); }
    /* Hard vertical rule between gutter and body (Gemini #3) — runs the full body height */
    .doc-body { border-left: 1px solid var(--va-border); padding-left: 40px; }
    .dg-meta { border-left: 2px solid var(--va-accent); padding-left: 12px; margin-bottom: 24px; }
    .dg-row { display: flex; justify-content: space-between; gap: 10px; font-size: 10.5px; padding: 3px 0; letter-spacing: 0.03em; }
    .dg-k { color: var(--va-fg-faint); text-transform: uppercase; }
    .dg-v { color: var(--va-fg-muted); }
    .dg-nav { display: flex; flex-direction: column; gap: 2px; }
    .dg-nav a { font-size: 11.5px; color: var(--va-fg-muted); text-decoration: none; padding: 5px 0; border-bottom: 1px solid var(--va-rule); letter-spacing: 0.03em; }
    .dg-nav a:hover { color: var(--va-accent); }

    .doc-body { min-width: 0; max-width: 760px; }
    .doc-head { margin-bottom: 8px; }
    .doc-head h1 { font-family: var(--va-sans); font-size: 34px; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 16px; color: var(--va-fg); }
    .dh-plus { color: var(--va-accent); }
    .doc-lede { font-size: 17px; line-height: 1.55; color: var(--va-fg-muted); margin: 0 0 16px; }
    .doc-note { font-size: 14px; line-height: 1.6; color: var(--va-fg-muted); }

    .doc-body p { color: var(--va-fg-muted); font-size: 14.5px; line-height: 1.6; }
    .doc-body strong { color: var(--va-fg); }
    .doc-body h3 { font-family: var(--va-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--va-fg-faint); margin: 28px 0 10px; }
    .doc-body a { color: var(--va-accent); text-decoration: none; }
    .doc-body a:hover { text-decoration: underline; }
    .doc-body code { font-family: var(--va-mono); font-size: 0.86em; background: var(--va-bg-2); border: 1px solid var(--va-rule); padding: 1px 5px; color: var(--va-fg); border-radius: 0; }
    .doc-body pre { font-family: var(--va-mono); font-size: 12.5px; line-height: 1.55; background: var(--va-bg-2); border: 1px solid var(--va-border); padding: 14px 16px; overflow-x: auto; margin: 0 0 16px; border-radius: 0; color: var(--va-fg); }
    .doc-body pre code { background: transparent; border: 0; padding: 0; }

    /* Surface sections — each data-ingress path as its own bordered block */
    .surface { border-top: 1px solid var(--va-border); padding-top: 22px; margin-top: 40px; scroll-margin-top: 130px; }
    .surface-tab { display: inline-block; font-family: var(--va-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.1em; color: var(--va-bg); background: var(--va-accent); padding: 3px 9px; margin-bottom: 14px; }

    /* Email -> key capture form */
    .keyform { display: flex; gap: 8px; margin: 6px 0 4px; max-width: 460px; }
    .keyform[hidden] { display: none; } /* display:flex above otherwise beats the hidden attribute */
    .keyform input { flex: 1 1 auto; font-family: var(--va-mono); font-size: 13px; background: var(--va-bg-2); border: 1px solid var(--va-border); color: var(--va-fg); padding: 9px 12px; border-radius: 0; }
    .keyform input:focus { outline: none; border-color: var(--va-accent); }
    .keyform button, .keyout-row button { font-family: var(--va-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer; background: var(--va-accent); color: var(--va-bg); border: 1px solid var(--va-accent); padding: 9px 16px; border-radius: 0; white-space: nowrap; }
    .keyform button:disabled { opacity: 0.6; cursor: default; }
    .keyerr { color: var(--va-down, #d9534f); font-size: 13px; margin: 4px 0 0; }
    .keyout { border: 1px solid var(--va-accent); background: var(--va-bg-2); padding: 14px 16px; margin: 12px 0 4px; max-width: 560px; }
    .keyout-l { font-family: var(--va-mono); font-size: 10px; letter-spacing: 0.1em; color: var(--va-fg-faint); margin-bottom: 8px; }
    .keyout-row { display: flex; gap: 8px; }
    .keyout-row input { flex: 1 1 auto; font-family: var(--va-mono); font-size: 13px; background: var(--va-bg); border: 1px solid var(--va-border); color: var(--va-fg); padding: 9px 12px; border-radius: 0; }
    .keyout-row button { background: transparent; color: var(--va-accent); }
    .keyout .doc-note { margin-top: 10px; }
    .keycurl { margin: 10px 0 8px; }
    .keycurl summary { font-size: 13px; color: var(--va-fg-muted); cursor: pointer; }
    .keycurl summary:hover { color: var(--va-accent); }
    .keycurl pre { margin-top: 10px; }

    /* REST endpoint lines */
    .ep { display: flex; align-items: baseline; gap: 10px; font-family: var(--va-mono); font-size: 13px; border: 1px solid var(--va-border); padding: 9px 12px; margin: 14px 0 6px; background: var(--va-bg-2); }
    .ep-verb { color: var(--va-up); font-weight: 700; font-size: 11px; }
    .ep-path { color: var(--va-fg); overflow-x: auto; white-space: nowrap; }
    .ep-desc { margin: 0 0 8px; font-size: 13px; }
    .mcp-note { margin: -4px 0 14px; font-size: 12.5px; color: var(--va-fg-muted); line-height: 1.5; }

    /* MCP console / tool list */
    .console { border: 1px solid var(--va-border); background: var(--va-bg-2); margin: 16px 0; }
    .console-h { font-family: var(--va-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--va-fg-faint); padding: 7px 12px; border-bottom: 1px solid var(--va-rule); }
    .tool { display: flex; gap: 12px; align-items: baseline; padding: 8px 12px; border-bottom: 1px solid var(--va-rule); font-size: 13px; }
    .tool:last-child { border-bottom: 0; }
    .tool-name { font-family: var(--va-mono); color: var(--va-accent); font-weight: 600; flex: 0 0 auto; }
    .tool-desc { color: var(--va-fg-muted); font-size: 13px; }

    /* Agent manifest line */
    .manifest { font-family: var(--va-mono); font-size: 13px; border: 1px dashed var(--va-border); padding: 12px 14px; margin-top: 12px; }
    .manifest-tag { color: var(--va-fg-faint); font-size: 11px; margin-left: 8px; }

    .schema-list { list-style: none; padding: 0; }
    .schema-list li { padding: 4px 0; }

    @media (max-width: 820px) {
      .doc { grid-template-columns: 1fr; gap: 24px; }
      .doc-gutter { position: static; top: auto; }
      .doc-body { border-left: 0; padding-left: 0; }
      .dg-nav { flex-flow: row wrap; gap: 8px 16px; }
      .dg-nav a { border-bottom: 0; padding: 2px 0; }
    }
  </style>
</Site>
