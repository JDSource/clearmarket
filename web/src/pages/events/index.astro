---
/* CM Data - event universe at /events/
 *
 * Terminal-ledger aesthetic, ported to EXACT visual alignment with the locked
 * /signals/ wire index. Every event row is anchored by its CM-EVT- id (a solid
 * mono wall on the left edge), category + venues + shape + cumulative volume read
 * as hard-edged machine columns. Search is a borderless terminal-prompt node that
 * also surfaces the equivalent /v1/events?q= API call (dogfooding it).
 *
 * No grade column - grade is a per-market property, not an event one, and a single
 * letter at the event level would be misleading.
 *
 * Header / filter / section tokens are replicated from signals/index.astro, where
 * the brand/sep/role H1 variant + bracket-selection cm-filter set live locally
 * (they are not in the shared cm-event.css). Volume column is mono, tabular-nums,
 * right-aligned so the decimal edge stacks down the column.
 */
import Site from '../../layouts/Site.astro';
import '../../styles/tokens.css';
import '../../styles/cm-event.css';
import { getAllEvents, getMarketsForEvent, isEventLive } from '../../lib/universe';
import { eventDisplayQuestion } from '../../lib/labels';

const API_BASE = 'https://api.clearmarket.fyi';

// Cumulative volume - mono, tabular, no em-dash. Zero renders as a flat "$0".
function fmtVol(v: number): string {
  if (!v) return '$0';
  if (v >= 1e9) return `$${(v / 1e9).toFixed(1)}B`;
  if (v >= 1e6) return `$${(v / 1e6).toFixed(1)}M`;
  if (v >= 1e3) return `$${(v / 1e3).toFixed(0)}K`;
  return `$${v.toFixed(0)}`;
}

const rows = getAllEvents().map((e) => {
  const mkts = getMarketsForEvent(e.event_id);
  const resolved = !isEventLive(e);
  const isLadder = (e as any).event_type === 'LADDER';
  // Compact, hard-edged shape codes for the ledger column: LADDER n / BIN / n MKT.
  const shape = isLadder
    ? `LADDER ${mkts.length}`
    : mkts.length <= 1
      ? 'BIN'
      : `${mkts.length} MKT`;
  // Market count used for the data-attr (filter/search untouched by display change).
  const mktCount = isLadder ? mkts.length : mkts.length <= 1 ? 1 : mkts.length;
  const vol = mkts.reduce((s, m) => s + ((m as any).volume_total_usd || 0), 0);
  return {
    id: e.event_id,
    slug: e.slug,
    question: eventDisplayQuestion(e.question, mkts),
    category: e.category || 'other',
    venues: e.venues_covered,
    shape,
    mktCount,
    vol,
    resolved,
    venueStr: e.venues_covered
      .map((v) => (v === 'polymarket' ? 'POLY' : v === 'kalshi' ? 'KAL' : v.toUpperCase()))
      .join(' · '),
  };
});
// Active events first; resolved ones subordinate to the bottom (still browsable, badged RESOLVED).
rows.sort((a, b) => (Number(a.resolved) - Number(b.resolved)) || (b.vol - a.vol) || a.question.localeCompare(b.question));

const cats = Array.from(new Set(rows.map((r) => r.category))).sort();
const canonicalURL = 'https://clearmarket.fyi/events/';
---

<Site title="CM Data - event universe · ClearMarket" description="Browse every graded, cross-venue prediction-market event in the ClearMarket reference universe. Kalshi + Polymarket." canonical={canonicalURL}>
  <article class="cm-v2">
    <h1 class="cm-h1">
      <span class="cm-h1-brand">CLEARMARKET DATA</span>
      <span class="cm-h1-sep">//</span>
      <span class="cm-h1-role">EVENT UNIVERSE</span>
    </h1>
    <p class="cm-index-lede">Every graded, cross-venue prediction-market event · Kalshi + Polymarket · queryable at every surface</p>

    <div class="cm-horizon">
      <span class="cm-horizon-token"><span class="cm-horizon-label">events:</span> <span class="cm-horizon-value" id="ev-count">{rows.length.toLocaleString()}</span></span>
      <span class="cm-horizon-pipe">|</span>
      <span class="cm-horizon-token"><span class="cm-horizon-label">markets:</span> <span class="cm-horizon-value">~18,000</span></span>
      <span class="cm-horizon-pipe">|</span>
      <span class="cm-horizon-token"><span class="cm-horizon-label">query:</span> <a class="cm-horizon-value cm-horizon-link" href="/api/#rest">REST</a> · <a class="cm-horizon-value cm-horizon-link" href="/api/#mcp">MCP</a></span>
    </div>

    {/* Sticky control deck: search row + category filter row + column headers stay
       pinned to the top of the viewport while the ~2,100-row grid scrolls beneath.
       Solid --cm-bg-deep bg + z-index so data rows never bleed through. The thead
       top offset is set in JS to the live deck height (filter row can wrap). */}
    <div class="evl-deck" id="ev-deck">
      <form class="evl-search" role="search" id="ev-search-form" action="/events/" method="get">
        <span class="evl-prompt" aria-hidden="true">&gt;</span>
        <input type="search" id="ev-q" name="q" placeholder="SEARCH UNIVERSE - RECESSION, BITCOIN 150K, FED RATE, OR A VENUE ID" autocomplete="off" aria-label="Search events" />
      </form>
      <div class="evl-api" id="ev-api-hint" hidden>API: <a id="ev-api-link" href="#" target="_blank" rel="noopener"><code></code></a></div>

      <div class="cm-filter-row" id="ev-chips">
        <span class="cm-filter-label">CATEGORY</span>
        <button class="cm-filter cm-filter-active" data-cat="">ALL</button>
        {cats.map((c) => (<Fragment><span class="cm-filter-sep">|</span><button class="cm-filter" data-cat={c}>{c.toUpperCase()}</button></Fragment>))}
      </div>
    </div>

    <div class="cm-table-wrap">
      <table class="evl-table" id="ev-table">
        <thead id="ev-head">
          <tr>
            <th class="evl-th-id">event id</th>
            <th class="evl-th-q">event</th>
            <th class="evl-th-cat evl-th-sort" data-sort="cat" tabindex="0" role="button" aria-label="Sort by category">category <span class="evl-sort-ind" aria-hidden="true">&#8597;</span></th>
            <th class="evl-th-ven">venue</th>
            <th class="evl-th-shape evl-th-sort" data-sort="shape" tabindex="0" role="button" aria-label="Sort by shape">shape <span class="evl-sort-ind" aria-hidden="true">&#8597;</span></th>
            <th class="evl-th-vol evl-th-sort" data-sort="vol" tabindex="0" role="button" aria-label="Sort by volume">vol (cum) <span class="evl-sort-ind" aria-hidden="true">&#8597;</span></th>
          </tr>
        </thead>
        <tbody id="ev-body">
          {rows.map((r) => (
            <tr class={`evl-row${r.resolved ? ' evl-resolved' : ''}`} data-cat={r.category} data-vol={r.vol} data-mkt={r.mktCount} data-resolved={String(r.resolved)} data-q={`${r.question.toLowerCase()} ${r.id.toLowerCase()}`}>
              <td class="evl-id"><a href={`/events/${r.slug}/`}>{r.id}</a></td>
              <td class="evl-q"><a href={`/events/${r.slug}/`}>{r.resolved && <span class="evl-resolved-badge">RESOLVED</span>}{r.question}</a></td>
              <td class="evl-cat">{r.category.toUpperCase()}</td>
              <td class="evl-ven">{r.venueStr}</td>
              <td class="evl-shape">{r.shape}</td>
              <td class="evl-vol">{fmtVol(r.vol)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="cm-ledger-empty" id="ev-empty" hidden>No events match. <a href="/events/">Reset</a>.</p>
  </article>

  <script define:vars={{ API_BASE }} is:inline>
    const body = document.getElementById('ev-body');
    const rowsEl = Array.from(body.querySelectorAll('.evl-row'));
    const countEl = document.getElementById('ev-count');
    const emptyEl = document.getElementById('ev-empty');
    const qInput = document.getElementById('ev-q');
    const chips = Array.from(document.querySelectorAll('.cm-filter'));
    const apiHint = document.getElementById('ev-api-hint');
    const apiLink = document.getElementById('ev-api-link');
    const deck = document.getElementById('ev-deck');
    const head = document.getElementById('ev-head');
    const sortHeads = Array.from(document.querySelectorAll('.evl-th-sort'));
    let activeCat = '';
    // Sort state: null key = server default order (vol desc, then question).
    // dir 'asc' | 'desc'. Sort acts on the currently-filtered visible rows only.
    let sortKey = null;
    let sortDir = 'desc';

    function apply() {
      const q = qInput.value.trim().toLowerCase();
      let shown = 0;
      for (const tr of rowsEl) {
        const vis = (!activeCat || tr.dataset.cat === activeCat) && (!q || tr.dataset.q.includes(q));
        tr.hidden = !vis; if (vis) shown++;
      }
      countEl.textContent = shown.toLocaleString();
      emptyEl.hidden = shown !== 0;
      if (q) { apiLink.href = API_BASE + '/v1/events?q=' + encodeURIComponent(q); apiLink.querySelector('code').textContent = 'GET /v1/events?q=' + q; apiHint.hidden = false; }
      else { apiHint.hidden = true; }
      reorder();
    }

    // Re-stack the currently-visible rows per the active sort. Hidden rows are left
    // in place at the tail so they don't affect the visible ordering.
    function reorder() {
      if (!sortKey) return;
      const vis = rowsEl.filter((r) => !r.hidden);
      const mul = sortDir === 'asc' ? 1 : -1;
      vis.sort((a, b) => {
        let d = 0;
        if (sortKey === 'vol') d = (parseFloat(a.dataset.vol) || 0) - (parseFloat(b.dataset.vol) || 0);
        else if (sortKey === 'shape') d = (parseInt(a.dataset.mkt) || 0) - (parseInt(b.dataset.mkt) || 0);
        else if (sortKey === 'cat') d = a.dataset.cat.localeCompare(b.dataset.cat);
        if (d === 0) d = a.dataset.q.localeCompare(b.dataset.q);
        return d * mul;
      });
      vis.forEach((r) => body.appendChild(r));
    }

    function setSort(key) {
      if (sortKey === key) { sortDir = sortDir === 'asc' ? 'desc' : 'asc'; }
      else { sortKey = key; sortDir = (key === 'cat') ? 'asc' : 'desc'; }
      sortHeads.forEach((th) => {
        const active = th.dataset.sort === sortKey;
        th.classList.toggle('evl-th-active', active);
        const ind = th.querySelector('.evl-sort-ind');
        if (ind) ind.innerHTML = active ? (sortDir === 'asc' ? '&#9650;' : '&#9660;') : '&#8597;';
      });
      reorder();
    }

    let t;
    qInput.addEventListener('input', () => { clearTimeout(t); t = setTimeout(apply, 120); });
    qInput.closest('form').addEventListener('submit', (e) => { e.preventDefault(); apply(); });
    chips.forEach((c) => c.addEventListener('click', () => { chips.forEach((x) => x.classList.remove('cm-filter-active')); c.classList.add('cm-filter-active'); activeCat = c.dataset.cat; apply(); }));
    sortHeads.forEach((th) => {
      th.addEventListener('click', () => setSort(th.dataset.sort));
      th.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setSort(th.dataset.sort); } });
    });

    // The Site layout has a sticky chrome (header + status bar) pinned at top:0.
    // Stack our control deck directly beneath it, then pin the column-header row
    // directly beneath the deck. Both offsets are measured live: chrome height +
    // deck height both vary (nav wraps, filter row wraps) across widths.
    const chrome = document.querySelector('.va-sticky-chrome');
    function syncDeckOffset() {
      if (!deck || !head) return;
      const chromeH = chrome ? chrome.getBoundingClientRect().height : 0;
      deck.style.top = chromeH + 'px';
      const deckH = deck.getBoundingClientRect().height;
      head.querySelectorAll('th').forEach((th) => { th.style.top = (chromeH + deckH) + 'px'; });
    }
    syncDeckOffset();
    window.addEventListener('resize', syncDeckOffset);
    if (window.ResizeObserver) {
      const ro = new ResizeObserver(syncDeckOffset);
      ro.observe(deck);
      if (chrome) ro.observe(chrome);
    }

    const q0 = new URLSearchParams(location.search).get('q');
    if (q0) qInput.value = q0;
    apply();
  </script>
</Site>

<style>
  /* ===========================================================================
   * Header / section / filter tokens replicated VERBATIM from signals/index.astro.
   * The brand/sep/role H1 variant + the bracket-selection cm-filter set live LOCALLY
   * in that file (not in the shared cm-event.css), so they are duplicated here the
   * same way to bring this index into exact visual alignment with the wire ledger.
   * The shared cm-event.css cm-h1 is the LARGE single-event detail header - these
   * rules override it for the index's compact brand // role line.
   * =========================================================================== */

  /* H1 - tight terminal header, brand lands first, role subordinate */
  .cm-v2 .cm-h1 {
    font-family: var(--cm-font-mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 12px 0 4px;
    line-height: 1.2;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }
  .cm-h1-brand { color: var(--cm-fg-primary); }
  .cm-h1-sep   { color: var(--cm-border-rule); font-weight: 400; }
  .cm-h1-role  { color: var(--cm-fg-muted); font-weight: 400; letter-spacing: 0.12em; }
  .cm-index-lede {
    font-family: var(--cm-font-mono);
    font-size: 11px;
    line-height: 1.4;
    color: var(--cm-fg-muted);
    max-width: 100%;
    margin: 0 0 12px;
    letter-spacing: 0.02em;
  }

  /* Section header - flanking-rule pattern, system-log style */
  .cm-v2 .cm-section { margin: 32px 0 14px; }
  .cm-v2 .cm-section:first-of-type { margin-top: 22px; }
  .cm-v2 .cm-section-h {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--cm-font-mono);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--cm-fg-muted);
    padding-bottom: 0;
    border-bottom: 0;
    margin-bottom: 10px;
  }
  .cm-v2 .cm-section-h::before {
    content: "";
    flex: 0 0 24px;
    border-top: 1px solid var(--cm-border-rule);
  }
  .cm-v2 .cm-section-h::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--cm-border-rule);
  }
  .cm-section-tag {
    color: var(--cm-fg-faint);
    font-weight: 400;
    letter-spacing: 0.1em;
    margin-left: 4px;
    text-transform: lowercase;
  }

  /* ===== Sticky control deck =====
   * Search row + category filter row pinned to the top of the viewport as one solid
   * panel. The column-header row (thead) sticks directly beneath via a JS-set top
   * offset equal to this deck's live height. Solid --cm-bg-deep (page bg) so the
   * scrolling grid never bleeds through; z-index above the sticky thead. */
  .evl-deck {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--cm-bg-deep);
    padding-top: 6px;
  }

  /* ===== Search - terminal-prompt input field =====
   * A clearly bordered recess so the eye registers it as an input (not a status
   * line). Leading ">" prompt + a BLINKING block cursor (motion is the strongest
   * "this is a text field" cue, and a blinking caret is terminal-native).
   * Logic + API hint untouched. */
  .evl-search {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 12px;
    border: 1px solid var(--cm-fg-link);
    padding: 10px 12px;
    background: var(--cm-bg-surface);
  }
  .evl-prompt {
    font-family: var(--cm-font-mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--cm-fg-link);
    user-select: none;
    line-height: 1.2;
  }
  .evl-search input {
    flex: 1;
    width: 100%;
    box-sizing: border-box;
    font-family: var(--cm-font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    padding: 0;
    background: transparent;
    color: var(--cm-fg-primary);
    border: 0;
    border-radius: 0;
    outline: none;
  }
  .evl-search:focus-within { border-color: var(--cm-fg-primary); background: var(--cm-bg-deep); }
  .evl-search input::placeholder {
    color: var(--cm-fg-faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* strip the native search-cancel cross so it stays flat-terminal */
  .evl-search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  /* iOS auto-zooms any focused input under 16px and never zooms back — pin to 16px on touch
     so focusing the search box doesn't zoom the whole page. */
  @media (pointer: coarse) { .evl-search input { font-size: 16px; } }
  .evl-api { font-family: var(--cm-font-mono); font-size: 11.5px; color: var(--cm-fg-muted); margin-bottom: 10px; }
  .evl-api a { color: var(--cm-fg-link); text-decoration: none; }
  .evl-api a:hover { text-decoration: underline; }

  /* ===== Category filter - replicated bracket-selection set from signals/index.astro.
   * cm-filter* is local to that file, not shared; brackets are always in the DOM with
   * reserved space (visibility toggles) so chips never reflow on hover/active. ===== */
  .cm-filter-row {
    display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; padding: 2px 0;
    font-family: var(--cm-font-mono); font-size: 11.5px; letter-spacing: 0.02em;
  }
  .cm-filter-label {
    color: var(--cm-fg-muted); letter-spacing: 0.14em; font-weight: 700; min-width: 72px; font-size: 10.5px;
  }
  .cm-filter {
    color: var(--cm-fg-faint); padding: 0; border: 0; background: transparent; border-radius: 0;
    font-family: var(--cm-font-mono); font-size: 11.5px; letter-spacing: 0.04em; cursor: pointer;
    text-transform: uppercase;
  }
  .cm-filter:hover { color: var(--cm-fg-primary); }
  .cm-filter.cm-filter-active { color: var(--cm-fg-primary); font-weight: 700; }
  .cm-filter::before { content: "[ "; color: var(--cm-fg-link); font-weight: 400; visibility: hidden; }
  .cm-filter::after  { content: " ]"; color: var(--cm-fg-link); font-weight: 400; visibility: hidden; }
  .cm-filter.cm-filter-active::before,
  .cm-filter.cm-filter-active::after,
  .cm-filter:hover::before,
  .cm-filter:hover::after { visibility: visible; }
  .cm-filter-sep { color: var(--cm-border-rule); font-weight: 400; user-select: none; }

  /* ===== Ledger table - terminal aesthetic, mono meta, hairline rules, no card frames.
   * The event-id column is the left anchor wall (mono, monochrome link colour). ===== */
  .evl-table { width: 100%; border-collapse: collapse; table-layout: auto; }
  /* Column headers stick directly beneath the control deck. top is set inline by JS
   * to the deck's live height; the 0 fallback here keeps them sticky pre-hydration.
   * z-index 2 sits below the deck (5) so the deck always overlaps on scroll. */
  .evl-table thead th {
    text-align: left; font-family: var(--cm-font-mono); font-size: 10px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--cm-fg-faint);
    padding: 9px 12px; border-bottom: 1px solid var(--cm-border-rule);
    position: sticky; top: 0; background: var(--cm-bg-deep); z-index: 2;
  }
  .evl-th-vol { text-align: right; }

  /* Sortable headers - click to sort the currently-filtered visible rows. A muted
   * up-down chevron marks sortability; it flips to a sharp high-contrast up/down
   * glyph on the active column. Non-sortable headers carry no indicator. */
  .evl-th-sort { cursor: pointer; user-select: none; outline: none; }
  .evl-th-sort:hover { color: var(--cm-fg-muted); }
  .evl-th-sort:focus-visible { color: var(--cm-fg-primary); }
  .evl-th-sort.evl-th-active { color: var(--cm-fg-primary); }
  .evl-sort-ind {
    font-family: var(--cm-font-mono); font-size: 9px; margin-left: 3px;
    color: var(--cm-fg-faint); font-weight: 400;
  }
  .evl-th-active .evl-sort-ind { color: var(--cm-fg-link); font-weight: 700; font-size: 10px; }
  .evl-row { border-bottom: 1px solid var(--cm-border-hairline); transition: background 0.1s; }
  .evl-row:hover { background: var(--cm-bg-surface); }
  .evl-row td { padding: 8px 12px; vertical-align: top; }

  /* left anchor wall - CM-EVT- ids, mono, tabular, link-blue, fixed-ish width, no wrap */
  .evl-id { width: 130px; white-space: nowrap; }
  .evl-id a {
    font-family: var(--cm-font-mono); font-size: 11px; letter-spacing: 0.02em;
    color: var(--cm-fg-link); text-decoration: none; font-variant-numeric: tabular-nums;
  }
  .evl-id a:hover { color: var(--cm-fg-primary); }

  .evl-q a { font-family: var(--cm-font-sans); font-size: 13.5px; color: var(--cm-fg-primary); text-decoration: none; line-height: 1.35; }
  .evl-q a:hover { color: var(--cm-fg-link); }
  /* Resolved events stay browsable but read as subordinate: muted row + a RESOLVED tag. */
  .evl-resolved .evl-q a, .evl-resolved .evl-id a { color: var(--cm-fg-muted); }
  .evl-resolved-badge {
    display: inline-block; margin-right: 7px; padding: 1px 5px; vertical-align: 1px;
    font-family: var(--cm-font-mono); font-size: 9px; font-weight: 700;
    letter-spacing: 0.12em; color: var(--cm-fg-faint);
    border: 1px solid var(--cm-border-emphasis);
  }
  .evl-cat { font-family: var(--cm-font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.08em; color: var(--cm-fg-muted); white-space: nowrap; }
  .evl-ven { font-family: var(--cm-font-mono); font-size: 10.5px; letter-spacing: 0.04em; color: var(--cm-fg-secondary); white-space: nowrap; }
  .evl-shape { font-family: var(--cm-font-mono); font-size: 10.5px; letter-spacing: 0.06em; color: var(--cm-fg-muted); white-space: nowrap; }
  .evl-vol {
    font-family: var(--cm-font-mono); font-size: 12px; color: var(--cm-fg-primary);
    text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;
  }

  /* empty-state - matches wire-index ledger empty */
  .cm-ledger-empty {
    font-family: var(--cm-font-mono); font-size: 11.5px; color: var(--cm-fg-muted); padding: 12px 0;
  }
  .cm-ledger-empty a { color: var(--cm-fg-link); }

  /* mobile - mirror the wire index: drop the scroll wrap, stack each row as a bordered
   * card, event id on its own line as the card label, question under it, meta inline. */
  @media (max-width: 760px) {
    .cm-v2 .cm-h1 { font-size: 13px; flex-wrap: wrap; }
    .cm-table-wrap { overflow-x: visible; }
    .evl-table thead { display: none; }
    .evl-table, .evl-table tbody, .evl-row, .evl-row td { display: block; width: 100%; box-sizing: border-box; }
    /* The card-reflow display:block overrides the `hidden` attribute the JS filter sets —
       so search/category filtering computed but never visually hid rows. Re-assert it. */
    .evl-row[hidden] { display: none; }
    /* Punchier outer border so each event card reads as a discrete object when scrolling
       fast (Gemini: differentiate card boundaries from the muted telemetry inside). */
    .evl-row { border: 1px solid var(--cm-border-rule); padding: 11px 12px; margin-bottom: 8px; }
    .evl-row td { border: none; padding: 0; white-space: normal; }
