                <div class="cm-catalyst-type-col">
                  {ctypeLabel ? <span class="cm-catalyst-type-chip" data-cm-field="type" title={ctype ?? ''}>{ctypeLabel}</span> : <span class="cm-dd-empty">—</span>}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {/* ===== RECENT CM SIGNAL — three-state render: primary / adjacent / threshold-explainer ===== */}
