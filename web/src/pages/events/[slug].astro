    .cm-horizon-warn {
      gap: 6px;
    }
    .cm-horizon-warn-value {
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--cm-divergence);
      background: rgba(240, 168, 48, 0.10);
      border: 1px solid var(--cm-divergence);
      padding: 1px 5px;
      line-height: 1;
    }

    /* Legacy cluster classes — preserved for safety */
    .cm-horizon-cluster, .cm-horizon-left, .cm-horizon-right, .cm-horizon-center, .cm-horizon-dot { display: inline-flex; }
    .cm-horizon-label {
      font-family: var(--cm-font-sans);
      font-size: 11px;
      font-weight: 400;
      color: var(--cm-fg-muted);
      text-transform: lowercase;
      letter-spacing: 0;
    }
    .cm-horizon-value {
      font-family: var(--cm-font-mono);
      font-size: 11.5px;
      font-weight: 500;
      color: var(--cm-fg-link);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-variant-numeric: tabular-nums;
    }
    .cm-horizon-tail {
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      color: var(--cm-fg-faint);
      letter-spacing: 0;
      text-transform: none;
      margin-left: 2px;
    }
    .cm-horizon-dot {
      color: var(--cm-border-rule);
      font-size: 9px;
      margin: 0 4px;
    }
    @media (max-width: 900px) {
      .cm-horizon { height: auto; padding: 6px 0; gap: 4px; }
      .cm-horizon-cluster { padding: 4px 10px; border-right: 0; border-bottom: 1px solid var(--cm-border-hairline); width: 100%; }
      .cm-horizon-cluster:last-child { border-bottom: 0; }
    }

    /* Number tabular-nums helper retained for value spans on the strip and elsewhere */
    .cm-num { font-variant-numeric: tabular-nums; }
    .cm-meta-l {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--cm-fg-muted);
    }
    .cm-meta-tail { color: var(--cm-fg-faint); margin-left: 2px; font-size: 10.5px; }

    /* ========================================
       EDITORIAL CALLOUT — full-width Marconi-shape bullets
       Restored as a standalone callout (was nested inside cm-hero-pair previously).
       ======================================== */
    .cm-editorial-callout {
      display: block;
      background: var(--cm-bg-callout);
      border-left: 2px solid var(--cm-fg-link);
      padding: 12px 16px 14px;
      margin-bottom: var(--cm-space-section-rule);
    }
    /* Outcome strip — green-border emphasis, sits between meta and Editorial Brief
       on resolved events. Plain-language answer to the event question. */
    .cm-outcome-strip {
      display: flex;
      align-items: baseline;
      gap: 10px;
      padding: 10px 14px;
      margin: 14px 0 18px;
      background: rgba(57, 195, 121, 0.06);
      border-left: 2px solid var(--cm-positive);
    }
    .cm-outcome-label {
      font-family: var(--cm-font-mono);
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--cm-positive);
      flex-shrink: 0;
    }
    .cm-outcome-arrow {
      font-family: var(--cm-font-mono);
      color: var(--cm-fg-muted);
      flex-shrink: 0;
    }
    .cm-outcome-text {
      font-family: var(--cm-font-sans);
      font-size: 15px;
      font-weight: 500;
      line-height: 1.4;
      color: var(--cm-fg-primary);
    }
    .cm-callout-label {
      font-family: var(--cm-font-mono);
      font-size: 10px;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--cm-fg-muted);
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--cm-border-hairline);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .cm-callout-tag {
      font-weight: 400;
      color: var(--cm-fg-faint);
      letter-spacing: 0.1em;
    }
    .cm-editorial-bullets {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .cm-editorial-bullets li {
      font-family: var(--cm-font-sans);
      font-size: 13px;
      line-height: 1.55;
      color: var(--cm-fg-primary);
      padding-left: 14px;
      position: relative;
    }
    .cm-editorial-bullets li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 9px;
      width: 6px;
      height: 1px;
      background: var(--cm-fg-link);
    }

    /* ========================================
       SECTIONS — general
       ======================================== */
    .cm-section {
      margin-bottom: var(--cm-space-section-rule);
    }
    /* Scroll-anchor offset so #resolution anchor links account for sticky chrome height
       (~80px main header + ~36px sub-nav ≈ 116px). 120px gives a small buffer. */
    #resolution { scroll-margin-top: 120px; }
    #catalysts { scroll-margin-top: 120px; }
    #signal { scroll-margin-top: 120px; }
    #api { scroll-margin-top: 120px; }
    #markets { scroll-margin-top: 120px; }
    .cm-section-h {
      font-family: var(--cm-font-mono);
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--cm-fg-primary);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
    }
    .cm-section-h::before {
      content: "";
      display: inline-block;
      width: 2px;
      height: 12px;
      background: var(--cm-positive);
      margin-right: 10px;
    }
    .cm-section-summary {
      font-family: var(--cm-font-sans);
      font-size: 13.5px;
      line-height: 1.55;
      color: var(--cm-fg-secondary);
      margin: 0 0 16px;
    }
    .cm-empty-note {
      font-family: var(--cm-font-sans);
      font-size: 13px;
      color: var(--cm-fg-muted);
      font-style: italic;
      margin: 0;
    }

    /* ========================================
       CM SIGNAL STATE 3 — threshold explainer
       Terminal-monitor aesthetic: hairline tracks, bracketed bucket tokens, factual cycle footer
       ======================================== */
    .cm-signal-state3 {
      margin: 0 0 16px 0;
    }
    .cm-signal-state3-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0;
      border-top: 1px solid var(--cm-border-hairline);
      border-bottom: 1px solid var(--cm-border-hairline);
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .cm-signal-state3-status {
      color: var(--cm-fg-secondary);
    }
    .cm-signal-state3-status::before {
      content: '● ';
      color: var(--cm-fg-faint);
    }
    .cm-signal-state3-tag {
      color: var(--cm-fg-faint);
      font-size: 9.5px;
      letter-spacing: 0.10em;
      padding: 2px 7px;
      border: 1px solid var(--cm-border-hairline);
    }
    .cm-signal-state3-body {
      padding: 16px 0 12px 0;
      max-width: 820px;
    }
    .cm-signal-state3-lede {
      font-family: var(--cm-font-mono);
      font-size: 11px;
      font-weight: 600;
      color: var(--cm-fg-primary);
      letter-spacing: 0.04em;
      margin-bottom: 12px;
    }
    .cm-signal-state3-rules {
      margin: 0 0 16px 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .cm-signal-state3-rule {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 16px;
      align-items: baseline;
      padding: 6px 0;
      border-bottom: 1px dashed var(--cm-border-hairline);
    }
    .cm-signal-state3-rule:last-child {
      border-bottom: 0;
    }
    .cm-signal-state3-rule dt {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin: 0;
    }
    .cm-signal-state3-bucket {
      font-family: var(--cm-font-mono);
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: var(--cm-fg-link);
    }
    .cm-signal-state3-token {
      font-family: var(--cm-font-mono);
      font-size: 9.5px;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: var(--cm-fg-muted);
    }
    .cm-signal-state3-rule dd {
      margin: 0;
      font-family: var(--cm-font-sans);
      font-size: 12px;
      color: var(--cm-fg-secondary);
      line-height: 1.45;
    }
    .cm-signal-state3-foot {
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      color: var(--cm-fg-faint);
      letter-spacing: 0.02em;
      padding-top: 12px;
      border-top: 1px solid var(--cm-border-hairline);
    }

    /* ========================================
       PRIMARY MARKETS — compact 2-row summary table
       Shares typography with .cm-mkt-table; differs in P(YES) emphasis
       and the top-contract column carrying a semantic-tag chip + prose.
       ======================================== */
    .cm-primary-table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
      font-family: var(--cm-font-mono);
      font-size: 13px;
      background: var(--cm-bg-surface);
      border: 1px solid var(--cm-border-hairline);
    }
    .cm-primary-table th {
      background: var(--cm-bg-surface);
      color: var(--cm-fg-muted);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 8px 12px;
      text-align: left;
      border-bottom: 1px solid var(--cm-border-rule);
    }
    /* Numeric column headers right-aligned to match their values below */
    .cm-primary-table th.cm-th-num { text-align: right; }
    .cm-primary-table th.cm-th-rcg { text-align: center; }
    .cm-primary-table td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--cm-border-hairline);
      color: var(--cm-fg-primary);
      vertical-align: middle;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    /* Venue ID cell: don't truncate — the inner truncateVenueId() already
       handles the display length, and we need room for the copy glyph. */
    .cm-primary-table td.cm-td-id {
      overflow: visible;
    }
    .cm-primary-table th:not(:last-child),
    .cm-primary-table td:not(:last-child) {
      border-right: 1px solid var(--cm-border-hairline);
    }
    .cm-primary-table tr:last-child td { border-bottom: 0; }
    .cm-primary-table tr:hover { background: var(--cm-bg-callout); }
    .cm-td-venue {
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .cm-td-p-emphasis {
      font-weight: 700;
      font-size: 15px;
      color: var(--cm-fg-primary);
    }
    .cm-td-top-contract {
      white-space: normal !important;
      overflow: visible !important;
      line-height: 1.4;
    }
    .cm-semantic-tag {
      display: inline-block;
      font-family: var(--cm-font-mono);
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--cm-fg-primary);
      background: rgba(255, 255, 255, 0.05);
      padding: 1px 6px;
      margin-right: 8px;
      vertical-align: 1px;
    }
    .cm-q-text {
      font-family: var(--cm-font-sans);
      font-size: 12.5px;
      color: var(--cm-fg-secondary);
    }

    /* ========================================
       MARKET TABLES — Bloomberg-grade
       ======================================== */
    .cm-venue-block {
      margin-bottom: 20px;
      background: var(--cm-bg-surface);
      border: 1px solid var(--cm-border-hairline);
    }
    .cm-venue-block-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px var(--cm-space-card-pad);
      border-bottom: 1px solid var(--cm-border-rule);
    }
    .cm-venue-block-name {
      font-family: var(--cm-font-mono);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--cm-fg-primary);
    }
    .cm-venue-block-count {
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      color: var(--cm-fg-muted);
      letter-spacing: 0.04em;
    }
    /* Event-axis context line — sits between venue-block-head and the table.
       Echoes the event question so the reader keeps context when scrolling down a long ladder. */
    .cm-venue-block-axis {
      padding: 6px var(--cm-space-card-pad);
      border-bottom: 1px solid var(--cm-border-hairline);
      font-family: var(--cm-font-sans);
      font-size: 11.5px;
      color: var(--cm-fg-secondary);
      line-height: 1.4;
    }
    .cm-venue-block-axis-q {
      color: var(--cm-fg-primary);
    }
    .cm-venue-block-axis-sep {
      color: var(--cm-fg-faint);
      margin: 0 6px;
    }
    .cm-venue-block-axis-date {
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      color: var(--cm-fg-muted);
      letter-spacing: 0.04em;
    }
    .cm-table-wrap {
      /* overflow: visible so tooltip pseudo-elements inside table cells can escape.
         Trade-off: very narrow viewports may cause horizontal page scroll. Acceptable
         at v0.2 (desktop-first); revisit when mobile is prioritized. */
      overflow: visible;
    }
    .cm-mkt-table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
      font-family: var(--cm-font-mono);
      font-size: 12.5px;
    }
    .cm-mkt-table th {
      background: var(--cm-bg-surface);
      color: var(--cm-fg-muted);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 8px 12px;
      text-align: left;
      border-bottom: 1px solid var(--cm-border-rule);
      white-space: nowrap;
    }
    /* Numeric column headers right-aligned to match their values below */
    .cm-mkt-table th.cm-th-num { text-align: right; }
    .cm-mkt-table th.cm-th-rcg { text-align: center; }
    .cm-mkt-table td {
      padding: 0 12px;
      height: var(--cm-space-row-tight);
      border-bottom: 1px solid var(--cm-border-hairline);
      color: var(--cm-fg-secondary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .cm-mkt-table th:not(:last-child),
    .cm-mkt-table td:not(:last-child) {
      border-right: 1px solid var(--cm-border-hairline);
    }
    .cm-mkt-table tbody tr:nth-child(2n) { background: var(--cm-bg-surface-alt); }
    .cm-mkt-table tbody tr:hover { background: var(--cm-bg-callout); }
    .cm-mkt-table tbody tr:last-child td { border-bottom: 0; }
    .cm-th-num, .cm-td-num { text-align: right; }
    .cm-th-rcg, .cm-td-rcg { text-align: center; width: 56px; }
    /* RCG cell must allow overflow so the tooltip pseudo-element can escape the td bounds */
    .cm-mkt-table td.cm-td-rcg { overflow: visible; }

    /* Sortable column headers — click to sort, click again to reverse.
       Nansen-shape stacked-arrow icon: ▲ above ▼, both faint when idle.
       When asc-active, top arrow brightens blue. When desc-active, bottom arrow brightens blue. */
    .cm-mkt-table th.cm-th-sortable {
      cursor: pointer;
      user-select: none;
      transition: color 0.12s ease;
    }
    .cm-mkt-table th.cm-th-sortable:hover {
      color: var(--cm-fg-primary);
    }
    .cm-sort-icon {
      display: inline-flex;
      flex-direction: column;
      vertical-align: middle;
      margin-left: 5px;
      line-height: 0.55;
      font-size: 11px;
      font-family: var(--cm-font-mono);
      letter-spacing: 0;
      position: relative;
      top: -1px;
    }
    .cm-sort-icon::before {
      content: '▲';
      color: var(--cm-fg-faint);
      opacity: 0.45;
      transition: color 0.12s ease, opacity 0.12s ease;
    }
    .cm-sort-icon::after {
      content: '▼';
      color: var(--cm-fg-faint);
      opacity: 0.45;
      transition: color 0.12s ease, opacity 0.12s ease;
    }
    .cm-mkt-table th.cm-th-sortable:hover .cm-sort-icon::before,
    .cm-mkt-table th.cm-th-sortable:hover .cm-sort-icon::after {
      color: var(--cm-fg-secondary);
      opacity: 0.85;
    }
    .cm-mkt-table th.cm-th-sortable[data-sort-active="asc"] .cm-sort-icon::before {
      color: var(--cm-fg-link);
      opacity: 1;
    }
    .cm-mkt-table th.cm-th-sortable[data-sort-active="desc"] .cm-sort-icon::after {
      color: var(--cm-fg-link);
      opacity: 1;
    }
    .cm-mkt-table th.cm-th-sortable[data-sort-active] {
      color: var(--cm-fg-primary);
    }
    /* MARKET column reset affordance — subtle, only on hover */
    .cm-mkt-table th.cm-th-reset {
      cursor: pointer;
      user-select: none;
    }
    .cm-mkt-table th.cm-th-reset:hover {
      color: var(--cm-fg-primary);
    }
    .cm-th-id, .cm-td-id { text-align: left; }
    .cm-td-strike { color: var(--cm-fg-primary); font-weight: 500; }
    .cm-td-q {
      font-family: var(--cm-font-sans);
      font-size: 13px;
      color: var(--cm-fg-primary);
      white-space: normal;
      line-height: 1.4;
      padding-top: 8px;
      padding-bottom: 8px;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      text-overflow: ellipsis;
    }
    .cm-td-p { color: var(--cm-fg-primary); font-weight: 500; }

    /* Range/threshold label styling — Bloomberg-shape mono tabular for mathematical scan alignment */
    .cm-td-q-range {
      font-family: var(--cm-font-mono);
      font-size: 11.5px;
      font-weight: 500;
      color: var(--cm-fg-primary);
      letter-spacing: 0.02em;
      white-space: nowrap;
      line-height: 1.4;
      -webkit-line-clamp: unset;
      display: table-cell;
    }

    /* Sparkbar columns — dedicated narrow columns for distribution visualization.
       P(YES) bar = blue (probability mass). VOL CUM bar = green (liquidity/conviction).
       Tightly paired with their preceding numeric cell (reduced inter-cell padding)
       so the number + bar read as a single visual unit. */
    .cm-th-bar, .cm-td-bar {
      padding: 0 2px;
      vertical-align: middle;
    }
    /* Tighten padding on the numeric cell immediately preceding a bar cell */
    .cm-mkt-table .cm-td-num:has(+ .cm-td-bar) { padding-right: 4px; }
    .cm-mkt-table .cm-th-num:has(+ .cm-th-bar) { padding-right: 4px; }
    .cm-bar-track {
      position: relative;
      width: 100%;
      height: 5px;
      background: rgba(255, 255, 255, 0.12);
      border-radius: 1px;
      overflow: hidden;
    }
    .cm-bar-fill {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      min-width: 1px;
      max-width: 100%;
      border-radius: 1px;
    }
    .cm-bar-prob { background: var(--cm-fg-link); }   /* #5c9dff — blue, P(YES) */
    .cm-bar-vol  { background: var(--cm-positive); }   /* #10d894 — green, volume */

    .cm-mono-id {
      font-family: var(--cm-font-mono);
      font-size: 11px;
      color: var(--cm-fg-faint);
      background: rgba(255, 255, 255, 0.02);
      padding: 1px 5px;
    }
    .cm-copy {
      cursor: pointer;
      user-select: all;
      transition: background 0.15s, color 0.15s;
    }
    .cm-copy::after {
      content: " ⧉";
      color: var(--cm-fg-muted);
      font-weight: 400;
      margin-left: 2px;
      opacity: 0.7;
      transition: opacity 0.15s;
    }
    .cm-copy:hover {
      background: rgba(255, 255, 255, 0.08);
      color: var(--cm-fg-secondary);
    }
    .cm-copy:hover::after {
      opacity: 1;
      color: var(--cm-fg-primary);
    }
    .cm-copy.cm-copied {
      background: rgba(16, 216, 148, 0.18);
      color: var(--cm-positive);
    }
    .cm-copy.cm-copied::after {
      content: " ✓";
      color: var(--cm-positive);
      opacity: 1;
      font-weight: 600;
    }

    /* RCG chips — A vs C visual asymmetry */
    /* Resolution Clarity Grade chips — per-contract grade with outline weight per grade
       so column variance is scannable even when colors are similar (bond-rating analogy).
       Hover triggers custom CSS tooltip (.cm-tt). Click anchors to #resolution. A=solid, B=dashed, C=dotted. */
    .cm-rcg-chip {
      display: inline-block;
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      font-weight: 600;
      padding: 2px 6px;
      letter-spacing: 0.08em;
      cursor: pointer;
      text-decoration: none;
      transition: transform 0.1s ease;
    }
    .cm-rcg-chip:hover { transform: scale(1.06); }

    /* ========================================
       TOOLTIP — CSS-only, terminal-styled
       ========================================
       Reusable. Apply class="cm-tt" + data-tt="..." to any element.
       Tooltip renders above the trigger, centered. Fast trigger (no 700ms native delay).
       Accessible via paired aria-label. Works on hover + keyboard focus. */
    .cm-tt {
      position: relative;
    }
    .cm-tt::after {
      content: attr(data-tt);
      position: absolute;
      bottom: calc(100% + 8px);
      left: 50%;
      transform: translateX(-50%);
      width: max-content;
      max-width: 280px;
      padding: 8px 10px;
      background: var(--cm-bg-callout);
      border: 1px solid var(--cm-border-emphasis);
      color: var(--cm-fg-primary);
      font-family: var(--cm-font-sans);
      font-size: 11.5px;
      font-weight: 400;
      line-height: 1.45;
      letter-spacing: 0;
      text-align: left;
      text-transform: none;
      white-space: normal;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      z-index: 200;
      transition: opacity 0.12s ease, visibility 0.12s ease;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    }
    .cm-tt::before {
      content: '';
      position: absolute;
      bottom: calc(100% + 2px);
      left: 50%;
      transform: translateX(-50%);
      border: 6px solid transparent;
      border-top-color: var(--cm-border-emphasis);
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      z-index: 201;
      transition: opacity 0.12s ease, visibility 0.12s ease;
    }
    .cm-tt:hover::after,
    .cm-tt:hover::before,
    .cm-tt:focus-visible::after,
    .cm-tt:focus-visible::before {
      opacity: 1;
      visibility: visible;
    }
    /* Right-edge variant: tooltip anchored to right of trigger (use for rightmost columns to avoid viewport clip) */
    .cm-tt[data-tt-pos="left"]::after {
      left: auto;
      right: 50%;
      transform: translateX(50%);
    }
    .cm-rcg-a {
      border: 1.5px solid var(--cm-positive);
      color: var(--cm-positive);
      background: transparent;
    }
    .cm-rcg-b {
      border: 1.5px dashed var(--cm-border-emphasis);
      color: var(--cm-fg-secondary);
      background: transparent;
    }
    .cm-rcg-c {
      border: 1.5px dotted var(--cm-divergence);
      color: var(--cm-divergence);
      background: rgba(240, 168, 48, 0.10);
      font-weight: 700;
    }

    /* ========================================
       SPLIT LAYOUT — Resolution + Catalyst
       ======================================== */
    .cm-split {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 24px;
      align-items: stretch;
      margin-bottom: var(--cm-space-section-rule);
    }
    .cm-split-left, .cm-split-right {
      margin-bottom: 0;
      display: flex;
      flex-direction: column;
    }
    .cm-split-left .cm-res-table,
    .cm-split-right .cm-catalyst-timeline { flex: 1 0 auto; }
    @media (max-width: 900px) {
      .cm-split { grid-template-columns: 1fr; }
    }

    .cm-res-table {
      width: 100%;
      border-collapse: collapse;
      font-family: var(--cm-font-mono);
      font-size: 12.5px;
      background: var(--cm-bg-surface);
      border: 1px solid var(--cm-border-hairline);
    }
    .cm-res-table th {
      background: var(--cm-bg-surface);
      color: var(--cm-fg-muted);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 8px 12px;
      text-align: left;
      border-bottom: 1px solid var(--cm-border-rule);
    }
    .cm-res-table td {
      padding: 8px 12px;
      border-bottom: 1px solid var(--cm-border-hairline);
      color: var(--cm-fg-primary);
      vertical-align: top;
    }
    .cm-res-table th:not(:last-child),
    .cm-res-table td:not(:last-child) {
      border-right: 1px solid var(--cm-border-hairline);
    }
    .cm-res-table tbody tr:last-child td { border-bottom: 0; }
    .cm-res-td-venue { font-weight: 600; }
    .cm-res-td-src {
      font-family: var(--cm-font-sans);
      font-size: 13px;
      color: var(--cm-fg-secondary);
      line-height: 1.4;
      white-space: normal;
    }
    .cm-th-rcg-dist, .cm-td-rcg-dist { text-align: center; }
    .cm-code-pill {
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--cm-fg-primary);
      background: var(--cm-bg-deep);
      border: 1px solid var(--cm-border-hairline);
      padding: 2px 6px;
    }
    .cm-clarity-dist {
      font-family: var(--cm-font-mono);
      font-size: 11px;
      color: var(--cm-fg-primary);
      letter-spacing: 0.06em;
    }
    .cm-dd-empty { color: var(--cm-fg-faint); font-style: italic; font-size: 11.5px; }
    /* Header cells with help tooltips — cursor + faint underline-on-hover signals interactivity */
    .cm-res-table th.cm-th-help {
      cursor: help;
      border-bottom: 1px dotted var(--cm-border-emphasis);
    }
    /* Verbatim platform source string — quoted to signal "this is exactly what the venue published" */
    .cm-verbatim {
      font-family: var(--cm-font-sans);
      color: var(--cm-fg-primary);
    }
    /* Class chip — DCM (regulated) green, DeFi (unregulated) amber, Other (unknown) muted gray.
       text-transform NOT set — chip preserves the source casing (DCM all-caps as acronym; DeFi mixed-case as conventional). */
    .cm-class-chip {
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.06em;
      padding: 2px 8px;
      border: 1.5px solid;
      background: transparent;
    }
    .cm-class-dcm { color: var(--cm-positive); border-color: var(--cm-positive); }
    .cm-class-defi { color: var(--cm-divergence); border-color: var(--cm-divergence); }
    .cm-class-other { color: var(--cm-fg-secondary); border-color: var(--cm-border-emphasis); }
    /* Analyst notes cell — sans, slightly muted, wraps to fit operational sentence */
    .cm-res-td-notes {
      font-family: var(--cm-font-sans);
      font-size: 12px;
      color: var(--cm-fg-secondary);
      line-height: 1.4;
      white-space: normal;
      max-width: 240px;
    }

    /* Resolution rules verbatim block — two-column layout per venue.
       LEFT: verbatim prose (constrained reading measure).
       RIGHT: real settlement-reference metadata (no invented values). */
    .cm-res-rules {
      margin-top: 20px;
      padding: 20px 24px;
      background: var(--cm-bg-surface);
      border: 1px solid var(--cm-border-hairline);
    }
    .cm-res-rules-h {
      font-family: var(--cm-font-mono);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--cm-fg-muted);
      margin-bottom: 14px;
    }
    .cm-res-rules-block {
      margin-bottom: 18px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--cm-border-hairline);
    }
    .cm-res-rules-block:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: 0;
    }
    .cm-res-rules-venue {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }
    .cm-res-rules-venue-name {
      font-family: var(--cm-font-mono);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.10em;
      color: var(--cm-fg-primary);
    }
    .cm-res-rules-venue-count {
      font-family: var(--cm-font-mono);
      font-size: 10px;
      color: var(--cm-fg-muted);
      letter-spacing: 0.04em;
    }
    /* Verbatim rules text — collapsed by default behind <details>. When expanded,
       Bloomberg/Refinitiv-shape fine-print treatment: small font, left block-quote border, tighter line-height. */
    .cm-res-rules-text {
      font-family: var(--cm-font-sans);
      font-size: 11.5px;
      line-height: 1.5;
      color: var(--cm-fg-secondary);
      white-space: pre-wrap;
      padding-left: 12px;
      border-left: 2px solid var(--cm-border-rule);
      max-width: 820px;
      margin-top: 12px;
    }
    /* Details/summary disclosure for verbatim rules — high-density, low-contrast action bar */
    .cm-res-rules-details {
      margin-top: 4px;
    }
    .cm-res-rules-summary {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 0;
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--cm-fg-muted);
      cursor: pointer;
      user-select: none;
      list-style: none;
      transition: color 0.15s ease;
    }
    .cm-res-rules-summary::-webkit-details-marker { display: none; }
    .cm-res-rules-summary::marker { content: ''; }
    .cm-res-rules-summary:hover { color: var(--cm-fg-secondary); }
    .cm-res-rules-arrow {
      display: inline-block;
      font-size: 9px;
      color: var(--cm-fg-faint);
      transition: transform 0.2s ease;
    }
    .cm-res-rules-details[open] .cm-res-rules-arrow { transform: rotate(90deg); }
    .cm-res-rules-details[open] .cm-res-rules-summary { color: var(--cm-fg-secondary); }
    /* Metadata ribbon — flat full-width track. Hairline top/bottom borders, no fill.
       Matches the flat terminal grid architecture of the tables above. */
    .cm-res-rules-ribbon {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0;
      padding: 8px 0;
      margin: 8px 0 0 0;
      border-top: 1px solid var(--cm-border-hairline);
      border-bottom: 1px solid var(--cm-border-hairline);
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
    }
    .cm-res-rules-ribbon-cell {
      display: flex;
      align-items: baseline;
      gap: 6px;
      padding: 0 16px;
      border-right: 1px solid var(--cm-border-hairline);
    }
    .cm-res-rules-ribbon-cell:first-child { padding-left: 0; }
    .cm-res-rules-ribbon-cell:last-child { border-right: 0; }
    .cm-res-rules-ribbon-k {
      color: var(--cm-fg-muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-size: 9.5px;
    }
    .cm-res-rules-ribbon-v {
      color: var(--cm-fg-primary);
      font-weight: 500;
      letter-spacing: 0.02em;
    }
    .cm-res-rules-ribbon-link {
      color: var(--cm-fg-link);
      text-decoration: underline;
      text-decoration-color: rgba(92, 157, 255, 0.4);
      font-weight: 500;
    }
    .cm-res-rules-ribbon-link:hover { text-decoration-color: var(--cm-fg-link); }
    /* Underlying reference — sits directly under the ribbon, secondary inline block */
    .cm-res-rules-underlying {
      display: flex;
      align-items: baseline;
      gap: 10px;
      padding: 6px 0;
      margin: 0 0 12px 0;
      border-bottom: 1px solid var(--cm-border-hairline);
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      color: var(--cm-fg-secondary);
    }
    .cm-res-rules-underlying-k {
      color: var(--cm-fg-muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-size: 9.5px;
      flex-shrink: 0;
    }
    .cm-res-rules-underlying-v {
      color: var(--cm-fg-primary);
      font-family: var(--cm-font-sans);
      font-size: 11.5px;
    }
    .cm-res-rules-empty {
      color: var(--cm-fg-faint);
      font-style: italic;
    }

    /* Catalyst timeline — vertical line + dots + days-from-now indicator
       Visually differentiates from the grid-shape Resolution Architecture beside it. */
    .cm-catalyst-timeline {
      list-style: none;
      margin: 0;
      padding: 16px 18px 16px 12px;
      background: linear-gradient(180deg, rgba(16, 216, 148, 0.025) 0%, transparent 100%), var(--cm-bg-surface);
      border: 1px solid var(--cm-border-hairline);
      border-left: 2px solid var(--cm-positive);
      position: relative;
    }
    /* Gemini-spec rigid grid layout — 5 fixed columns */
    .cm-catalyst-grid {
      background: var(--cm-bg-surface);
      border: 1px solid var(--cm-border-hairline);
    }
    .cm-catalyst-head {
      display: grid;
      grid-template-columns: 70px 110px 1fr 220px 110px;
      gap: 16px;
      padding: 10px 16px;
      border-bottom: 1px solid var(--cm-border-rule);
      font-family: var(--cm-font-mono);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--cm-fg-muted);
      text-transform: uppercase;
    }
    .cm-catalyst-grid-row {
      display: grid;
      grid-template-columns: 70px 110px 1fr 220px 110px;
      gap: 16px;
      padding: 12px 16px;
      align-items: center;
      border-bottom: 1px solid var(--cm-border-hairline);
    }
    .cm-catalyst-grid-row:last-child { border-bottom: 0; }
    .cm-catalyst-dte {
      font-family: var(--cm-font-mono);
      font-size: 11px;
      font-weight: 600;
      color: var(--cm-positive);
      letter-spacing: 0.04em;
    }
    .cm-catalyst-grid-row .cm-catalyst-date {
      font-family: var(--cm-font-mono);
      font-size: 12px;
      color: var(--cm-fg-primary);
      letter-spacing: 0.02em;
    }
    .cm-catalyst-event-col {
      min-width: 0;
    }
    .cm-catalyst-event-title {
      font-family: var(--cm-font-sans);
      font-size: 13px;
      font-weight: 500;
      color: var(--cm-fg-primary);
      line-height: 1.35;
    }
    .cm-catalyst-meta-col {
      font-family: var(--cm-font-mono);
      font-size: 10px;
      color: var(--cm-fg-muted);
      line-height: 1.5;
    }
    .cm-catalyst-meta-col .cm-catalyst-source {
      display: block;
      color: var(--cm-fg-link);
      text-decoration: underline;
      text-decoration-color: rgba(92, 157, 255, 0.4);
      text-underline-offset: 2px;
    }
    .cm-catalyst-meta-col .cm-catalyst-source:hover {
      text-decoration-color: var(--cm-fg-link);
    }
    .cm-catalyst-meta-col .cm-catalyst-verified {
      color: var(--cm-fg-muted);
    }
    .cm-catalyst-type-col {
      display: flex;
      justify-content: flex-start;
      align-items: center;
    }
    /* Plain text — no box, no background. Mono uppercase, muted color. */
    .cm-catalyst-grid .cm-catalyst-type-chip {
      display: inline-block;
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      font-weight: 500;
      letter-spacing: 0.08em;
      color: var(--cm-fg-muted);
      white-space: nowrap;
    }
    /* Tightened timeline aesthetic — small dots, hairline connector, dense rows.
       Metadata sits BENEATH the event description, not in a far-right column (no center void). */
    .cm-catalyst-row {
      display: grid;
      grid-template-columns: 10px 1fr;
      gap: 12px;
      padding: 6px 0;
      position: relative;
      align-items: start;
    }
    .cm-catalyst-row:not(:last-child)::after {
      content: "";
      position: absolute;
      left: 3px;
      top: 18px;
      bottom: -6px;
      width: 1px;
      background: var(--cm-border-hairline);
    }
    .cm-catalyst-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--cm-bg-deep);
      border: 1.5px solid var(--cm-positive);
      margin-top: 6px;
      flex-shrink: 0;
      z-index: 1;
    }
    .cm-catalyst-near .cm-catalyst-dot {
      background: var(--cm-positive);
    }
    .cm-catalyst-past .cm-catalyst-dot {
      border-color: var(--cm-fg-faint);
    }
    /* Catalyst type chip — uppercased + canonical display label */
    .cm-catalyst-type {
      font-family: var(--cm-font-mono);
      font-size: 9.5px;
      font-weight: 600;
      letter-spacing: 0.10em;
      color: var(--cm-fg-secondary);
      background: var(--cm-bg-deep);
      border: 1px solid var(--cm-border-hairline);
      padding: 1px 5px;
    }
    /* Inline metadata row — sits BENEATH the event description.
       Source URL + verified timestamp, separated by · dot. No far-right canyon. */
    .cm-catalyst-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px;
      margin-top: 4px;
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      color: var(--cm-fg-muted);
    }
    .cm-catalyst-source {
      text-decoration: none;
      color: var(--cm-fg-link);
    }
    .cm-catalyst-source-host {
      text-decoration: underline;
      text-decoration-color: rgba(92, 157, 255, 0.4);
      text-underline-offset: 3px;
    }
    .cm-catalyst-source:hover .cm-catalyst-source-host {
      text-decoration-color: var(--cm-fg-link);
    }
    .cm-catalyst-meta-sep {
      color: var(--cm-fg-faint);
    }
    .cm-catalyst-verified {
      color: var(--cm-fg-muted);
    }
    .cm-catalyst-date-row {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 2px;
    }
    .cm-catalyst-date {
      font-family: var(--cm-font-mono);
      font-size: 12px;
      font-weight: 600;
      color: var(--cm-positive);
      letter-spacing: 0.04em;
    }
    .cm-catalyst-past .cm-catalyst-date {
      color: var(--cm-fg-faint);
    }
    .cm-catalyst-delta {
      font-family: var(--cm-font-mono);
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--cm-fg-muted);
      padding: 1px 5px;
      background: rgba(255, 255, 255, 0.04);
    }
    .cm-catalyst-near .cm-catalyst-delta {
      color: var(--cm-positive);
      background: rgba(16, 216, 148, 0.10);
    }
    .cm-catalyst-event {
      font-family: var(--cm-font-sans);
      font-size: 13.5px;
      color: var(--cm-fg-primary);
      line-height: 1.4;
    }
    .cm-catalyst-past .cm-catalyst-event {
      color: var(--cm-fg-muted);
    }

    /* Legacy catalyst list class — preserved for safety */
    .cm-catalyst-list { display: none; }

    /* ========================================
       WIRE ITEMS
       ======================================== */
    .cm-mark-inline {
      font-family: var(--cm-font-mono);
      background: var(--cm-fg-primary);
      color: var(--cm-bg-deep);
      padding: 0 4px;
      letter-spacing: 0.06em;
    }
    .cm-wire-list { list-style: none; margin: 0; padding: 0; }
    .cm-wire {
      padding: 14px 16px 14px 18px;
      border: 1px solid var(--cm-border-hairline);
      border-left: 3px solid var(--cm-border-rule);
      background: var(--cm-bg-surface);
      margin-bottom: 10px;
      transition: border-color 0.2s;
    }
    /* Bucket accents — A: cross-venue (link blue), B: benchmark (divergence amber),
       C: news-cycle (muted, coverage not editorial) */
    .cm-wire[data-cm-bucket="A"] {
      border-left-color: var(--cm-fg-link);
      background: linear-gradient(90deg, rgba(92, 157, 255, 0.04) 0%, var(--cm-bg-surface) 60%);
    }
    .cm-wire[data-cm-bucket="B"] {
      border-left-color: var(--cm-divergence);
      background: linear-gradient(90deg, rgba(240, 168, 48, 0.04) 0%, var(--cm-bg-surface) 60%);
    }
    .cm-wire[data-cm-bucket="C"] {
      border-left-color: var(--cm-fg-muted);
    }
    .cm-wire:hover {
      border-color: var(--cm-border-emphasis);
    }
    /* Legacy bucket-mark class — preserved for safety, no longer rendered */
    .cm-wire-bucket-mark { display: none; }
    .cm-wire-meta {
      display: flex;
      gap: 12px;
      align-items: center;
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      color: var(--cm-fg-muted);
      margin-bottom: 8px;
    }
    .cm-wire-tag { color: var(--cm-positive); }
    .cm-wire[data-cm-bucket="A"] .cm-wire-tag { color: var(--cm-fg-link); }
    .cm-wire[data-cm-bucket="B"] .cm-wire-tag { color: var(--cm-divergence); }
    .cm-wire[data-cm-bucket="C"] .cm-wire-tag { color: var(--cm-fg-muted); }
    .cm-wire-head {
      display: block;
      font-family: var(--cm-font-mono);
      font-size: 14px;
      font-weight: 600;
      color: var(--cm-fg-primary);
      text-decoration: none;
      margin-bottom: 8px;
      line-height: 1.35;
    }
    .cm-wire-bullet-0 {
      font-family: var(--cm-font-sans);
      font-size: 13px;
      line-height: 1.5;
      color: var(--cm-fg-secondary);
      margin: 0;
    }
    .cm-wire-bullets {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .cm-wire-bullets li {
      font-family: var(--cm-font-sans);
      font-size: 13px;
      line-height: 1.5;
      color: var(--cm-fg-secondary);
      padding-left: 14px;
      position: relative;
      margin-bottom: 4px;
    }
    .cm-wire-bullets li:before {
      content: "•";
      position: absolute;
      left: 2px;
      color: var(--cm-fg-faint);
    }
    .cm-wire-bullets li:last-child { margin-bottom: 0; }
    .cm-wire-bullets li code {
      font-family: var(--cm-font-mono);
      font-size: 11.5px;
      color: var(--cm-fg-primary);
      background: rgba(255, 255, 255, 0.04);
      padding: 0 4px;
    }
    .cm-wire-tag-2 {
      color: var(--cm-fg-muted);
      font-size: 10.5px;
    }
    .cm-placeholder-note {
      font-style: normal;
      color: var(--cm-fg-muted);
      font-size: 12.5px;
      line-height: 1.55;
      background: var(--cm-bg-callout);
      border-left: 2px solid var(--cm-divergence);
      padding: 10px 14px;
      margin-bottom: 16px;
    }
    .cm-wire-list-placeholder .cm-wire {
      opacity: 0.85;
    }
    .cm-wire-placeholder-lbl {
      margin-left: auto;
      color: var(--cm-divergence);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }
    .cm-wire-meta { width: 100%; align-items: center; }

    /* ========================================
       PROGRAMMATIC ACCESS
       ======================================== */
    .cm-section-machine .cm-section-summary { max-width: 720px; }
    .cm-endpoints-table {
      width: 100%;
      border-collapse: collapse;
      font-family: var(--cm-font-mono);
      font-size: 12px;
      background: var(--cm-bg-surface);
      border: 1px solid var(--cm-border-hairline);
      margin-bottom: 16px;
    }
    .cm-endpoints-table td {
      padding: 8px 12px;
      border-bottom: 1px solid var(--cm-border-hairline);
      vertical-align: middle;
    }
