---
/* ClearMarket event page — v2
 * Route: /events-v2/[slug]/ (A/B against canonical /events/[slug]/)
 * Spec: ~/jeremy-os/outputs/clearmarket/event-page-design-tokens.md
 *
 * What's different vs v1:
 *  - Tokens externalized to src/styles/tokens.css (no inline style soup)
 *  - Container widens 1080 → 1280px (less letterboxing)
 *  - Banner-shape header: atomic ID + divergence chip + snapshot ride on one line above H1
 *  - editorial_notes rendered as a callout under H1 (was hidden)
 *  - Compressed row heights, hairline column rules, single-accent meaning
 *  - Per-row magnitude bars on cumulative-volume column (Nansen pattern)
 *  - RCG C grade visually weighs more than A grade
 *  - Before/After section between Resolution and Programmatic Access (README centerpiece)
 *  - Programmatic Access elevated to peer-level (not buried below empty Signal section)
 *  - data-cm-field annotations on every value cell (machine parsing)
 *  - JSON-LD Dataset block in <head> (already correct shape)
 *
 * Schema fields rendered visibly: event_id, question, category, tags, venues_covered,
 * vol cumulative, vol 24h, resolves, snapshot, editorial_notes, primary markets,
 * all markets per venue with P(YES) + volumes + spreads + RCG + venue_id,
 * arbitration_model, resolution_proposer, resolution_source + url, RCG distribution,
 * catalyst_dates, recent CM Signal wire items, programmatic endpoints, raw JSON record.
 *
 * Schema fields invisible (JSON only): field_provenance per-cell, verified_at per
 * catalyst, full tags array (one tag shown inline as category context).
 */
import Site from '../../layouts/Site.astro';
import '../../styles/tokens.css';
import {
  getAllEvents,
  getEventBySlug,
  getMarketsForEvent,
  getMarksForEvent,
  SPECIMEN_GENERATED_AT,
  SCHEMA_VERSION,
  type Event,
  type Market,
  type Mark,
} from '../../lib/universe';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return getAllEvents().map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props as { event: Event };

const markets = getMarketsForEvent(event.event_id);
const marks = getMarksForEvent(event.event_id);

// Latest mark per market
const latestMarkByMarketId = new Map<string, Mark>();
for (const mark of marks) {
  const existing = latestMarkByMarketId.get(mark.market_id);
  if (!existing || new Date(mark.snapshot_at) > new Date(existing.snapshot_at)) {
    latestMarkByMarketId.set(mark.market_id, mark);
  }
}

// Venue grouping
const marketsByPlatform: Record<'kalshi' | 'polymarket', Market[]> = {
  kalshi: markets.filter((m) => m.platform === 'kalshi'),
  polymarket: markets.filter((m) => m.platform === 'polymarket'),
};

// ----- helpers -----
function formatPrice(p: number | null | undefined): string {
  if (p === null || p === undefined) return '—';
  return `${(p * 100).toFixed(1)}%`;
}
function formatVol(v: number | null | undefined): string {
  if (v === null || v === undefined) return '—';
  if (v >= 1e9) return `$${(v / 1e9).toFixed(2)}B`;
  if (v >= 1e6) return `$${(v / 1e6).toFixed(2)}M`;
  if (v >= 1e4) return `$${(v / 1e3).toFixed(0)}K`;
  if (v >= 1e3) return `$${(v / 1e3).toFixed(1)}K`;
  return `$${(v / 1e3).toFixed(2)}K`;
}
function formatDate(d: string | null | undefined): string {
  if (!d) return '—';
  return d.slice(0, 10);
}
function formatSnapshot(d: string): string {
  return d.slice(0, 10);
}
function spreadCents(bid: number | null | undefined, ask: number | null | undefined): string {
  if (bid === null || bid === undefined || ask === null || ask === undefined) return '—';
  return `${((ask - bid) * 100).toFixed(1)}¢`;
}
function truncateVenueId(id: string): { display: string; full: string } {
  if (id.length <= 18) return { display: id, full: id };
  if (id.startsWith('0x')) return { display: `${id.slice(0, 8)}…${id.slice(-4)}`, full: id };
  return { display: `${id.slice(0, 14)}…${id.slice(-3)}`, full: id };
}

// Catalyst-row helpers — kept outside JSX so the parser doesn't choke on `<` comparisons.
function catalystProximity(dDays: number): 'past' | 'near' | 'future' {
  if (dDays < 0) return 'past';
  if (dDays <= 7) return 'near';
  return 'future';
}
function catalystDelta(dDays: number): string {
  if (dDays === 0) return 'today';
  if (dDays < 0) return `${Math.abs(dDays)}d ago`;
  return `+${dDays}d`;
}

// Venue deep-link patterns. Best-effort only — return null if unsure.
function venueMarketUrl(m: Market): string | null {
  if (m.platform === 'kalshi') {
    // Kalshi tickers route like https://kalshi.com/markets/KXFED-26APR-T3.00
    return `https://kalshi.com/markets/${m.platform_market_id}`;
  }
  if (m.platform === 'polymarket') {
    // Polymarket condition IDs route via https://polymarket.com/market/<conditionId>
    return `https://polymarket.com/market/${m.platform_market_id}`;
  }
  return null;
}
function extractStrike(m: Market): number | null {
  const match = m.platform_market_id.match(/T(\d+(?:\.\d+)?)$/);
  return match ? parseFloat(match[1]) : null;
}

// Format a number with commas + sensible decimals
function fmtNum(n: number): string {
  if (Math.abs(n) >= 1000) return n.toLocaleString('en-US', { minimumFractionDigits: n % 1 === 0 ? 0 : 2, maximumFractionDigits: 2 });
  return n.toFixed(2);
}

// Extract market label from question_raw — strips boilerplate down to mathematical tokens.
// Handles: range ("between X and Y"), below threshold, above threshold. Falls back to fulltext.
// Returns a sortKey for option-chain-style numeric sorting when type !== 'fulltext'.
function extractMarketLabel(q: string | null | undefined): { label: string; type: 'range' | 'threshold-below' | 'threshold-above' | 'fulltext'; sortKey: number | null } {
  if (!q) return { label: '—', type: 'fulltext', sortKey: null };
  // Basis-point delta: "decrease by X bps" / "increase by X bps" / "no change" (Fed monetary-policy events)
  // Matches "by 50+ bps", "by 25 bps", "by 25 b" (truncated forms)
  const decBpsMatch = q.match(/decreas\w*\s+(?:interest\s+rates?\s+)?by\s+(\d+(?:\.\d+)?)(\+)?\s*bp/i);
  if (decBpsMatch) {
    const val = parseFloat(decBpsMatch[1]);
    const plus = decBpsMatch[2] ? '+' : '';
    return { label: `−${val}${plus} bps`, type: 'threshold-below', sortKey: -val };
  }
  const incBpsMatch = q.match(/increas\w*\s+(?:interest\s+rates?\s+)?by\s+(\d+(?:\.\d+)?)(\+)?\s*bp/i);
  if (incBpsMatch) {
    const val = parseFloat(incBpsMatch[1]);
    const plus = incBpsMatch[2] ? '+' : '';
    return { label: `+${val}${plus} bps`, type: 'threshold-above', sortKey: val };
  }
  if (/no\s+change/i.test(q)) {
    return { label: 'no change', type: 'range', sortKey: 0 };
  }
  // Range: "between X and Y"
  const rangeMatch = q.match(/between\s+\$?([\d,.]+)\s+and\s+\$?([\d,.]+)/i);
  if (rangeMatch) {
    const low = parseFloat(rangeMatch[1].replace(/,/g, ''));
    const high = parseFloat(rangeMatch[2].replace(/,/g, ''));
    if (!isNaN(low) && !isNaN(high)) {
      return { label: `${fmtNum(low)} – ${fmtNum(high)}`, type: 'range', sortKey: low };
    }
  }
  // Below: "below X" / "less than X" / "under X"
  const belowMatch = q.match(/(?:below|less than|under)\s+\$?([\d,.]+)(\s*%)?/i);
  if (belowMatch) {
    const val = parseFloat(belowMatch[1].replace(/,/g, ''));
    if (!isNaN(val)) {
      const unit = (belowMatch[2] || '').trim();
      return { label: `< ${fmtNum(val)}${unit}`, type: 'threshold-below', sortKey: val };
    }
  }
  // Above: "above X" / "more than X" / "greater than X" / "over X"
  const aboveMatch = q.match(/(?:above|more than|greater than|over)\s+\$?([\d,.]+)(\s*%)?/i);
  if (aboveMatch) {
    const val = parseFloat(aboveMatch[1].replace(/,/g, ''));
    if (!isNaN(val)) {
      const unit = (aboveMatch[2] || '').trim();
      return { label: `> ${fmtNum(val)}${unit}`, type: 'threshold-above', sortKey: val };
    }
  }
  // Fallback: full question text
  return { label: q, type: 'fulltext', sortKey: null };
}

// RCG (Resolution Clarity Grade) — per-contract tooltip text shown on hover
const RCG_TOOLTIPS = {
  A: 'Resolution Clarity Grade A — institutional-grade resolution. Named source, mechanical settlement, no judgment.',
  B: 'Resolution Clarity Grade B — named source URL exists, but resolution involves oracle or staff judgment.',
  C: 'Resolution Clarity Grade C — no named source URL. Resolution relies on oracle or staff judgment without public reference.',
} as const;

// RCG (resolution_clarity) — A = data feed + URL, B = oracle/staff w/ URL, C = oracle/staff no URL
function resolutionClarity(m: Market): 'A' | 'B' | 'C' {
  const hasUrl = !!m.source_citation;
  const mech = m.arbitration_model ?? '';
  const objectiveSource = ['gov_stat_agency', 'central_bank', 'regulated_data_vendor', 'scheduled_event'].includes(m.source_type ?? '');
  const deterministic = ['platform_auto', 'kalshi_staff'].includes(mech) && objectiveSource;
  if (deterministic && hasUrl) return 'A';
  if (hasUrl) return 'B';
  return 'C';
}

// Venue clarity distribution (e.g., "11A" or "4C")
function venueClarityDistribution(platform: 'kalshi' | 'polymarket'): string {
  const counts: Record<string, number> = { A: 0, B: 0, C: 0 };
  for (const m of marketsByPlatform[platform]) counts[resolutionClarity(m)]++;
  const parts: string[] = [];
  if (counts.A) parts.push(`${counts.A}A`);
  if (counts.B) parts.push(`${counts.B}B`);
  if (counts.C) parts.push(`${counts.C}C`);
  return parts.join(' ');
}

// Strike-ladder detection
function isLadderShape(platform: 'kalshi' | 'polymarket'): boolean {
  const ms = marketsByPlatform[platform];
  if (ms.length < 4) return false;
  const strikes = ms.map(extractStrike).filter((s) => s !== null) as number[];
  return strikes.length >= ms.length * 0.7;
}
const kalshiIsLadder = isLadderShape('kalshi');
const polyIsLadder = isLadderShape('polymarket');

// Detect if a venue table is option-chain shape (all rows have numeric range/threshold labels)
function isOptionChainShape(ms: Market[]): boolean {
  if (ms.length < 3) return false;
  const numericCount = ms.filter((m) => extractMarketLabel(m.question_raw).sortKey !== null).length;
  return numericCount >= ms.length * 0.8;
}

// Sort markets
function sortMarkets(ms: Market[], ladder: boolean): Market[] {
  if (ladder) {
    return [...ms].sort((a, b) => (extractStrike(a) ?? 0) - (extractStrike(b) ?? 0));
  }
  // Option-chain sort: ascending by extracted numeric value when 80%+ of rows have ranges/thresholds
  if (isOptionChainShape(ms)) {
    return [...ms].sort((a, b) => {
      const ka = extractMarketLabel(a.question_raw).sortKey ?? Number.POSITIVE_INFINITY;
      const kb = extractMarketLabel(b.question_raw).sortKey ?? Number.POSITIVE_INFINITY;
      return ka - kb;
    });
  }
  return [...ms].sort((a, b) => {
    const va = latestMarkByMarketId.get(a.market_id)?.volume_total_usd ?? 0;
    const vb = latestMarkByMarketId.get(b.market_id)?.volume_total_usd ?? 0;
    return vb - va;
  });
}

// Top market per venue (for Primary Markets summary table).
// Per schema-working-spec.md "primary_market_id methodology": 24h volume wins,
// cumulative breaks ties when 24h is identical/zero. This reflects current
// positioning activity rather than historical open interest accumulation.
//
// Eligibility filter: only ACTIVE (open) markets with NON-ZERO trading volume
// qualify. Resolved/amended markets and zero-volume markets are excluded —
// "most traded" is a nonsense concept for a contract that isn't being traded.
// If no markets qualify, the Primary Markets section won't render (returns null).
function topMarket(platform: 'kalshi' | 'polymarket') {
  const ms = marketsByPlatform[platform].filter((m) => {
    if (m.status === 'resolved' || m.status === 'amended' || m.status === 'closed') return false;
    const mark = latestMarkByMarketId.get(m.market_id);
    const cum = mark?.volume_total_usd ?? 0;
    const day = mark?.volume_24h_usd ?? 0;
    return cum > 0 || day > 0;
  });
  if (ms.length === 0) return null;
  const sorted = [...ms].sort((a, b) => {
    const va24 = latestMarkByMarketId.get(a.market_id)?.volume_24h_usd ?? 0;
    const vb24 = latestMarkByMarketId.get(b.market_id)?.volume_24h_usd ?? 0;
    if (va24 !== vb24) return vb24 - va24;
    const vaCum = latestMarkByMarketId.get(a.market_id)?.volume_total_usd ?? 0;
    const vbCum = latestMarkByMarketId.get(b.market_id)?.volume_total_usd ?? 0;
    return vbCum - vaCum;
  });
  const m = sorted[0];
  const mark = latestMarkByMarketId.get(m.market_id);
  const price = mark?.implied_probability ?? mark?.yes_last_price ?? mark?.mid;
  let semanticLabel = '';
  if (kalshiIsLadder && m.platform === 'kalshi') {
    const strike = extractStrike(m);
    if (strike !== null) semanticLabel = `${strike.toFixed(2)}% STRIKE`;
  } else {
    semanticLabel = 'TOP OUTCOME';
  }
  return { market: m, mark, price, semanticLabel };
}
const topKalshi = topMarket('kalshi');
const topPoly = topMarket('polymarket');

// Max volume per venue (for magnitude bar normalization)
function maxVolume(platform: 'kalshi' | 'polymarket'): number {
  let max = 0;
  for (const m of marketsByPlatform[platform]) {
    const v = latestMarkByMarketId.get(m.market_id)?.volume_total_usd ?? 0;
    if (v > max) max = v;
  }
  return max;
}
// Max probability per venue (for P(YES) bar normalization — bounded 0-1)
function maxProbability(platform: 'kalshi' | 'polymarket'): number {
  let max = 0;
  for (const m of marketsByPlatform[platform]) {
    const mk = latestMarkByMarketId.get(m.market_id);
    const p = mk?.implied_probability ?? mk?.yes_last_price ?? mk?.mid ?? 0;
    if (p > max) max = p;
  }
  return max;
}
const maxVolKalshi = maxVolume('kalshi');
const maxVolPoly = maxVolume('polymarket');
const maxProbKalshi = maxProbability('kalshi');
const maxProbPoly = maxProbability('polymarket');

// Volume summary
let cumulativeVol = 0;
let dayVol = 0;
for (const m of markets) {
  const mark = latestMarkByMarketId.get(m.market_id);
  cumulativeVol += mark?.volume_total_usd ?? 0;
  dayVol += mark?.volume_24h_usd ?? 0;
}
const earliestResolve = markets
  .map((m) => m.resolve_at ?? m.close_at)
  .filter((d): d is string => !!d)
  .sort()[0] ?? null;
const daysToResolve = earliestResolve
  ? Math.ceil((new Date(earliestResolve).getTime() - new Date(SPECIMEN_GENERATED_AT).getTime()) / (1000 * 60 * 60 * 24))
  : null;

// Resolved-state detection — true only when EVERY market for the event has settled.
// Mixed-state events (some open, some resolved) treated as "still active".
const allMarketsResolved = markets.length > 0 && markets.every(
  (m) => m.status === 'resolved' || m.status === 'amended'
);
let eventResolvedAt: string | null = null;
let eventResolutionOutcome: string | null = null;
if (allMarketsResolved) {
  const dates = markets
    .map((m) => m.resolved_at)
    .filter((d): d is string => !!d)
    .sort();
  eventResolvedAt = dates[dates.length - 1] ?? null;
  // Pick the YES-winning market(s) to derive the event-level outcome label.
  // Multi-outcome events (e.g. Fed rate ladder): the winning contract's question text IS the outcome.
  // Binary events (e.g. Netanyahu out by X): outcome is YES or NO of the single market.
  const winners = markets.filter((m) => m.resolution_value === 1.0 || m.resolution_outcome === 'YES');
  if (winners.length >= 1 && markets.length > 1) {
    // Scan ALL winner questions (multi-venue same-outcome typically has 1 per venue)
    const allWinQ = winners.map((m) => (m.question_raw ?? '').toLowerCase()).join(' || ');
    if (allWinQ.includes('no change') || allWinQ.includes('hold') || allWinQ.includes('unchanged')) eventResolutionOutcome = 'NO CHANGE';
    else if (allWinQ.includes('cut 25') || allWinQ.includes('25 bp cut') || allWinQ.includes('cut by 25')) eventResolutionOutcome = 'CUT 25bp';
    else if (allWinQ.includes('cut 50') || allWinQ.includes('50 bp cut') || allWinQ.includes('cut by 50')) eventResolutionOutcome = 'CUT 50bp';
    else if (allWinQ.includes('hike')) eventResolutionOutcome = 'HIKE';
    else eventResolutionOutcome = 'YES';
  } else if (winners.length >= 1) {
    eventResolutionOutcome = 'YES';
  } else if (markets.some((m) => m.resolution_outcome)) {
    eventResolutionOutcome = 'NO';
  }
}

// Divergence detection — different mechanisms or different sources across venues
const kalshiMechs = new Set(marketsByPlatform.kalshi.map((m) => m.arbitration_model));
const polyMechs = new Set(marketsByPlatform.polymarket.map((m) => m.arbitration_model));
const hasDivergence =
  marketsByPlatform.kalshi.length > 0 &&
  marketsByPlatform.polymarket.length > 0 &&
  ([...kalshiMechs].some((m) => !polyMechs.has(m)) || [...polyMechs].some((m) => !kalshiMechs.has(m)));

// Market structure note — tense flips past when the event has settled
const resolveVerb = allMarketsResolved ? 'Resolved' : 'Resolves';
const resolveDate = allMarketsResolved
  ? (eventResolvedAt ? formatDate(eventResolvedAt) : formatDate(earliestResolve))
  : formatDate(earliestResolve);
let structureNote = '';
if (marketsByPlatform.kalshi.length > 0 && marketsByPlatform.polymarket.length > 0) {
  const kShape = kalshiIsLadder ? `${marketsByPlatform.kalshi.length}-strike ladder` : `${marketsByPlatform.kalshi.length} discrete outcomes`;
  const pShape = polyIsLadder ? `${marketsByPlatform.polymarket.length}-strike ladder` : `${marketsByPlatform.polymarket.length} discrete outcomes`;
  const bothVerb = allMarketsResolved ? 'Both resolved' : 'Both resolve';
  structureNote = `Kalshi structures this event as a ${kShape}. Polymarket structures this event as ${pShape}. ${bothVerb} ${resolveDate}.`;
} else if (marketsByPlatform.kalshi.length > 0) {
  structureNote = `Kalshi-only event. ${marketsByPlatform.kalshi.length} ${kalshiIsLadder ? 'strike contracts' : 'discrete outcomes'}. ${resolveVerb} ${resolveDate}.`;
} else if (marketsByPlatform.polymarket.length > 0) {
  structureNote = `Polymarket-only event. ${marketsByPlatform.polymarket.length} ${polyIsLadder ? 'strike contracts' : 'discrete outcomes'}. ${resolveVerb} ${resolveDate}.`;
}

// Grouped resolution sources for the Resolution Architecture table
type GroupedSource = {
  platform: 'kalshi' | 'polymarket';
  source_name: string | null;
  source_url: string | null;
  source_type: string | null;
  regulatory_class: string | null;
  analyst_notes: string | null;
  market_count: number;
};
const groupedSources: GroupedSource[] = [];
for (const platform of ['kalshi', 'polymarket'] as const) {
  const map = new Map<string, GroupedSource>();
  for (const m of marketsByPlatform[platform]) {
    const key = `${m.resolution_source ?? ''}|${m.source_citation ?? ''}|${m.source_type ?? ''}`;
    const existing = map.get(key);
    if (existing) existing.market_count += 1;
    else map.set(key, {
      platform,
      source_name: m.resolution_source,
      source_url: m.source_citation,
      source_type: m.source_type,
      regulatory_class: m.regulatory_class ?? null,
      analyst_notes: m.analyst_notes ?? null,
      market_count: 1,
    });
  }
  groupedSources.push(...map.values());
}

// Signals for this event — match the primary target event_id OR a linked event_id
const allSignals = await getCollection('signals');
const linkedSignals = allSignals
  .filter((s) => s.data.event_id === event.event_id || (s.data.linked_event_ids ?? []).includes(event.event_id))
  .slice(0, 5);

// Site URLs
const canonicalURL = `https://clearmarket.fyi/events/${event.slug}/`;
const jsonURL = `https://api.clearmarket.fyi/v1/events/${event.slug}`;

// JSON-LD Dataset
const datasetJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': canonicalURL,
  name: event.question,
  description: event.editorial_notes ?? `Cross-venue reference data for "${event.question}".`,
  identifier: event.event_id,
  url: canonicalURL,
  keywords: event.tags,
  temporalCoverage: earliestResolve ? `${SPECIMEN_GENERATED_AT}/${earliestResolve}` : SPECIMEN_GENERATED_AT,
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'P(YES)', description: 'Implied probability of YES outcome per market' },
    { '@type': 'PropertyValue', name: 'cumulative_volume_usd', description: 'Lifetime traded volume' },
    { '@type': 'PropertyValue', name: 'resolution_clarity_grade', description: 'A/B/C grade of resolution-source clarity' },
    { '@type': 'PropertyValue', name: 'arbitration_model', description: 'Who arbitrates resolution disputes' },
  ],
  measurementTechnique: 'Cross-venue ingestion of Kalshi + Polymarket public APIs, normalized to canonical 4-table schema with editorial enrichment for resolution-source naming where platforms ship empty fields',
  creator: { '@type': 'Organization', name: 'ClearMarket', url: 'https://clearmarket.fyi' },
  license: 'https://creativecommons.org/licenses/by/4.0/',
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${jsonURL}.json` },
    { '@type': 'DataDownload', encodingFormat: 'text/html', contentUrl: canonicalURL },
  ],
  isPartOf: { '@type': 'DataCatalog', name: 'ClearMarket Events Catalog', url: 'https://clearmarket.fyi/events/' },
};

// Visible JSON record (subset of the canonical record)
const machineRecord = {
  event_id: event.event_id,
  slug: event.slug,
  question: event.question,
  category: event.category,
  tags: event.tags,
  venues_covered: event.venues_covered,
  catalyst_dates: event.catalyst_dates,
  editorial_notes: event.editorial_notes,
  market_count: markets.length,
  cumulative_volume_usd: cumulativeVol,
  resolution_architecture: groupedSources.map((g) => ({
    venue: g.platform,
    source_name: g.source_name,
    source_url: g.source_url,
    market_count: g.market_count,
    rcg_distribution: venueClarityDistribution(g.platform),
  })),
  field_provenance: {
    question: { source: 'clearmarket_editorial' },
    tags: { source: 'clearmarket_editorial', ai_drafted: true },
    catalyst_dates: { source: 'clearmarket_editorial' },
    editorial_notes: { source: 'clearmarket_editorial', ai_drafted: true },
    venues_covered: { source: 'derived' },
  },
};
function colorizeJson(obj: unknown): string {
  return JSON.stringify(obj, null, 2)
    .replace(/("[^"]+")\s*:/g, '<span class="t-key">$1</span>:')
    .replace(/: (".*?")/g, ': <span class="t-str">$1</span>')
    .replace(/: (-?\d+\.?\d*)/g, ': <span class="t-num">$1</span>');
}

// Strike-ladder distribution (build-time patch via patch_ladders.py). For multinomial events
// (Fed rate, CPI, counts) we render the coherent distribution instead of one mislabeled strike.
const ladder = (event as any).event_type === 'LADDER' ? (event as any).ladder_distribution : null;
const ladderBand = ladder && ladder.implied_band
  ? ladder.implied_band.filter((x: any) => x !== null && x !== undefined).join(' – ')
  : null;
---
<Site title={`${event.question} · ClearMarket (v2)`} description={`Cross-venue reference data for "${event.question}". ${event.venues_covered.join(' + ')}.`} canonical={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(datasetJsonLd)} slot="head" />

  <nav class="cm-subnav" aria-label="Event sections" slot="subnav">
    <a href="#markets" data-section="markets" class="cm-subnav-link cm-subnav-active"><span class="cm-active-mark">▎</span>Markets</a>
    <a href="#resolution" data-section="resolution" class="cm-subnav-link"><span class="cm-active-mark">▎</span>Resolution</a>
    {event.catalyst_dates && event.catalyst_dates.length > 0 && <a href="#catalysts" data-section="catalysts" class="cm-subnav-link"><span class="cm-active-mark">▎</span>Catalysts</a>}
    <a href="#signal" data-section="signal" class="cm-subnav-link"><span class="cm-active-mark">▎</span>Signal</a>
    <a href="#api" data-section="api" class="cm-subnav-link"><span class="cm-active-mark">▎</span>API</a>
    <span class="cm-subnav-snapshot">snapshot <span class={allMarketsResolved ? 'cm-dot-settled' : 'cm-dot-positive'}>●</span> {formatSnapshot(allMarketsResolved && eventResolvedAt ? eventResolvedAt : SPECIMEN_GENERATED_AT)}{allMarketsResolved ? ' (final)' : ''}</span>
  </nav>

  <article class="cm-v2" data-cm-event-id={event.event_id} data-cm-slug={event.slug}>

    {/* ===== HEADER: divergence chip above H1 (flush via negative margin),
         resolves inline at end of H1 in same font + size ===== */}
    {/* Above-H1 badge is reserved for warnings (divergence). State indicators
        like "resolved" are temporal qualifiers and live inline with the H1 only —
        cuts duplication without losing the resolved-state signal. */}
    {hasDivergence && (
      <div class="cm-headline-meta">
        <span class="cm-divergence-flag" data-cm-field="resolution_divergence">△ resolution-source divergence</span>
      </div>
    )}
    <h1 class="cm-h1" data-cm-field="question">{event.question}{allMarketsResolved ? (
      <span class="cm-h1-resolved" data-cm-field="resolved_at">  [ resolved {eventResolvedAt ? formatDate(eventResolvedAt) : '—'} ]</span>
    ) : (
      <span class="cm-h1-resolves" data-cm-field="resolve_at">  [ resolves: {formatDate(earliestResolve)}{daysToResolve !== null && daysToResolve >= 0 && ` (${daysToResolve}D)`} ]</span>
    )}</h1>

    {/* ===== META HORIZON STRIP — 28px low-contrast tracking layer, no card frame =====
         Bloomberg/Eikon pattern: labels lowercase + muted, values uppercase + mono.
         Middle-dot separators inside clusters; clusters separated by vertical hairlines.
         No card boundary — ambient context, not a competing surface. ===== */}
    <div class="cm-horizon">
      <span class="cm-horizon-token">
        <span class="cm-horizon-label">event:</span>
        <span class="cm-horizon-value" data-cm-field="event_id">{event.event_id}</span>
      </span>
      <span class="cm-horizon-pipe">|</span>
      <span class="cm-horizon-token">
        <span class="cm-horizon-label">type:</span>
        <span class="cm-horizon-value" data-cm-field="category">{event.category}</span>
      </span>
      <span class="cm-horizon-pipe">|</span>
      <span class="cm-horizon-token">
        <span class="cm-horizon-label">venues:</span>
        <span class="cm-horizon-value" data-cm-field="venues_covered">{event.venues_covered.join(', ')}</span>
      </span>
      <span class="cm-horizon-pipe">|</span>
      <span class="cm-horizon-token">
        <span class="cm-horizon-label">markets:</span>
        <span class="cm-horizon-value" data-cm-field="market_count">{markets.length}</span>
      </span>
      <span class="cm-horizon-pipe">|</span>
      <span class="cm-horizon-token">
        <span class="cm-horizon-label">cum vol:</span>
        <span class="cm-horizon-value" data-cm-field="volume_total_usd">{formatVol(cumulativeVol)}</span>
      </span>
      <span class="cm-horizon-pipe">|</span>
      <span class="cm-horizon-token">
        <span class="cm-horizon-label">{allMarketsResolved ? 'final:' : '24h vol:'}</span>
        <span class="cm-horizon-value" data-cm-field="volume_24h_usd">{allMarketsResolved ? 'settled' : formatVol(dayVol)}</span>
      </span>
    </div>

    {/* ===== LADDER DISTRIBUTION — multinomial strike events (Fed rate, CPI, counts).
         Renders the full market-implied distribution + band instead of one strike. ===== */}
    {ladder && (
      <section class="cm-ladder" data-cm-field="ladder_distribution">
        <div class="cm-ladder-h">market-implied distribution
          {ladderBand && <span class="cm-ladder-band"> · implied {ladderBand}</span>}
        </div>
        <table class="cm-ladder-table">
          <tbody>
            {ladder.strikes.map((s: any) => (
              <tr class="cm-ladder-row">
                <td class="cm-ladder-strike">{ladder.direction} {s.threshold}</td>
                <td class="cm-ladder-barcell"><span class="cm-ladder-bar" style={`width:${Math.max(2, s.prob)}%`}></span></td>
                <td class="cm-ladder-prob">{s.prob}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    {/* ===== OUTCOME STRIP — resolved-state only. Plain-language answer to the
         event question, sits between meta strip and Editorial Brief. Carries
         the "what happened" load that the H1 chip can't communicate in 1-2
         tokens for multi-outcome events. ===== */}
    {allMarketsResolved && event.resolution_headline && (
      <div class="cm-outcome-strip" data-cm-field="resolution_headline">
        <span class="cm-outcome-label">outcome</span>
        <span class="cm-outcome-arrow">▸</span>
        <span class="cm-outcome-text">{event.resolution_headline}</span>
      </div>
    )}

    {/* ===== EDITORIAL CALLOUT — full-width Marconi-shape bullets ===== */}
    {event.editorial_notes && (
      <section class="cm-editorial-callout" data-cm-field="editorial_notes" data-cm-provenance="clearmarket_editorial">
        <div class="cm-callout-label">editorial brief <span class="cm-callout-tag">| intel</span></div>
        <ul class="cm-editorial-bullets">
          {event.editorial_notes
            .split(/(?<=\.)\s+/)
            .map((s) => s.trim())
            .filter((s) => s.length > 0)
            .map((sentence) => <li>{sentence}</li>)}
        </ul>
      </section>
    )}

    {/* ===== PRIMARY MARKETS: compact 2-row summary table (replaces card hero) ===== */}
    {(topKalshi || topPoly) && (
      <section id="markets" class="cm-section">
        <div class="cm-section-h">most traded · 24h</div>
        <div class="cm-table-wrap">
          <table class="cm-primary-table">
            <colgroup>
              <col style="width: 12%" />
              <col style="width: 8%" />
              <col style="width: 40%" />
              <col style="width: 11%" />
              <col style="width: 13%" />
              <col style="width: 16%" />
            </colgroup>
            <thead>
              <tr>
                <th scope="col">venue</th>
                <th scope="col" class="cm-th-num">P(YES)</th>
                <th scope="col">top contract</th>
                <th scope="col" class="cm-th-num">vol (24h)</th>
                <th scope="col" class="cm-th-num">vol (cum)</th>
                <th scope="col">venue id</th>
              </tr>
            </thead>
            <tbody>
              {topKalshi && (
                <tr data-cm-venue="kalshi">
                  <td class="cm-td-venue">kalshi</td>
                  <td class="cm-td-num cm-td-p-emphasis" data-cm-field="implied_probability">{formatPrice(topKalshi.price)}</td>
                  <td class="cm-td-top-contract">
                    <span class="cm-q-text" data-cm-field="question_raw">{topKalshi.market.question_raw ?? '—'}</span>
                  </td>
                  <td class="cm-td-num" data-cm-field="volume_24h_usd">{formatVol(topKalshi.mark?.volume_24h_usd)}</td>
                  <td class="cm-td-num" data-cm-field="volume_total_usd">{formatVol(topKalshi.mark?.volume_total_usd)}</td>
                  <td class="cm-td-id" data-cm-field="platform_market_id">
                    <code class="cm-mono-id cm-copy" data-copy={topKalshi.market.platform_market_id} data-venue-url={venueMarketUrl(topKalshi.market) ?? ''} aria-label={`${topKalshi.market.platform_market_id} — click to copy, shift-click to open on venue`}>{truncateVenueId(topKalshi.market.platform_market_id).display}</code>
                  </td>
                </tr>
              )}
              {topPoly && (
                <tr data-cm-venue="polymarket">
                  <td class="cm-td-venue">polymarket</td>
                  <td class="cm-td-num cm-td-p-emphasis" data-cm-field="implied_probability">{formatPrice(topPoly.price)}</td>
                  <td class="cm-td-top-contract">
                    <span class="cm-q-text" data-cm-field="question_raw">{topPoly.market.question_raw ?? '—'}</span>
                  </td>
                  <td class="cm-td-num" data-cm-field="volume_24h_usd">{formatVol(topPoly.mark?.volume_24h_usd)}</td>
                  <td class="cm-td-num" data-cm-field="volume_total_usd">{formatVol(topPoly.mark?.volume_total_usd)}</td>
                  <td class="cm-td-id" data-cm-field="platform_market_id">
                    <code class="cm-mono-id cm-copy" data-copy={topPoly.market.platform_market_id} data-venue-url={venueMarketUrl(topPoly.market) ?? ''} aria-label={`${topPoly.market.platform_market_id} — click to copy, shift-click to open on venue`}>{truncateVenueId(topPoly.market.platform_market_id).display}</code>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {/* ===== ALL MARKETS: venue-grouped, with magnitude bars ===== */}
    <section class="cm-section">
      <div class="cm-section-h">all markets · venue-grouped</div>
      {structureNote && <p class="cm-section-summary">{structureNote}</p>}

      {(['kalshi', 'polymarket'] as const).filter((p) => marketsByPlatform[p].length > 0).map((platform) => {
        const isLadder = platform === 'kalshi' ? kalshiIsLadder : polyIsLadder;
        const isOptionChain = !isLadder && isOptionChainShape(marketsByPlatform[platform]);
        const platformMarkets = sortMarkets(marketsByPlatform[platform], isLadder);
        const sortLabel = isLadder
          ? 'sorted by strike ascending'
          : (isOptionChain ? 'sorted by strike ascending' : 'sorted by cumulative volume');
        const maxVol = platform === 'kalshi' ? maxVolKalshi : maxVolPoly;
        const maxProb = platform === 'kalshi' ? maxProbKalshi : maxProbPoly;
        const showBars = platformMarkets.length >= 3 && maxVol > 0;
        return (
          <div class="cm-venue-block" data-cm-venue={platform}>
            <div class="cm-venue-block-head">
              <span class="cm-venue-block-name">{platform}</span>
              <span class="cm-venue-block-count">{platformMarkets.length} {isLadder ? 'strike contracts' : (platformMarkets.length === 1 ? 'outcome' : 'discrete outcomes')} · {sortLabel}</span>
            </div>
            <div class="cm-venue-block-axis" data-cm-field="event_axis">
              <span class="cm-venue-block-axis-q">{event.question}</span>
            </div>
            <div class="cm-table-wrap">
              <table class={`cm-mkt-table ${isLadder ? 'cm-mkt-table-ladder' : 'cm-mkt-table-discrete'}`}>
                <colgroup>
                  {/* Unified column widths across ladder + discrete tables for cross-venue alignment.
                      Strike values (Kalshi) get whitespace; Polymarket question text uses line-clamp. */}
                  {[22, 7, 7, 9, 10, 7, 8, 8, 7, 15].map((w) => <col style={`width: ${w}%`} />)}
                </colgroup>
                <thead>
                  <tr>
                    <th scope="col" class={`${isLadder ? 'cm-th-strike' : 'cm-th-q'} cm-th-reset`} data-sort-reset title="Click to reset to default sort">market</th>
                    <th scope="col" class="cm-th-num cm-th-sortable" data-sort-key="implied_probability">P(YES)<span class="cm-sort-icon" aria-hidden="true"></span></th>
                    <th scope="col" class="cm-th-bar" aria-label="P(YES) distribution"></th>
                    <th scope="col" class="cm-th-num cm-th-sortable" data-sort-key="volume_24h_usd">vol (24h)<span class="cm-sort-icon" aria-hidden="true"></span></th>
                    <th scope="col" class="cm-th-num cm-th-sortable" data-sort-key="volume_total_usd">vol (cum)<span class="cm-sort-icon" aria-hidden="true"></span></th>
                    <th scope="col" class="cm-th-bar" aria-label="cumulative volume distribution"></th>
                    <th scope="col" class="cm-th-num cm-th-sortable" data-sort-key="yes_spread">yes spread<span class="cm-sort-icon" aria-hidden="true"></span></th>
                    <th scope="col" class="cm-th-num cm-th-sortable" data-sort-key="no_spread">no spread<span class="cm-sort-icon" aria-hidden="true"></span></th>
                    <th scope="col" class="cm-th-rcg cm-th-sortable" data-sort-key="resolution_clarity">RCG<span class="cm-sort-icon" aria-hidden="true"></span></th>
                    <th scope="col" class="cm-th-id">venue id</th>
                  </tr>
                </thead>
                <tbody>
                  {platformMarkets.map((m, rowIdx) => {
                    const mark = latestMarkByMarketId.get(m.market_id);
                    const price = mark?.implied_probability ?? mark?.yes_last_price ?? mark?.mid;
                    const volRaw = mark?.volume_total_usd;
                    const vol24h = mark?.volume_24h_usd;
                    const volForBar = volRaw ?? 0;
                    const volBarPct = showBars && maxVol > 0 ? Math.min(100, Math.sqrt(volForBar / maxVol) * 100) : 0;
                    const probForBar = price ?? 0;
                    const probBarPct = showBars && maxProb > 0 ? Math.min(100, (probForBar / maxProb) * 100) : 0;
                    const rowResolved = m.status === 'resolved' || m.status === 'amended';
                    const strike = extractStrike(m);
                    const labelInfo = extractMarketLabel(m.question_raw);
                    const tid = truncateVenueId(m.platform_market_id);
                    const clarity = resolutionClarity(m);
                    const yesSpread = (mark?.yes_bid != null && mark?.yes_ask != null) ? (mark.yes_ask - mark.yes_bid) * 100 : null;
                    const noSpread = (mark?.no_bid != null && mark?.no_ask != null) ? (mark.no_ask - mark.no_bid) * 100 : null;
                    const rcgRank = clarity === 'A' ? 1 : clarity === 'B' ? 2 : 3;
                    return (
                      <tr data-original-index={rowIdx}>
                        {isLadder
                          ? <td class="cm-td-strike" data-cm-field="strike"><span class="cm-td-label-text">{strike !== null ? `${strike.toFixed(2)}%` : '—'}</span>{rowResolved && <span class="cm-row-resolved" data-cm-field="status">resolved</span>}</td>
                          : <td class={labelInfo.type === 'fulltext' ? 'cm-td-q' : 'cm-td-q cm-td-q-range'} data-cm-field="question_raw" data-cm-label-type={labelInfo.type} title={m.question_raw ?? undefined}><span class="cm-td-label-text">{labelInfo.label}</span>{rowResolved && <span class="cm-row-resolved" data-cm-field="status">resolved</span>}</td>}
                        <td class="cm-td-num cm-td-p" data-cm-field="implied_probability" data-sort-value={price ?? ''}><span class="cm-num">{formatPrice(price)}</span></td>
                        <td class="cm-td-bar" data-cm-field="implied_probability_bar">
                          {showBars && price !== null && price !== undefined && (
                            <div class="cm-bar-track">
                              <div class="cm-bar-fill cm-bar-prob" style={`width:${probBarPct}%`}></div>
                            </div>
                          )}
                        </td>
                        <td class="cm-td-num" data-cm-field="volume_24h_usd" data-sort-value={vol24h ?? ''}><span class="cm-num">{formatVol(vol24h)}</span></td>
                        <td class="cm-td-num" data-cm-field="volume_total_usd" data-sort-value={volRaw ?? ''}><span class="cm-num">{formatVol(volRaw)}</span></td>
                        <td class="cm-td-bar" data-cm-field="volume_total_usd_bar">
                          {showBars && volRaw !== null && volRaw !== undefined && (
                            <div class="cm-bar-track">
                              <div class="cm-bar-fill cm-bar-vol" style={`width:${volBarPct}%`}></div>
                            </div>
                          )}
                        </td>
                        <td class="cm-td-num" data-cm-field="yes_spread" data-sort-value={yesSpread ?? ''}><span class="cm-num">{rowResolved ? '—' : spreadCents(mark?.yes_bid, mark?.yes_ask)}</span></td>
                        <td class="cm-td-num" data-cm-field="no_spread" data-sort-value={noSpread ?? ''}><span class="cm-num">{rowResolved ? '—' : spreadCents(mark?.no_bid, mark?.no_ask)}</span></td>
                        <td class="cm-td-rcg" data-cm-field="resolution_clarity" data-sort-value={rcgRank}><a href="#resolution" class={`cm-rcg-chip cm-rcg-${clarity.toLowerCase()} cm-tt`} data-tt={`${RCG_TOOLTIPS[clarity]} Click to see source.`} aria-label={`${RCG_TOOLTIPS[clarity]} Click to see source.`}>{clarity}</a></td>
                        <td class="cm-td-id" data-cm-field="platform_market_id"><code class="cm-mono-id cm-copy" data-copy={tid.full} data-venue-url={venueMarketUrl(m) ?? ''} aria-label={`${tid.full} — click to copy, shift-click to open on venue`}>{tid.display}</code></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        );
      })}
    </section>

    {/* ===== RESOLUTION ARCHITECTURE: full-width ===== */}
    <section id="resolution" class="cm-section">
      <div class="cm-section-h">resolution architecture</div>
      <table class="cm-res-table">
        <thead>
          <tr>
            <th scope="col">venue</th>
            <th scope="col" class="cm-tt cm-th-help" data-tt="Who proposes the resolution answer. platform_staff: exchange employees. managed_whitelist: approved oracle proposers.">resolution proposer</th>
            <th scope="col" class="cm-tt cm-th-help" data-tt="The platform's verbatim resolution source string (in quotes).">resolution source</th>
            <th scope="col">citation</th>
            <th scope="col" class="cm-tt cm-th-help" data-tt="Objectivity classification of the source. gov_stat_agency / central_bank / regulated_data_vendor: hard reference. media_consensus / subjective: judgment required.">source type</th>
            <th scope="col" class="cm-tt cm-th-help" data-tt="Dispute-resolution path. kalshi_staff: internal review with CFTC backstop. uma_oracle: on-chain token-holder vote. platform_auto: no dispute mechanism.">arbitration</th>
            <th scope="col" class="cm-tt cm-th-help" data-tt="Regulatory class. DCM: CFTC-regulated Designated Contract Market. DeFi: token-vote-arbitrated decentralized protocol.">class</th>
            <th scope="col" class="cm-tt cm-th-help" data-tt="Operational notes — edge cases, dispute risks, time cutoffs. Auto-populated from resolution_triggers when available; otherwise a per-venue fallback.">analyst notes</th>
          </tr>
        </thead>
        <tbody>
          {(['kalshi', 'polymarket'] as const).filter((p) => marketsByPlatform[p].length > 0).map((platform) => {
            const venueMarkets = marketsByPlatform[platform];
            const mech = venueMarkets[0]?.arbitration_model;
            const prop = venueMarkets[0]?.resolution_proposer;
            const venueClassRaw = venueMarkets[0]?.regulatory_class ?? 'Other';
            const venueGroupedSources = groupedSources.filter((g) => g.platform === platform);
            return venueGroupedSources.length > 0
              ? venueGroupedSources.map((g, idx) => (
                  <tr data-cm-venue={platform}>
                    <td class="cm-res-td-venue" data-cm-field="platform">{idx === 0 ? platform : ''}</td>
                    <td data-cm-field="resolution_proposer">{idx === 0 && prop ? <code class="cm-code-pill">{prop}</code> : '—'}</td>
                    <td class="cm-res-td-src" data-cm-field="resolution_source">{g.source_name ? <span class="cm-verbatim">“{g.source_name}”</span> : <span class="cm-dd-empty">no specific source</span>}</td>
                    <td data-cm-field="source_citation">{g.source_url ? <a href={g.source_url} rel="noopener nofollow">link</a> : <span class="cm-dd-empty">—</span>}</td>
                    <td data-cm-field="source_type">{g.source_type ? <code class="cm-code-pill">{g.source_type}</code> : <span class="cm-dd-empty">—</span>}</td>
                    <td data-cm-field="arbitration_model">{idx === 0 && mech ? <code class="cm-code-pill">{mech}</code> : '—'}</td>
                    <td data-cm-field="regulatory_class">{idx === 0 ? <code class={`cm-class-chip cm-class-${venueClassRaw.toLowerCase()}`}>{venueClassRaw}</code> : ''}</td>
                    <td class="cm-res-td-notes" data-cm-field="analyst_notes">{g.analyst_notes ?? <span class="cm-dd-empty">—</span>}</td>
                  </tr>
                ))
              : (
                <tr>
                  <td class="cm-res-td-venue">{platform}</td>
                  <td>{prop ? <code class="cm-code-pill">{prop}</code> : '—'}</td>
                  <td><span class="cm-dd-empty">no specific source</span></td>
                  <td><span class="cm-dd-empty">—</span></td>
                  <td><span class="cm-dd-empty">—</span></td>
                  <td>{mech ? <code class="cm-code-pill">{mech}</code> : '—'}</td>
                  <td><code class={`cm-class-chip cm-class-${venueClassRaw.toLowerCase()}`}>{venueClassRaw}</code></td>
                  <td class="cm-res-td-notes">{venueMarkets[0]?.analyst_notes ?? <span class="cm-dd-empty">—</span>}</td>
                </tr>
              );
          })}
        </tbody>
      </table>

      {/* Resolution rules verbatim — ONE block per venue. Most events use a templated rules
          string with per-market variables (price ranges, dates) — showing 27 near-identical
          blocks would be unreadable. Reader gets the canonical language; per-market specifics
          are in the JSON record. */}
      <div class="cm-res-rules">
        <div class="cm-res-rules-h">resolution rules · verbatim</div>
        {(['kalshi', 'polymarket'] as const).filter((p) => marketsByPlatform[p].length > 0).map((platform) => {
          const venueMarkets = marketsByPlatform[platform];
          const firstMarket = venueMarkets[0];
          const rulesText = firstMarket?.resolution_rules_raw ?? null;
          const allShareSame = venueMarkets.every((m) => m.resolution_rules_raw === rulesText);
          const countLabel = venueMarkets.length === 1
            ? '1 market'
            : allShareSame
              ? `all ${venueMarkets.length} markets share this text`
              : `representative — ${venueMarkets.length} markets, language varies per market (see API record for full per-market text)`;
          // Right-pane real metadata (no invented values)
          const settleCurrency = firstMarket?.settlement_currency ?? null;
          const tickSize = firstMarket?.tick_size ?? null;
          const underlyingRef = firstMarket?.underlying_reference ?? null;
          const termsUrl = firstMarket?.contract_terms_url ?? null;
          return (
            <div class="cm-res-rules-block" data-cm-venue={platform}>
              <div class="cm-res-rules-venue">
                <span class="cm-res-rules-venue-name">{platform}</span>
                <span class="cm-res-rules-venue-count">{countLabel}</span>
              </div>
              <div class="cm-res-rules-ribbon">
                <div class="cm-res-rules-ribbon-cell"><span class="cm-res-rules-ribbon-k">markets</span><span class="cm-res-rules-ribbon-v">{venueMarkets.length}</span></div>
                {settleCurrency && (
                  <div class="cm-res-rules-ribbon-cell"><span class="cm-res-rules-ribbon-k">currency</span><span class="cm-res-rules-ribbon-v">{settleCurrency}</span></div>
                )}
                {tickSize !== null && tickSize !== undefined && (
                  <div class="cm-res-rules-ribbon-cell"><span class="cm-res-rules-ribbon-k">tick size</span><span class="cm-res-rules-ribbon-v">${tickSize}</span></div>
                )}
                {termsUrl && (
                  <div class="cm-res-rules-ribbon-cell"><span class="cm-res-rules-ribbon-k">rulebook</span><a href={termsUrl} rel="noopener nofollow" class="cm-res-rules-ribbon-link">link</a></div>
                )}
              </div>
              {underlyingRef && (
                <div class="cm-res-rules-underlying" data-cm-field="underlying_reference">
                  <span class="cm-res-rules-underlying-k">underlying ref</span>
                  <span class="cm-res-rules-underlying-v">{underlyingRef}</span>
