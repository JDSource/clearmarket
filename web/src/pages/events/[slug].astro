            <div>TYPE</div>
          </div>
          {event.catalyst_dates.map((c) => {
            const dt = new Date(c.date);
            const refIso = allMarketsResolved && eventResolvedAt ? eventResolvedAt : SPECIMEN_GENERATED_AT;
            const ref = new Date(refIso);
            const dDays = Math.ceil((dt.getTime() - ref.getTime()) / (1000 * 60 * 60 * 24));
            const delta = catalystDelta(dDays);
            const csource = c.source_url ?? null;
            const cverified = c.verified_at ?? null;
            const ctype = c.type ?? null;
            const sourceHost = csource ? csource.replace(/^https?:\/\/(www\.)?/, '').split('/')[0] : null;
            // Display-friendly type label — canonical uppercase, drop underscores. No TS generic syntax.
            // Canonical 11-type enum per CM PRD §5.5
            const typeLabelMap = {
              fomc: 'FOMC',
              cpi: 'CPI',
              jobs: 'JOBS',
              gdp: 'GDP',
              treasury_auction: 'TREASURY',
              scotus: 'SCOTUS',
              us_election: 'US ELECTION',
              corporate_earnings: 'EARNINGS',
              fda_action: 'FDA',
              one_off: 'ONE OFF',
              evolving: 'EVOLVING',
              none: 'NONE',
            } as const;
            const ctypeLabel = ctype ? ((typeLabelMap as any)[ctype] ?? ctype.replace(/_/g, ' ').toUpperCase()) : null;
            const isPast = dDays < 0;
            return (
              <div class={`cm-catalyst-grid-row${isPast ? ' cm-catalyst-past' : ''}`}>
                <div class="cm-catalyst-dte">[{delta.replace('in ', '+').replace(' ago', '').replace(/(\d+)d\b/g, '$1D').toUpperCase()}]</div>
