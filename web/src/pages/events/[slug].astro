    {/* Client-side: venue ID copy-on-click + shift-click to open venue */}
    <script is:inline>
      document.querySelectorAll('.cm-copy').forEach((el) => {
        el.addEventListener('click', async (ev) => {
          const target = ev.currentTarget;
          const text = target.dataset.copy || target.textContent || '';
          const venueUrl = target.dataset.venueUrl || '';
          if (ev.shiftKey && venueUrl) {
            window.open(venueUrl, '_blank', 'noopener,noreferrer');
            return;
          }
          try {
            await navigator.clipboard.writeText(text);
            target.classList.add('cm-copied');
            setTimeout(() => target.classList.remove('cm-copied'), 1200);
          } catch (_) { /* clipboard API blocked — silently noop */ }
        });
      });
    </script>

    {/* Client-side: column sort. Click a sortable header to sort ascending; click again for descending.
        Click the MARKET column header to reset to editorial default sort. */}
    <script is:inline>
      document.querySelectorAll('.cm-mkt-table').forEach((table) => {
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const sortableThs = table.querySelectorAll('th.cm-th-sortable');
        const resetTh = table.querySelector('th.cm-th-reset');

        const sortBy = (key, dir) => {
          const rows = Array.from(tbody.querySelectorAll('tr'));
          rows.sort((a, b) => {
            const aCell = a.querySelector('td[data-cm-field="' + key + '"]');
            const bCell = b.querySelector('td[data-cm-field="' + key + '"]');
            const aRaw = aCell ? aCell.getAttribute('data-sort-value') : '';
            const bRaw = bCell ? bCell.getAttribute('data-sort-value') : '';
            const aNum = aRaw === '' || aRaw === null ? NaN : parseFloat(aRaw);
            const bNum = bRaw === '' || bRaw === null ? NaN : parseFloat(bRaw);
            // Nulls always sort to the bottom regardless of direction
            if (isNaN(aNum) && isNaN(bNum)) return 0;
            if (isNaN(aNum)) return 1;
            if (isNaN(bNum)) return -1;
            return dir === 'asc' ? aNum - bNum : bNum - aNum;
          });
          rows.forEach((r) => tbody.appendChild(r));
        };

        sortableThs.forEach((th) => {
          th.addEventListener('click', () => {
            const key = th.getAttribute('data-sort-key');
            const current = th.getAttribute('data-sort-active');
            const nextDir = current === 'asc' ? 'desc' : 'asc';
            sortableThs.forEach((t) => t.removeAttribute('data-sort-active'));
            th.setAttribute('data-sort-active', nextDir);
            sortBy(key, nextDir);
          });
        });

        if (resetTh) {
          resetTh.addEventListener('click', () => {
            sortableThs.forEach((t) => t.removeAttribute('data-sort-active'));
            const rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort((a, b) => {
              const aIdx = parseInt(a.getAttribute('data-original-index') || '0', 10);
              const bIdx = parseInt(b.getAttribute('data-original-index') || '0', 10);
              return aIdx - bIdx;
            });
            rows.forEach((r) => tbody.appendChild(r));
          });
        }
      });
    </script>

    {/* Client-side: scroll-driven active section in sub-nav.
        IntersectionObserver tracks which section is in view; toggles .cm-subnav-active accordingly.
        The accent mark ▎ animates in/out via CSS opacity transition. */}
    <script is:inline>
      (function() {
        var subnavLinks = document.querySelectorAll('.cm-subnav-link');
        if (subnavLinks.length === 0) return;
        var sectionMap = {};
        subnavLinks.forEach(function(link) {
          var sectionId = link.getAttribute('data-section');
          var section = document.getElementById(sectionId);
          if (section) sectionMap[sectionId] = link;
        });
        var activate = function(sectionId) {
          subnavLinks.forEach(function(l) { l.classList.remove('cm-subnav-active'); });
          if (sectionMap[sectionId]) sectionMap[sectionId].classList.add('cm-subnav-active');
        };
        var observer = new IntersectionObserver(function(entries) {
          // Pick the section whose top is closest to (just below) the sticky chrome line
          var visible = entries.filter(function(e) { return e.isIntersecting; });
          if (visible.length === 0) return;
          // Use the topmost intersecting entry as the active section
          visible.sort(function(a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
          var topEntry = visible[0];
          activate(topEntry.target.id);
        }, {
          // Trigger when section enters the area below the sticky chrome (~120px)
          rootMargin: '-120px 0px -60% 0px',
          threshold: 0,
        });
        Object.keys(sectionMap).forEach(function(id) {
          var section = document.getElementById(id);
          if (section) observer.observe(section);
        });
      })();
    </script>

