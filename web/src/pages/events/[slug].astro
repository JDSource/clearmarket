---
/* Canonical event page — THE locked design, served for every event.
 * Built on the shared component set (same as /priced and /compare so it can never drift):
 *   header → verbatim question line → ResolutionStrip → MarketsTable → VerbatimRules →
 *   WireItems → ProgrammaticAccess → footer.
 * Markets are grouped by venue (single-venue ladder → one block; cross-venue → one block per
 * venue), each sorted by resolution date then P(YES). No heavy meta-horizon strip, no inline
 * editorial-brief block — those were the pre-lock design. Full 7-factor methodology lives at
 * /methodology + in the JSON record.
 */
import Site from '../../layouts/Site.astro';
import '../../styles/tokens.css';
import '../../styles/cm-event.css';
import ResolutionStrip from '../../components/ResolutionStrip.astro';
import MarketsTable from '../../components/MarketsTable.astro';
import VerbatimRules from '../../components/VerbatimRules.astro';
import WireItems from '../../components/WireItems.astro';
import ProgrammaticAccess from '../../components/ProgrammaticAccess.astro';
import { eventDisplayQuestion } from '../../lib/labels';
import {
  getAllEvents, getEventBySlug, getMarketsForEvent, getMarkByMarketId, getResolutionLogForEvent,
  SPECIMEN_GENERATED_AT, SCHEMA_VERSION, type Event, type Market,
} from '../../lib/universe';

export async function getStaticPaths() {
  return getAllEvents().map((event) => ({ params: { slug: event.slug }, props: { event } }));
}
const { event } = Astro.props as { event: Event };
const markets = getMarketsForEvent(event.event_id);
const resolutionLog = getResolutionLogForEvent(event.event_id);

// Display title: substitute the real strike range for the "___" placeholder that a handful of
// grouped (ladder/option-chain) events carry in their Polymarket template question. Raw
// event.question is untouched in the JSON record; this is the human-facing render only.
const displayQuestion = eventDisplayQuestion(event.question, markets);

function fmtDate(d: string | null | undefined): string { return d ? d.slice(0, 10) : '—'; }

// Group markets by venue, stable order (kalshi, polymarket, then anything else). Within a venue:
// sort by resolution date (the ladder/series axis) then by P(YES) for same-date binaries.
const withP = markets.map((m) => ({ m, mark: getMarkByMarketId(m.market_id) }));
const VENUE_ORDER = ['kalshi', 'polymarket'];
const platforms = [...new Set(markets.map((m) => m.platform))].sort((a, b) => {
  const ia = VENUE_ORDER.indexOf(a), ib = VENUE_ORDER.indexOf(b);
  return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
});
const marketGroups = platforms
  .map((platform) => ({
    venue: platform,
    items: withP
      .filter((it) => it.m.platform === platform)
      .sort((a, b) => {
        const ra = a.m.resolve_at ?? '', rb = b.m.resolve_at ?? '';
        if (ra && rb && ra !== rb) return ra.localeCompare(rb);
        // strike ladder → order by strike (threshold) ascending so it reads as a distribution
        const ta = (a.m as any).threshold, tb = (b.m as any).threshold;
        if (ta != null && tb != null && Number(ta) !== Number(tb)) return Number(ta) - Number(tb);
        return (b.mark?.implied_probability ?? b.m.last_price ?? 0) - (a.mark?.implied_probability ?? a.m.last_price ?? 0);
      }),
  }))
  .filter((g) => g.items.length);

// resolves label on the H1
const resolveDates = [...new Set(markets.map((m) => (m.resolve_at ?? m.close_at ?? '').slice(0, 10)).filter(Boolean))].sort();
const earliest = resolveDates[0] ?? null;
const latest = resolveDates[resolveDates.length - 1] ?? null;
const multiDate = resolveDates.length > 1;
const daysTo = earliest ? Math.ceil((new Date(earliest).getTime() - new Date(SPECIMEN_GENERATED_AT).getTime()) / 86400000) : null;
// Resolved = the LAST leg's resolution date is already in the past (vs the build date / today).
const TODAY_ISO = new Date().toISOString().slice(0, 10);
const isResolved = latest !== null && latest < TODAY_ISO;
const resolveLabel = isResolved
  ? `resolved ${fmtDate(latest)}`
  : multiDate
    ? `resolves ${earliest.slice(0, 7)} – ${latest!.slice(0, 7)}`
    : `resolves ${fmtDate(earliest)}${daysTo !== null && daysTo >= 0 ? ` (${daysTo}D)` : ''}`;

// A strike ladder = many same-date markets distinguished by threshold; its natural axis is the
// strike, not the (uniform) resolution date — so label + ordering reflect that.
const hasThreshold = markets.some((m) => (m as any).threshold != null);
// A threshold is only a real strike if a unit (%/$) is present in the market text. bps-denominated
// Fed-decision rungs carry numeric thresholds with no unit — they're an outcome set, not a ladder.
const ladderUnitful = markets.some((m) => /[%$]/.test(`${m.question_raw ?? ''} ${(m as any).description_raw ?? ''}`));
const isLadder = markets.length > 3 && !multiDate && hasThreshold && ladderUnitful;
// Same resolve date, several markets, no usable strike → a multinomial OUTCOME set (e.g. Fed Hike/Cut
// sizes), not a date series. Label + distinguisher must reflect that, not "by resolution date".
const isOutcomeSet = markets.length > 1 && !multiDate && (!hasThreshold || !ladderUnitful);
const marketsLabel = isLadder
  ? 'distribution · by strike'
  : isOutcomeSet
    ? 'distribution · by outcome'
    : `${markets.length > 3 ? 'distribution' : 'markets'} · by resolution date`;

// plain-language "what's measured" line — PLATFORM-VERBATIM, never our editorial. Suppressed for
// strike ladders: one rung's verbatim question ("...be 3.75%") contradicts the distribution H1
// ("...be ≥ 4.5%") and reads as a mismatch. For binaries it's the rep market's verbatim question.
const repMarket = markets.length > 2
  ? [...markets].sort((a, b) => Math.abs((a.last_price ?? 0.5) - 0.5) - Math.abs((b.last_price ?? 0.5) - 0.5))[0]
  : (markets.find((m) => m.market_id === (event as any).primary_market_id) ?? markets[0]);
const questionLine = (isLadder || isOutcomeSet) ? null : (repMarket?.question_raw ?? event.question);
const canonicalURL = `https://clearmarket.fyi/events/${event.slug}/`;
---
<Site title={`${displayQuestion} · ClearMarket`} description={`Cross-venue reference data for "${displayQuestion}". ${event.venues_covered.join(' + ')}.`} canonical={canonicalURL}>
  <nav class="cm-subnav" aria-label="Sections" slot="subnav">
    <a href="#markets" data-section="markets" class="cm-subnav-link cm-subnav-active"><span class="cm-active-mark">▎</span>Markets</a>
    <a href="#resolution" data-section="resolution" class="cm-subnav-link"><span class="cm-active-mark">▎</span>Resolution</a>
    <a href="#signal" data-section="signal" class="cm-subnav-link"><span class="cm-active-mark">▎</span>Signal</a>
    <a href="#api" data-section="api" class="cm-subnav-link"><span class="cm-active-mark">▎</span>API</a>
    <span class="cm-subnav-snapshot">snapshot <span class="cm-dot-positive">●</span> {fmtDate(SPECIMEN_GENERATED_AT)}</span>
  </nav>

  <article class="cm-v2" data-cm-event-id={event.event_id} data-cm-slug={event.slug}>
    <h1 class="cm-h1" data-cm-field="question">{displayQuestion}<span class={isResolved ? 'cm-h1-resolved' : 'cm-h1-resolves'}>  [ {resolveLabel} ]</span></h1>
    {questionLine && <p class="cm-question-line" data-cm-field="question_raw">{questionLine}</p>}

    {/* BORDERLESS STATUS TICKER — flush under the title */}
    <ResolutionStrip event={event} markets={markets} />

    {/* PRICE LEADS — the one shared markets-table template (per-venue blocks, resolves column) */}
    <MarketsTable groups={marketGroups} sectionLabel={marketsLabel} />

    {/* verbatim rules — the #resolution section */}
    <VerbatimRules event={event} markets={markets} resolutionLog={resolutionLog} />

    <WireItems event={event} />
    <ProgrammaticAccess event={event} markets={markets} />

    <div class="cm-event-foot">
      <span><span class="cm-meta-l">snapshot</span> <code>{SPECIMEN_GENERATED_AT}</code></span>
      <span><span class="cm-meta-l">schema</span> <code>{SCHEMA_VERSION}</code></span>
      <a href="/events/">all events →</a>
    </div>

    <script is:inline>
      // copy contract id on click
      document.querySelectorAll('.cm-copy').forEach((el) => {
        el.addEventListener('click', async (ev) => {
          const t = ev.currentTarget;
          try { await navigator.clipboard.writeText(t.dataset.copy || t.textContent || ''); t.classList.add('cm-copied'); setTimeout(() => t.classList.remove('cm-copied'), 1200); } catch (_) {}
        });
      });
      // (column sort lives in MarketsTable.astro — the shared table component)
      // scroll-spy: move the green accent to the section in view
      (function () {
        const links = Array.from(document.querySelectorAll('.cm-subnav-link'));
        const map = {};
        links.forEach((l) => { const s = document.getElementById(l.getAttribute('data-section')); if (s) map[l.getAttribute('data-section')] = { link: l, sec: s }; });
        const obs = new IntersectionObserver((entries) => {
          const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (!vis.length) return;
          links.forEach((l) => l.classList.remove('cm-subnav-active'));
          const id = vis[0].target.id;
          if (map[id]) map[id].link.classList.add('cm-subnav-active');
        }, { rootMargin: '-120px 0px -65% 0px', threshold: 0 });
        Object.values(map).forEach(({ sec }) => obs.observe(sec));
      })();
    </script>
  </article>
</Site>
