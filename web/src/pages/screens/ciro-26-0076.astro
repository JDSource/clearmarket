---
/* Eligibility screen — CIRO 26-0076 regime page at /screens/ciro-26-0076/
 *
 * Sibling layout to /signals/ and /events/ (terminal ledger: mono, hairline
 * borders, flat geometry, no cards). Header/h1/section tokens replicated from
 * signals/index.astro (local by convention, not in shared CSS).
 *
 * Layout direction (Jeremy review round 2, 2026-06-10): plain-English lede,
 * single-column prospectus (notice box cut), cascade without terminal-status
 * row, then three status sections — eligible / review / not eligible — each
 * with a short plain-English intro and an expander; no-source eligible rows
 * tinted red. Rule mapping stays one-line rows with verbatim behind toggles.
 * All rows stay in the DOM (no lazy-load — crawler and llms.txt completeness).
 *
 * Content rules (locked, eligibility-screens-decision.md):
 *  - statuses are eligible / review / not_eligible — never pass/fail
 *  - regulator language appears ONLY as verbatim quotes with §-refs
 *  - review renders as CLUSTERS (the judgment units) up front
 *  - eligibility ≠ diligence: source/grade columns are evidence, not gates
 *  - disclaimer present (methodology); nothing reads as a compliance opinion
 */
import Site from '../../layouts/Site.astro';
import '../../styles/tokens.css';
import '../../styles/cm-event.css';
import { getAllEvents, getMarketsForEvent } from '../../lib/universe';
import { getScreenSummary, getEligibility, REASON_COPY } from '../../lib/eligibility';
import { eventDisplayQuestion } from '../../lib/labels';

const summary = getScreenSummary();
const canonicalURL = 'https://clearmarket.fyi/screens/ciro-26-0076/';

type Row = {
  market_id: string; venue_id: string; question: string; slug: string; bucket: string; reason: string; cluster: string;
  resolves: string; source: string | null; commitment: string | null; grade: string | null;
};
const eligibleRows: Row[] = [];
const reviewRows: Row[] = [];
const notEligibleReasons: Record<string, number> = {};
if (summary) {
  for (const ev of getAllEvents()) {
    const mkts = getMarketsForEvent(ev.event_id);
    const display = eventDisplayQuestion(ev.question, mkts);
    for (const m of mkts) {
      const rec = getEligibility(m.market_id);
      if (!rec) continue;
      if (rec.status === 'not_eligible') {
        const reason = rec.reasons[0] ?? 'other';
        notEligibleReasons[reason] = (notEligibleReasons[reason] ?? 0) + 1;
        continue;
      }
      const row: Row = {
        market_id: m.market_id,
        venue_id: (m as any).platform_market_id ?? '',
        question: display,
        slug: ev.slug,
        bucket: rec.permitted_category ?? '',
        reason: rec.reasons[0] ?? '',
        cluster: rec.cluster ?? '',
        resolves: (m.resolve_at ?? m.close_at ?? '').slice(0, 10),
        source: m.resolution_source ?? null,
        commitment: rec.source_commitment,
        grade: rec.rcg_grade,
      };
      if (rec.status === 'eligible') eligibleRows.push(row);
      else reviewRows.push(row);
    }
  }
  const bySchedule = (a: Row, b: Row) => a.resolves.localeCompare(b.resolves) || a.question.localeCompare(b.question);
  eligibleRows.sort(bySchedule);
  reviewRows.sort(bySchedule);
}

const f = summary?.funnel;
const fmt = (n: number) => n.toLocaleString('en-US');

// Attrition cascade: first-failure attribution, delta removed at each gate.
const cascadeRows = f
  ? [
      { idx: '1', label: 'IN-SCOPE MARKETS (KALSHI)', n: f.in_scope, delta: null as number | null, note: 'baseline pool' },
      { idx: '2', label: 'PERMITTED CATEGORY (SECTIONS 1, 3)', n: f.candidate_category, delta: f.in_scope - f.candidate_category, note: 'category exclusions' },
      { idx: '3', label: 'TERM TO MATURITY ≥ 30D (SECTION 2)', n: f.min_maturity, delta: f.candidate_category - f.min_maturity, note: 'short-horizon drop' },
      { idx: '4', label: 'APPENDIX A CORE SUBJECT (SECTION 1)', n: f.eligible, delta: f.min_maturity - f.eligible, note: 'interpretation calls → review' },
    ]
  : [];

// Eligible ledger groups (bucket = the screen's own taxonomy).
const bucketMeta: Record<string, { tag: string; name: string }> = {
  economic_forecasts: { tag: 'ECONOMIC_FORECASTS', name: 'econ' },
  financial_indicators: { tag: 'FINANCIAL_INDICATORS', name: 'fin' },
  environment_forecasts: { tag: 'ENVIRONMENT_FORECASTS', name: 'env' },
};
const bucketOrder = ['economic_forecasts', 'financial_indicators', 'environment_forecasts'];
const ledgerGroups = bucketOrder
  .map((b) => ({ bucket: b, meta: bucketMeta[b], rows: eligibleRows.filter((r) => r.bucket === b) }))
  .filter((g) => g.rows.length > 0);

// Review rows keyed by judgment cluster (per-market cluster keys come from
// screen_eligibility.py — each cluster block expands into its own markets).
const reviewRowsByCluster: Record<string, Row[]> = {};
for (const r of reviewRows) (reviewRowsByCluster[r.cluster] ??= []).push(r);
// Integrity fallback: a review row whose cluster key is missing/unknown (the
// two data files are separate artifacts of one script run and can drift) must
// never silently vanish — it renders under an explicit unclustered block.
const knownClusters = new Set((summary?.review_clusters ?? []).map((c) => c.key));
const unclusteredRows = reviewRows.filter((r) => !knownClusters.has(r.cluster));

// Jeremy 2026-06-11: no "§" anywhere — the bulletin itself doesn't use it;
// spell out "Section N" on all surfaces (data labels get deSection below).
const deSection = (s: string) => s.replace(/§\s?(\d)/g, 'Section $1');
const notEligibleMeta: Record<string, string> = {
  category_not_permitted: 'category outside the permitted set (Section 1) or prohibited (Section 3)',
  under_min_maturity: 'term to maturity under 30 days (Section 2)',
  no_resolution_date: 'no resolution date on the contract',
  venue_out_of_scope: 'venue out of scope for this screen',
  other: 'other',
};
const notEligibleGroups = Object.entries(notEligibleReasons)
  .sort((a, b) => b[1] - a[1])
  .map(([reason, n]) => ({ reason, label: notEligibleMeta[reason] ?? reason, n }));

// One brief line per cluster: why the screen flagged it (label context +
// the open judgment, combined — Jeremy round 4).
const clusterWhy: Record<string, string> = {
  ipo_announcements: 'A corporate one-off is not clearly an "Economic Forecast" — the bulletin’s Section 1 examples are macro statistics.',
  company_metrics: 'Company performance metrics are not clearly "economic statistics" in the Section 1 sense.',
  commodity_prices: 'Commodity price levels fit none of the bulletin’s listed categories cleanly.',
  fx_levels: 'An FX rate is not clearly a "Financial indicator" — the bulletin’s example is an equity-index settlement.',
  wealth_rankings: 'Rich-list rankings fit none of the bulletin’s listed categories.',
  weather_events: 'Weather events are not "climate indicators related to the average global temperature".',
  crypto_prices: 'Section 1 does not list crypto, though these settle the same way as its CME index example.',
  political_language: 'Political wording inside a permitted category — Section 3 prohibits political-outcome contracts, so these are held for review out of caution. Most are date or name echoes ("Election Day", "Bank of England").',
  other_interpretation: 'Sits in a permitted category but resembles none of the bulletin\u2019s named subjects — each needs a decision on whether it counts as an "Economic Forecast".',
};

const jsonLd = summary && {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'ClearMarket Eligibility Screen — CIRO 26-0076',
  description:
    'Per-contract eligibility screening of Kalshi event contracts against the terms of CIRO Administrative Bulletin 26-0076 (Canadian dealer distribution under IDPC Rule 2246(2)). Statuses: eligible, review, not_eligible. Screening data supporting a dealer’s own determination; not a compliance opinion.',
  creator: { '@type': 'Organization', name: 'ClearMarket', url: 'https://clearmarket.fyi' },
  license: 'https://creativecommons.org/licenses/by/4.0/',
  dateModified: summary.screened_at,
  version: summary.screen_version,
  isBasedOn: 'https://www.ciro.ca/newsroom/publications/application-ciro-requirements-event-contracts',
  url: canonicalURL,
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://clearmarket.fyi/screens/ciro-26-0076.json' },
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://clearmarket.fyi/screens/ciro-26-0076.csv' },
  ],
};
---
<Site
  title="Eligibility screen · CIRO 26-0076 · ClearMarket"
  description="Kalshi event contracts screened against the terms of CIRO Administrative Bulletin 26-0076 (Canadian dealer distribution): eligible / review / not_eligible, with the rule-mapping, review clusters, and methodology. Screening data, not a compliance opinion."
  canonical={canonicalURL}
>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />}

  <nav class="cm-subnav" aria-label="Screen sections" slot="subnav">
    <a href="#funnel" class="cm-subnav-link cm-subnav-active"><span class="cm-active-mark">&#9614;</span>Funnel</a>
    <a href="#eligible" class="cm-subnav-link"><span class="cm-active-mark">&#9614;</span>Eligible</a>
    <a href="#review" class="cm-subnav-link"><span class="cm-active-mark">&#9614;</span>Review</a>
    <a href="#not-eligible" class="cm-subnav-link"><span class="cm-active-mark">&#9614;</span>Not eligible</a>
    <a href="#rules" class="cm-subnav-link"><span class="cm-active-mark">&#9614;</span>Rule mapping</a>
    <a href="#methodology" class="cm-subnav-link"><span class="cm-active-mark">&#9614;</span>Methodology</a>
    {summary && <span class="cm-subnav-snapshot">screen {summary.screen_version} <span class="cm-dot-positive">&#9679;</span> {summary.screened_at}</span>}
  </nav>

  <article class="cm-v2">
    <h1 class="cm-h1">
      <span class="cm-h1-brand">ELIGIBILITY SCREENS</span>
      <span class="cm-h1-sep">//</span>
      <span class="cm-h1-role">CIRO 26-0076</span>
    </h1>

    {!summary && <p class="cm-index-lede">Screen data unavailable in this build.</p>}

    {summary && (
      <>
        {/* ===== LEDE: one flat scope statement, no numbers, no pitch ===== */}
        <p class="scr-lede">
          Each live market is screened against the terms of CIRO Administrative Bulletin 26-0076
          and assigned one of three statuses: eligible, review, or not eligible.
        </p>

        {/* ===== PROSPECTUS HEADER BLOCK ===== */}
        <dl class="scr-prospectus scr-pros-meta">
          <div class="scr-pros-row"><dt>screen regime</dt><dd>CIRO Administrative Bulletin 26-0076 (Mar 26, 2026)</dd></div>
          <div class="scr-pros-row"><dt>rule authority</dt><dd>IDPC Rule 2246(2) — Canadian dealer distribution</dd></div>
          <div class="scr-pros-row"><dt>scope</dt><dd>Kalshi event contracts (CFTC-regulated exchange)</dd></div>
          <div class="scr-pros-row"><dt>screened</dt><dd>{summary.screened_at} · screen {summary.screen_version}</dd></div>
          <div class="scr-pros-row"><dt>formats</dt><dd>HTML · <a href="/screens/ciro-26-0076.json">JSON</a> · <a href="/screens/ciro-26-0076.csv">CSV</a> · API/MCP field <code>eligibility_screens</code></dd></div>
          <div class="scr-pros-row"><dt>source</dt><dd><a href="https://www.ciro.ca/newsroom/publications/application-ciro-requirements-event-contracts" rel="noopener">bulletin 26-0076 ↗</a></dd></div>
        </dl>

        {/* ===== ATTRITION CASCADE ===== */}
        <section id="funnel" class="cm-section">
          <div class="cm-section-h">screening funnel <span class="cm-section-tag">| each market counted at the first term it misses · screened {summary.screened_at}</span></div>
          <div class="scr-cascade" data-screen-regime={summary.regime}>
            {cascadeRows.map((r) => (
              <div class="scr-cascade-row">
                <span class="scr-cascade-idx">{r.idx}.</span>
                <span class="scr-cascade-label">{r.label}</span>
                <span class="scr-cascade-n">[ {fmt(r.n)} ]</span>
                <span class="scr-cascade-note">{r.delta === null ? r.note : `(−${fmt(r.delta)} ${r.note})`}</span>
              </div>
            ))}
          </div>
        </section>

        {/* ===== ELIGIBLE MARKETS ===== */}
        <section id="eligible" class="cm-section">
          <div class="cm-section-h">eligible markets <span class="cm-section-tag">| {fmt(f.eligible)} markets</span></div>
          <p class="scr-intro">
            These markets clear every term this screen tests: a permitted subject category, a term to maturity of
            30 days or longer, and a settled match to a subject in the bulletin&rsquo;s Appendix A — the schedule
            that lists the permitted categories.
          </p>
          <details class="scr-ledger" id="scr-ledger">
            <summary class="scr-ledger-action">[ ▾ VIEW ELIGIBLE MARKETS — {fmt(f.eligible)} ]</summary>
            {ledgerGroups.map((g) => (
            <details class="scr-group" data-bucket={g.bucket}>
              <summary class="scr-group-summary">
                <span class="scr-group-marker" aria-hidden="true">▸</span>
                <span class="scr-group-tag">[{g.meta.tag}]</span>
                <span class="scr-group-count">{g.rows.length} {g.rows.length === 1 ? 'MARKET' : 'MARKETS'}</span>
              </summary>
              <table class="scr-table scr-eligible">
                <thead><tr><th>market</th><th>venue id</th><th>resolves</th><th>source</th><th>rcg</th></tr></thead>
                <tbody>
                  {g.rows.map((r) => (
                    <tr data-market-id={r.market_id} class={r.commitment === 'named' ? undefined : 'scr-row-nosource'}>
                      <td class="scr-q"><a href={`/events/${r.slug}/`}>{r.question}</a></td>
                      <td class="scr-mono scr-vid" title={r.venue_id}>{r.venue_id}</td>
                      <td class="scr-mono">{r.resolves}</td>
                      <td class="scr-mono">{r.commitment === 'named' ? r.source : <span class="scr-warn">— none</span>}</td>
                      <td class="scr-mono">{r.grade ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
            ))}
          </details>
          <p class="scr-flag" data-stat="eligible_no_committed_source">
            Note: {summary.eligible_no_committed_source} of the {fmt(f.eligible)} eligible markets name no
            resolution source — flagged in red in the table.
          </p>
        </section>

        {/* ===== REVIEW MARKETS ===== */}
        <section id="review" class="cm-section">
          <div class="cm-section-h">review markets <span class="cm-section-tag">| {fmt(f.review)} markets in {summary.review_clusters.length} judgment clusters</span></div>
          <p class="scr-intro">
            Nine documented calls cover all {fmt(f.review)} of these markets. Each clears the mechanical terms;
            what remains is interpretation — does it fit a Section 1 category, or does its wording trip Section 3?
            The screen holds them for a documented judgment instead of silently passing them, grouped below by
            the question that needs answering.
          </p>
          <div class="scr-clusters">
            {summary.review_clusters.map((c) => (
              <div class="scr-cluster" data-cluster={c.key} data-reason={c.reason}>
                <div class="scr-cluster-top">
                  <span class="scr-cluster-name">{deSection(c.label)}</span>
                  <span class="scr-cluster-counts">[ {c.market_count} MARKETS ]</span>
                </div>
                <p class="scr-cluster-why">
                  {clusterWhy[c.key] ?? deSection(REASON_COPY[c.reason])}
                  <span class="scr-cluster-eg"> e.g. &ldquo;{c.example_events[0]}&rdquo;</span>
                </p>
                <details class="scr-cluster-mkts">
                  <summary class="scr-cluster-toggle">[ ▾ VIEW MARKETS — {c.market_count} ]</summary>
                  <table class="scr-table scr-eligible">
                    <thead><tr><th>market</th><th>venue id</th><th>resolves</th><th>source</th><th>rcg</th></tr></thead>
                    <tbody>
                      {(reviewRowsByCluster[c.key] ?? []).map((r) => (
                        <tr data-market-id={r.market_id}>
                          <td class="scr-q"><a href={`/events/${r.slug}/`}>{r.question}</a></td>
                          <td class="scr-mono scr-vid" title={r.venue_id}>{r.venue_id}</td>
                          <td class="scr-mono">{r.resolves}</td>
                          <td class="scr-mono">{r.commitment === 'named' ? r.source : <span class="scr-warn">— none</span>}</td>
                          <td class="scr-mono">{r.grade ?? '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </details>
              </div>
            ))}
            {unclusteredRows.length > 0 && (
              <div class="scr-cluster" data-cluster="unclustered">
                <div class="scr-cluster-top">
                  <span class="scr-cluster-name">Unclustered (data drift — should be empty)</span>
                  <span class="scr-cluster-counts">[ {unclusteredRows.length} MARKETS ]</span>
                </div>
                <p class="scr-cluster-why">These review markets carry no recognized cluster key; the per-market and summary files have drifted. Regenerate the screen data.</p>
                <details class="scr-cluster-mkts">
                  <summary class="scr-cluster-toggle">[ ▾ VIEW MARKETS — {unclusteredRows.length} ]</summary>
                  <table class="scr-table scr-eligible">
                    <thead><tr><th>market</th><th>venue id</th><th>resolves</th><th>source</th><th>rcg</th></tr></thead>
                    <tbody>
                      {unclusteredRows.map((r) => (
                        <tr data-market-id={r.market_id}>
                          <td class="scr-q"><a href={`/events/${r.slug}/`}>{r.question}</a></td>
                          <td class="scr-mono scr-vid" title={r.venue_id}>{r.venue_id}</td>
                          <td class="scr-mono">{r.resolves}</td>
                          <td class="scr-mono">{r.commitment === 'named' ? r.source : <span class="scr-warn">— none</span>}</td>
                          <td class="scr-mono">{r.grade ?? '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </details>
              </div>
            )}
          </div>
        </section>

        {/* ===== NOT ELIGIBLE ===== */}
        <section id="not-eligible" class="cm-section">
          <div class="cm-section-h">not eligible <span class="cm-section-tag">| {fmt(f.not_eligible)} markets</span></div>
          <p class="scr-intro">
            These markets miss at least one mechanical term of the bulletin. This is a jurisdiction-scoping fact
            about one rule-set, not a judgment on the market itself. By first failed term:
          </p>
          <table class="scr-table scr-noteligible">
            <thead><tr><th>reason</th><th class="scr-num">markets</th></tr></thead>
            <tbody>
              {notEligibleGroups.map((g) => (
                <tr data-reason={g.reason}>
                  <td>{g.label}</td>
                  <td class="scr-mono scr-num">{fmt(g.n)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="scr-note">Full per-contract records: <a href="/screens/ciro-26-0076.json">JSON</a> · <a href="/screens/ciro-26-0076.csv">CSV</a></p>
        </section>

        {/* ===== RULE MAPPING ===== */}
        <section id="rules" class="cm-section">
          <div class="cm-section-h">rule mapping <span class="cm-section-tag">| CIRO Bulletin 26-0076, Appendix A → screening logic</span></div>
          <p class="scr-note">Section numbers below are the sections of Appendix A in CIRO Administrative Bulletin 26-0076. Expand any row for the bulletin&rsquo;s verbatim text.</p>
          <div class="scr-rules">
            <details class="scr-rule">
              <summary class="scr-rule-line">
                <span class="scr-rule-ref">SECTION 1 · PERMITTED SUBJECT CATEGORIES</span>
                <span class="scr-rule-logic">The bulletin permits three subject categories, each described with illustrative (&ldquo;such as&rdquo;) examples rather than an exhaustive list. A market clearly inside a permitted category: <span class="scr-st scr-st-eligible">eligible</span> · an arguable fit: <span class="scr-st scr-st-review">review</span></span>
                <span class="scr-rule-toggle">[ VERBATIM + ]</span>
              </summary>
              <div class="scr-rule-body">
                <blockquote class="scr-verbatim">&ldquo;offering of event contracts will be <em>limited to the following</em>: Economic Forecasts: <em>such as</em> contracts based on economic statistics related to the amount of sovereign debt, inflation rates, central bank reserve rates, labor markets, and housing; Environment Forecasts: <em>such as</em>&hellip; climate indicators related to the average global temperature; Financial indicators: <em>such as</em> US 500 Forecast Contracts that settle based on the daily settlement price of the&hellip; CME E-Mini S&amp;P 500 Futures&rdquo;</blockquote>
                <p class="scr-rule-note">screened field: event tags + question text</p>
              </div>
            </details>
            <details class="scr-rule">
              <summary class="scr-rule-line">
                <span class="scr-rule-ref">SECTION 2 · MINIMUM TERM TO MATURITY</span>
                <span class="scr-rule-logic">≥ 30d from screen date, per market (a new threshold = a new contract)</span>
                <span class="scr-rule-toggle">[ VERBATIM + ]</span>
              </summary>
              <div class="scr-rule-body">
                <blockquote class="scr-verbatim">&ldquo;Investment Dealer Members&rsquo; offering of event contracts will be limited to contracts with a term to maturity of 30 days or longer. For greater certainty, issuing a new threshold in respect of an event contract constitutes a new contract, this new contract must also have a term to maturity of 30 days or longer&rdquo;</blockquote>
                <p class="scr-rule-note">screened field: <code>resolve_at</code>, per market — the threshold sentence is why screening is per-market, not per-event</p>
              </div>
            </details>
            <details class="scr-rule">
              <summary class="scr-rule-line">
                <span class="scr-rule-ref">SECTION 3 · PROHIBITED SUBJECT MATTER</span>
                <span class="scr-rule-logic">politics/geopolitics <span class="scr-st scr-st-not">not_eligible</span> · in-category political language <span class="scr-st scr-st-review">review</span></span>
                <span class="scr-rule-toggle">[ VERBATIM + ]</span>
              </summary>
              <div class="scr-rule-body">
                <blockquote class="scr-verbatim">&ldquo;will not offer event contracts based on the outcome of elections, political events, or other events of a political nature&hellip; or&hellip; unlawful activities&rdquo;</blockquote>
                <p class="scr-rule-note">screened field: category + in-category language flag</p>
              </div>
            </details>
            <details class="scr-rule">
              <summary class="scr-rule-line">
                <span class="scr-rule-ref">BULLETIN BODY · DUE-DILIGENCE EXPECTATION</span>
                <span class="scr-rule-logic">The bulletin expects dealers to vet each contract themselves. ClearMarket&rsquo;s resolution-source and grade columns are supporting evidence for that vetting — they never determine a market&rsquo;s eligibility status</span>
                <span class="scr-rule-toggle">[ VERBATIM + ]</span>
              </summary>
              <div class="scr-rule-body">
                <blockquote class="scr-verbatim">&ldquo;Investment Dealer Members are <em>expected to exercise due diligence</em> to ensure that any event contracts made available to clients do not fall within these prohibited categories&rdquo;</blockquote>
                <p class="scr-rule-note">the bulletin&rsquo;s diligence sentence is about prohibited categories; the source, commitment, RCG grade, and settlement-history columns are ClearMarket&rsquo;s own evidence layer offered in the same spirit — the bulletin contains no source-quality term, and these are never eligibility gates</p>
              </div>
            </details>
          </div>
        </section>

        {/* ===== METHODOLOGY ===== */}
        <section id="methodology" class="cm-section cm-section-machine">
          <div class="cm-section-h">methodology &middot; status vocabulary &middot; changelog</div>
          <div class="scr-method">
            <p><strong>Statuses.</strong></p>
            <p><span class="scr-st scr-st-eligible">eligible</span> — clears every Appendix A term mechanically.</p>
            <p><span class="scr-st scr-st-review">review</span> — clears the mechanical terms; what remains is a documented Section 1 or Section 3 interpretation call. A contract matching no core pattern never silently passes — it lands in review.</p>
            <p><span class="scr-st scr-st-not">not_eligible</span> — misses a mechanical term (permitted category, or the 30-day minimum maturity).</p>
            <p>Statuses describe fit against <em>this rule-set only</em> — market quality is the separate <a href="/methodology/">Resolution Clarity Grade</a>.</p>
            <p>
              <strong>Primary source.</strong> Built from the verbatim text of
              <a href="https://www.ciro.ca/newsroom/publications/application-ciro-requirements-event-contracts" rel="noopener">CIRO Administrative Bulletin 26-0076</a>
              and the Apr 2, 2026 CSA/CIRO notice — never from secondary coverage. Section 4 (no client leverage/margin) is a dealer-conduct
              term, not contract-screenable.
            </p>
            <p class="scr-changelog"><strong>Changelog.</strong> v1 ({summary.screened_at}) — first version of this screen. If the screening rules change, the version number changes, so any past result can be traced to the rules that produced it.</p>
            <p class="scr-disclaimer">
              ClearMarket eligibility screens are reference data: a documented, reproducible mapping of contract attributes against a named
