---
import Site from '../layouts/Site.astro';

// Cloudflare Pages serves this as the 404 response for any unmatched route, with a
// real 404 status — replacing the prior soft-404 (every unknown URL fell through to
// the homepage with HTTP 200, which misled agents and crawlers).
---
<Site title="Not found · ClearMarket" description="The page you requested does not exist." noindex>
  <section class="nf">
    <div class="nf-code">404</div>
    <h1>No record at this path.</h1>
    <p>The page, event, or signal you requested doesn’t exist or has moved.</p>
    <ul class="nf-links">
      <li><a href="/events/">Browse graded events</a></li>
      <li><a href="/signals/">CM Signal wire</a></li>
      <li><a href="/api/">API + MCP</a></li>
      <li><a href="/">Home</a></li>
    </ul>
  </section>

  <style>
    .nf { max-width: 560px; margin: 80px auto; font-family: var(--va-mono); }
    .nf-code { font-size: 13px; letter-spacing: 0.2em; color: var(--va-accent); margin-bottom: 14px; }
    .nf h1 { font-family: var(--va-sans); font-size: 26px; font-weight: 700; letter-spacing: -0.02em; color: var(--va-fg); margin: 0 0 12px; }
    .nf p { color: var(--va-fg-muted); font-size: 15px; line-height: 1.6; margin: 0 0 24px; }
    .nf-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
    .nf-links a { color: var(--va-accent); text-decoration: none; font-size: 14px; }
    .nf-links a:hover { text-decoration: underline; }
  </style>
</Site>
