// surface sections + --va-* tokens) so the two reference pages read as one system.
const updated = '2026-05-26';
---
<Site title="Methodology — ClearMarket" description="How ClearMarket selects, sources, and grades prediction-market data across Kalshi and Polymarket.">
  <div class="doc">
    <aside class="doc-gutter">
      <div class="dg-meta">
        <div class="dg-row"><span class="dg-k">doc_id</span><span class="dg-v">cm-methodology</span></div>
        <div class="dg-row"><span class="dg-k">version</span><span class="dg-v">RCG v2</span></div>
        <div class="dg-row"><span class="dg-k">updated</span><span class="dg-v">{updated}</span></div>
        <div class="dg-row"><span class="dg-k">scope</span><span class="dg-v">public · canonical</span></div>
        <div class="dg-row"><span class="dg-k">spec</span><span class="dg-v">rcg-scoring-model.csv</span></div>
      </div>
      <nav class="dg-nav">
        <a href="#overview">Overview</a>
        <a href="#universe">1 · Universe &amp; filter</a>
        <a href="#sources">2 · Verified sources</a>
        <a href="#rcg">3 · Clarity Grade</a>
        <a href="#editorial">4 · Editorial</a>
        <a href="#crossvenue">5 · Cross-venue linking</a>
