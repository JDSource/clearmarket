                  ); })()}
                  {claim.volume_ratio_vs_baseline != null && (() => { const p = provBracket(claim, "volume_ratio_vs_baseline"); return (
                    <div class="cm-kv-row"><dt>spike_ratio</dt><dd><span class="cm-num-emphasis">{claim.volume_ratio_vs_baseline.toFixed(1)}x</span> <span class="cm-kv-aside">vs 7d baseline</span>{p && <span class="cm-prov-inline">{p.url ? <a class="cm-prov-link" href={p.url} rel="noopener nofollow">{p.rest}</a> : p.rest}</span>}</dd>{p && <span class="cm-tier-stamp">[<abbr class="cm-tier-abbr" title={tierDefs[p.tier as keyof typeof tierDefs]}>{p.tier}</abbr>]</span>}</div>
                  ); })()}
