    {/* ===== EVALUATION — methodology per detection_path ===== */}
    <section id="evaluation" class="cm-section">
      <div class="cm-section-h">evaluation</div>
      <p class="cm-section-summary">{isNewsCycle
        ? 'News-cycle wires publish on coverage, not editorial selection — the day’s top stories matched to the prediction markets pricing them, so nothing is cherry-picked.'
        : 'The model, prompt version, and confidence behind this wire are published below — so you can see how it was judged, and re-check it yourself.'}</p>
      <dl class="cm-kv cm-kv-wide">
        <div class="cm-kv-row"><dt>judge_engine</dt><dd><code class="cm-kv-id">{judgeEngine}</code></dd></div>
        <div class="cm-kv-row"><dt>judge_verdict</dt><dd><span class="cm-kv-pass">{judgeVerdict}</span></dd></div>
        {judgeConfidence !== null ? (
          <div class="cm-kv-row"><dt>judge_confidence</dt><dd><span class="cm-num-emphasis">{judgeConfidence.toFixed(2)}</span> <span class="cm-kv-aside">/ 1.00</span></dd></div>
        ) : (
          <div class="cm-kv-row"><dt>judge_confidence</dt><dd><span class="cm-kv-aside">n/a — no judge gate (deterministic publishing)</span></dd></div>
        )}
        <div class="cm-kv-row"><dt>prompt_template</dt><dd><a class="cm-kv-link" href={`https://github.com/JDSource/clearmarket/blob/main/prompts/${promptTemplate}.txt`} rel="noopener nofollow" target="_blank"><code class="cm-kv-id">{promptTemplate}</code></a> <span class="cm-kv-aside">github · auditable</span></dd></div>
        {matchMethod && <div class="cm-kv-row"><dt>match_method</dt><dd><code class="cm-kv-id">{matchMethod}</code></dd></div>}
      </dl>
    </section>

    {/* ===== CITATION GRAPH ===== */}
    <section id="citations" class="cm-section">
      <div class="cm-section-h">citation graph</div>
      <p class="cm-section-summary">Every wire traces back to the ClearMarket event it is built on, and out to each venue&rsquo;s own market page &mdash; so any figure here can be verified at its source.</p>

      <div class="cm-citation-group">
        <div class="cm-citation-group-label">internal</div>
        <dl class="cm-kv">
          <div class="cm-kv-row"><dt>cm_event</dt><dd><a class="cm-kv-link" href={eventHref}>{eventHref}</a></dd></div>
          {data.linked_event_ids && data.linked_event_ids.length > 0 && (
            <div class="cm-kv-row"><dt>related</dt><dd>{data.linked_event_ids.map((id) => <code class="cm-kv-id">{id}</code>)}</dd></div>
          )}
        </dl>
      </div>

      <div class="cm-citation-group">
        <div class="cm-citation-group-label">external</div>
        <dl class="cm-kv">
          <div class="cm-kv-row"><dt>venue_a</dt><dd>{venueAUrl ? <a class="cm-kv-link" href={venueAUrl} rel="noopener nofollow">{venueAUrl}</a> : <span class="cm-kv-id">{venueALabel}</span>}</dd></div>
          {related && (
            <div class="cm-kv-row"><dt>venue_b</dt><dd>{venueBUrl ? <a class="cm-kv-link" href={venueBUrl} rel="noopener nofollow">{venueBUrl}</a> : <span class="cm-kv-id">{venueBLabel}</span>}</dd></div>
          )}
          {benchmarkSource && (
            <div class="cm-kv-row"><dt>benchmark</dt><dd><a class="cm-kv-link" href={benchmarkSource.url} rel="noopener nofollow">{benchmarkSource.url}</a></dd></div>
          )}
        </dl>
      </div>
    </section>

    {/* ===== PROGRAMMATIC ACCESS ===== */}
    <section id="api" class="cm-section cm-section-machine">
      <div class="cm-section-h">programmatic access &middot; four surfaces, same payload</div>
      <p class="cm-section-summary">AI grounded search reads embedded JSON-LD in HTML. Developers query REST. Agentic AI clients (Claude Desktop, Cursor) call MCP tools. AI crawlers index via <code class="cm-inline-code">/llms.txt</code>. Same canonical record at every surface.</p>
      <table class="cm-endpoints-table">
        <tbody>
          <tr><td class="cm-fmt">HTML</td><td>browsers, AI grounded search, crawlers (contains embedded JSON-LD <code class="cm-inline-code">@type: Dataset</code> + <code class="cm-inline-code">ClaimReview</code>)</td><td><code class="cm-endpoint-url">{canonicalURL}</code></td></tr>
          <tr><td class="cm-fmt">JSON</td><td>REST API for developers</td><td><a href={`${jsonURL}`}><code class="cm-endpoint-url">{jsonURL}</code></a></td></tr>
          <tr><td class="cm-fmt">MCP</td><td>agentic AI tool call (Claude Desktop, Cursor, Continue)</td><td><code class="cm-endpoint-url">clearmarket.get_signal("{data.signal_slug}")</code></td></tr>
          <tr><td class="cm-fmt">AGENT</td><td>AI crawler discovery index</td><td><a href="/llms.txt"><code class="cm-endpoint-url">/llms.txt</code></a></td></tr>
        </tbody>
      </table>
      <p class="cm-provenance-note">PM data: platform APIs (hourly refresh). News context: retrieved with source citations. Editorial judgment: LLM judge with prompt template versioned per wire type. Per-claim provenance inline above; full per-field provenance map at the JSON endpoint under <code>field_provenance</code>.</p>
      <div class="cm-json-block">
        <div class="cm-json-block-head"><span class="cm-json-block-label">raw JSON record &middot; same payload returned by REST endpoint</span></div>
        <pre class="cm-machine-json"><code set:html={colorizeJson(machineRecord)}></code></pre>
      </div>

      {/* Provenance protocol legend — short-form definitions of the 4 tiers.
          Self-contained payload: humans printing the page to PDF still get the
          glossary; AI crawlers parsing only the HTML body see the canonical
          definition without needing a secondary HTTP fetch. Full spec lives at
          /schema/provenance/v1 (build item #16). */}
      <div class="cm-prov-legend">
        <span class="cm-prov-legend-head">PROVENANCE PROTOCOL v0.2</span>
        <span class="cm-prov-legend-sep">·</span>
        <span class="cm-prov-legend-item"><span class="cm-prov-legend-tag">[direct]</span> venue api</span>
        <span class="cm-prov-legend-sep">·</span>
        <span class="cm-prov-legend-item"><span class="cm-prov-legend-tag">[mediated]</span> grounded web fetch + source url</span>
        <span class="cm-prov-legend-sep">·</span>
        <span class="cm-prov-legend-item"><span class="cm-prov-legend-tag">[derived]</span> computed from listed inputs</span>
        <span class="cm-prov-legend-sep">·</span>
        <span class="cm-prov-legend-item"><span class="cm-prov-legend-tag">[editorial]</span> versioned llm judgment</span>
        <span class="cm-prov-legend-sep">·</span>
        <a class="cm-prov-legend-link" href="https://clearmarket.fyi/schema/provenance/v1">full spec /schema/provenance/v1</a>
      </div>
    </section>

    {/* ===== FOOTER ===== */}
    <div class="cm-event-foot">
      <span><span class="cm-meta-l">record</span> <code>{data.signal_id}</code></span>
      <span><span class="cm-meta-l">published</span> <code>{data.published_at}</code></span>
      <span><span class="cm-meta-l">signature</span> <code title="SHA-256 of canonical JSON record · verifiable post-publication" data-signature={signature} data-cm-field="signature">{signature.slice(0, 18)}…</code></span>
      <span><a href={eventHref}>&larr; underlying event</a></span>
      <a href="/signals/">all signals &rarr;</a>
    </div>

  </article>

  <style>
    /* Container — match event page width */
    .cm-v2 {
      max-width: 1280px;
      width: calc(100vw - 80px);
      margin-left: calc((1080px - 1280px) / 2);
      margin-right: calc((1080px - 1280px) / 2);
    }
    @media (max-width: 1280px) {
      .cm-v2 { margin: 0; width: 100%; }
    }
    .cm-v2 pre, .cm-v2 code {
      background: transparent;
      border: 0;
      border-radius: 0;
      padding: 0;
      margin: 0;
      font-family: var(--cm-font-mono);
      color: inherit;
    }
    .cm-v2 a { text-decoration: none; }

    /* Preview note */
    .preview-note {
      margin: 16px 0 24px;
      padding: 8px 12px;
      background: var(--cm-bg-surface);
      border-left: 2px solid var(--cm-divergence);
      font-family: var(--cm-font-mono);
      font-size: 11px;
      color: var(--cm-fg-muted);
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .preview-note-label {
      color: var(--cm-divergence);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
    }

    /* Sub-nav (matches event page) */
    .cm-subnav {
      display: flex;
      align-items: center;
      gap: 28px;
      max-width: 1280px;
      margin: 0 auto;
      padding: 10px 40px;
      font-family: var(--cm-font-mono);
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      background: var(--cm-bg-surface);
      border-bottom: 1px solid var(--cm-border-rule);
    }
    .cm-subnav a {
      color: var(--cm-fg-muted);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .cm-subnav a:hover { color: var(--cm-fg-primary); }
    .cm-subnav-link.cm-subnav-active { color: var(--cm-fg-primary); }
    .cm-active-mark {
      color: var(--cm-positive);
      font-size: 14px;
      line-height: 1;
      opacity: 0;
      width: 0;
      overflow: hidden;
      transition: opacity 0.12s ease, width 0.12s ease;
    }
    .cm-subnav-active .cm-active-mark { opacity: 1; width: auto; }
    .cm-subnav-snapshot {
      margin-left: auto;
      color: var(--cm-fg-faint);
      letter-spacing: 0.08em;
    }
    .cm-dot-positive { color: var(--cm-positive); }

    /* H1 */
    /* Breadcrumb — orients a first-time reader (who often lands here straight from
       the homepage wire feed) and gives a one-click route back to the wire index. */
    .cm-crumb {
      margin: 4px 0 2px;
      font-family: var(--cm-font-mono);
      font-size: 11.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .cm-crumb a {
      display: inline-block;
      /* terminal amber — wayfinding accent, deliberately distinct from the blue
         data-links and the green live-status used elsewhere on this page. */
      color: #f0b429;
      font-weight: 600;
      text-decoration: none;
      padding: 2px 0;
      transition: color .12s ease;
    }
    .cm-crumb a:hover {
      color: #ffc847;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .cm-h1 {
      font-family: var(--cm-font-mono);
      font-size: clamp(17px, 1.7vw, 22px);
      font-weight: 600;
      color: var(--cm-fg-primary);
      letter-spacing: -0.005em;
      margin: 16px 0 12px;
      white-space: normal;
      line-height: 1.35;
    }

    /* Horizon meta strip — sibling of /events/[slug] horizon.
       Bloomberg/Eikon pattern: top + bottom hairlines, min-height 28px,
       tokens distributed across width via justify-content:space-between,
       sans-serif lowercase labels in muted, mono uppercase values in link. */
    .cm-horizon {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
      min-height: 28px;
      margin-top: 14px;
      margin-bottom: 22px;
      border-top: 1px solid var(--cm-border-hairline);
      border-bottom: 1px solid var(--cm-border-hairline);
      padding: 4px 2px;
      overflow-x: auto;
      white-space: nowrap;
    }
    .cm-horizon-token {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .cm-horizon-pipe {
      color: var(--cm-border-rule);
      font-family: var(--cm-font-mono);
      font-size: 11px;
      font-weight: 400;
      user-select: none;
    }
    .cm-horizon-label {
      font-family: var(--cm-font-sans);
      font-size: 11px;
      font-weight: 400;
      color: var(--cm-fg-muted);
      text-transform: lowercase;
      letter-spacing: 0;
    }
    .cm-horizon-value {
      font-family: var(--cm-font-mono);
      font-size: 11.5px;
      font-weight: 500;
      color: var(--cm-fg-link);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-variant-numeric: tabular-nums;
    }
    .cm-horizon-link { text-decoration: none; }
    .cm-horizon-link:hover { color: var(--cm-fg-primary); }

    /* Event question - secondary */
    .cm-event-question {
      font-family: var(--cm-font-sans);
      font-size: 14px;
      color: var(--cm-fg-secondary);
      line-height: 1.5;
      margin: 0 0 28px;
    }

    /* Wire body — narrative summary. Mirrors /events/[slug] editorial callout
       so the two pages read as siblings of one product. Callout label uses
       events-page chrome: bottom hairline + flex + 0.15em letter-spacing.
       Bullets use the events-page tiny-bar ::before marker, not a literal em-dash. */
    .cm-wire-body {
      display: block;
      padding: 0;
      margin-bottom: 32px;
    }
    .cm-callout-label {
      font-family: var(--cm-font-mono);
      font-size: 10px;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--cm-fg-muted);
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--cm-border-hairline);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .cm-callout-tag {
      font-weight: 400;
      color: var(--cm-fg-faint);
      letter-spacing: 0.1em;
    }
    .cm-wire-bullets {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .cm-wire-bullets li {
      font-family: var(--cm-font-sans);
      font-size: 13px;
      line-height: 1.55;
      color: var(--cm-fg-primary);
      padding-left: 14px;
      position: relative;
    }
    .cm-wire-bullets li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 9px;
      width: 6px;
      height: 1px;
      background: var(--cm-fg-faint);
    }

    /* Section header */
    .cm-section {
      margin: 32px 0;
    }
    .cm-section-h {
      font-family: var(--cm-font-mono);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--cm-fg-muted);
      padding-bottom: 8px;
      border-bottom: 1px solid var(--cm-border-rule);
      margin-bottom: 16px;
    }
    .cm-section-tag {
      color: var(--cm-fg-faint);
      font-weight: 400;
      letter-spacing: 0.1em;
      margin-left: 4px;
      text-transform: lowercase;
    }
    .cm-section-summary {
      font-family: var(--cm-font-sans);
      font-size: 13px;
      color: var(--cm-fg-secondary);
      line-height: 1.5;
      margin: 0 0 16px;
      max-width: 880px;
    }

    /* Atomic claim block */
    /* Each atomic brief encased in a hard 1px box with uniform 1rem padding (Gemini
       checklist): gives the eye a boundary, stops mono text bleeding into a wall,
       and keeps each [01]/[02] block visually distinct from the narrative summary. */
    .cm-claim {
      padding: 16px;
      border: 1px solid var(--cm-border-hairline);
      margin-bottom: 12px;
    }
    .cm-claim:last-of-type { margin-bottom: 0; }
    .cm-claim-head {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 8px;
    }
    .cm-claim-num {
      font-family: var(--cm-font-mono);
      font-size: 11px;
      color: var(--cm-fg-muted);
      letter-spacing: 0.08em;
      font-variant-numeric: tabular-nums;
    }
    .cm-claim-type {
      font-family: var(--cm-font-mono);
      font-size: 12px;
      font-weight: 700;
      color: var(--cm-fg-primary);
      letter-spacing: 0.06em;
    }

    /* Key-value rows */
    .cm-kv {
      margin: 0;
      padding: 0;
      font-family: var(--cm-font-mono);
      font-size: 12px;
      line-height: 1.7;
    }
    .cm-kv-row {
      display: grid;
      grid-template-columns: 140px 1fr auto;
      column-gap: 16px;
      align-items: baseline;
    }
    .cm-kv-wide .cm-kv-row {
      grid-template-columns: 180px 1fr auto;
    }
    /* Tier stamp lives in the right-most grid column — plain text, right-aligned,
       no chip/pill/badge. Same visual register as the existing bracket-active
       filters and the active-marker on subnav. Scans cleanly down the right edge
       of a multi-field claim — eye reads [direct] [direct] [derived] [mediated]
       in one pass without engaging the individual values. */
    .cm-tier-stamp {
      color: var(--cm-fg-faint);
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      letter-spacing: 0.04em;
      text-align: right;
      white-space: nowrap;
      padding-left: 24px;
    }
    .cm-kv-row dt {
      color: var(--cm-fg-muted);
      letter-spacing: 0.04em;
    }
    .cm-kv-row dd {
      color: var(--cm-fg-secondary);
      margin: 0;
      font-variant-numeric: tabular-nums;
    }
    .cm-kv-prov dd {
      color: var(--cm-fg-faint);
      font-size: 11px;
    }
    .cm-kv-prov dt {
      color: var(--cm-fg-faint);
    }
    .cm-kv-aside {
      color: var(--cm-fg-faint);
      font-size: 11px;
      margin-left: 4px;
    }
    /* Liquidity context — same visual register as significance (left bar marker,
       muted label, tabular metrics). Distinct from significance by the "liquidity"
       label so reader sees them as parallel verification blocks. */
    .cm-liquidity {
      margin: 0 0 8px 0;
      padding: 4px 0;
      font-family: var(--cm-font-mono);
      font-size: 11.5px;
      line-height: 1.55;
    }

    /* Significance sub-block — uniform "why this wire crossed the bar" panel.
       Sits above the atomic-claim KV rows. Tight, mono, with a leading vertical
       bar marker (matches subnav active-mark style). Tells the machine + reader
       the trigger/threshold/percentile/reason without scanning the body. */
    .cm-significance {
      margin: 0 0 10px 0;
      padding: 4px 0;
      background: transparent;
      font-family: var(--cm-font-mono);
      font-size: 11.5px;
      line-height: 1.55;
    }
    .cm-sig-label {
      color: var(--cm-fg-muted);
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 10.5px;
      font-weight: 700;
      margin-right: 12px;
    }
    .cm-sig-metric {
      color: var(--cm-fg-secondary);
      margin-right: 16px;
      font-variant-numeric: tabular-nums;
    }
    .cm-sig-aside {
      color: var(--cm-fg-faint);
      font-size: 10.5px;
      margin: 0 4px;
    }
    .cm-sig-reason {
      color: var(--cm-fg-secondary);
      margin-top: 4px;
      font-size: 11.5px;
    }

    /* abbr tooltip — hover reveals the tier definition. Native browser tooltip,
       no JS, screen-reader-friendly. Removes the default dotted underline so the
       inline [tier] label looks identical to the non-abbr version. */
    .cm-tier-abbr {
      text-decoration: none;
      border: 0;
      cursor: help;
    }

    /* Provenance legend strip — single-line slug-style glossary at the bottom of
       the page below the JSON block. Tight terminal aesthetic. Self-contained
       payload: humans printing to PDF or AI crawlers parsing only the HTML body
       both see the tier vocabulary inline without a secondary fetch. */
    .cm-prov-legend {
      margin-top: 14px;
      padding: 8px 12px;
      border: 1px solid var(--cm-border-hairline);
      background: var(--cm-bg-surface);
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      line-height: 1.6;
      color: var(--cm-fg-faint);
      letter-spacing: 0.02em;
      /* Flex-wrap so items break at clean boundaries instead of mid-sentence.
         Each item + its trailing · stays together via cm-prov-legend-item nowrap. */
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 0;
    }
    .cm-prov-legend-head {
      color: var(--cm-fg-muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      margin-right: 6px;
    }
    .cm-prov-legend-sep {
      color: var(--cm-border-rule);
      margin: 0 4px;
    }
    .cm-prov-legend-tag {
      color: var(--cm-fg-link);
      font-weight: 600;
    }
    .cm-prov-legend-item {
      white-space: nowrap;
    }
    .cm-prov-legend-link {
      color: var(--cm-fg-link);
      margin-left: 4px;
    }
    .cm-prov-legend-link:hover {
      color: var(--cm-fg-primary);
      text-decoration: underline;
    }

    /* Per-field provenance hint — bracketed inline label after the value.
       Dimmer color and smaller font so it labels the value without competing
       with it. Mediated-tier sources link out to the underlying URL. */
    .cm-prov-inline {
      color: var(--cm-fg-faint);
      font-size: 10.5px;
      margin-left: 10px;
      letter-spacing: 0.04em;
      white-space: normal;
    }
    .cm-prov-link {
      color: var(--cm-fg-faint);
      text-decoration: underline;
      text-decoration-color: var(--cm-border-rule);
    }
    .cm-prov-link:hover {
      color: var(--cm-fg-link);
      text-decoration-color: var(--cm-fg-link);
    }
    .cm-kv-tag {
      display: inline-block;
      padding: 1px 6px;
      background: var(--cm-bg-surface-alt);
      color: var(--cm-fg-link);
      font-size: 10.5px;
      text-transform: lowercase;
      letter-spacing: 0.04em;
      margin-right: 4px;
    }
    .cm-kv-id {
      color: var(--cm-fg-link);
      font-size: 11.5px;
      letter-spacing: 0.04em;
      margin: 0 4px;
    }
    .cm-kv-pass {
      color: var(--cm-positive);
      text-transform: lowercase;
      font-weight: 600;
    }
    .cm-kv-link {
      color: var(--cm-fg-link);
      word-break: break-all;
    }
    .cm-kv-link:hover { text-decoration: underline; }
    .cm-num {
      color: var(--cm-fg-primary);
      font-variant-numeric: tabular-nums;
    }
    .cm-num-emphasis {
      color: var(--cm-fg-primary);
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    /* Citation group */
    .cm-citation-group {
      margin-bottom: 20px;
    }
    .cm-citation-group:last-child { margin-bottom: 0; }
    .cm-citation-group-label {
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--cm-fg-muted);
      margin-bottom: 8px;
      padding-left: 16px;
    }

    /* Programmatic access — ported from /events/[slug] verbatim for sibling parity */
    .cm-section-machine .cm-section-summary { max-width: 720px; }
    .cm-endpoints-table {
      width: 100%;
      border-collapse: collapse;
      font-family: var(--cm-font-mono);
      font-size: 12px;
      background: var(--cm-bg-surface);
      border: 1px solid var(--cm-border-hairline);
      margin-bottom: 16px;
    }
    .cm-endpoints-table td {
      padding: 8px 12px;
      border-bottom: 1px solid var(--cm-border-hairline);
      vertical-align: middle;
    }
    .cm-endpoints-table tr:last-child td { border-bottom: 0; }
    .cm-endpoints-table td:not(:last-child) {
      border-right: 1px solid var(--cm-border-hairline);
    }
    .cm-fmt {
      font-family: var(--cm-font-mono);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: var(--cm-fg-primary);
      background: rgba(255, 255, 255, 0.03);
      width: 80px;
    }
    .cm-endpoint-url {
      font-family: var(--cm-font-mono);
      font-size: 11.5px;
      color: var(--cm-fg-secondary);
    }
