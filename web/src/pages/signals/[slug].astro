    /* ===== mobile (LinkedIn lands on wire detail) ===== */
    @media (max-width: 720px) {
      .cm-v2 { padding: 18px 14px 50px; box-sizing: border-box; overflow-wrap: break-word; }
      .cm-h1 { font-size: 18px; line-height: 1.3; }
      .cm-horizon { flex-direction: column; align-items: flex-start; flex-wrap: nowrap; gap: 4px; }
      .cm-horizon-pipe { display: none; }
      /* kv-rows: 3-col grid -> stacked label-over-value */
      .cm-kv-row, .cm-kv-wide .cm-kv-row { grid-template-columns: 1fr; gap: 0; margin-bottom: 7px; }
      .cm-kv-row dt { margin-bottom: 1px; }
      .cm-kv-link, .cm-prov-link { word-break: break-all; }
      .cm-v2 pre { overflow-x: auto; }
    }

    /* ===== mobile (~390px iPhone) — additive, desktop untouched =====
       (a) record meta strip wraps cleanly (reassert over the 720px rule for phones).
       (b) ATOMIC BRIEF key-value rows: fixed-width label column so every value lines
           up at the same left edge instead of floating at ragged positions. The
           tier-stamp (3rd grid col) drops to its own line under the value. */
    @media (max-width: 640px) {
      .cm-horizon { flex-direction: column; align-items: flex-start; flex-wrap: nowrap; gap: 4px; }
      .cm-horizon-pipe { display: none; }

      /* two-column grid: label fixed, value aligned; tier-stamp spans full row below */
      .cm-kv-row,
      .cm-kv-wide .cm-kv-row {
        grid-template-columns: 116px 1fr;
        column-gap: 12px;
        row-gap: 1px;
        margin-bottom: 8px;
        align-items: baseline;
      }
      .cm-kv-row dt {
        margin-bottom: 0;
        overflow-wrap: anywhere;
      }
      .cm-kv-row dd { min-width: 0; overflow-wrap: anywhere; }
      /* tier-stamp: out of the 3rd column onto its own full-width line, left-aligned
         under the value so it doesn't push the value off-edge */
      .cm-tier-stamp {
        grid-column: 1 / -1;
        text-align: left;
        padding-left: 116px;
      }

      /* PROGRAMMATIC-ACCESS table — URL column clipped on phones. Reflow each row to a
         stacked block: surface label, description, then the URL on its own line wrapping
         via overflow-wrap:anywhere so URLs are fully readable. */
      .cm-endpoints-table,
      .cm-endpoints-table tbody,
      .cm-endpoints-table tr,
      .cm-endpoints-table td {
        display: block;
        width: 100%;
        box-sizing: border-box;
      }
      .cm-endpoints-table tr {
        border-bottom: 1px solid var(--cm-border-hairline);
        padding: 8px 0;
      }
      .cm-endpoints-table tr:last-child { border-bottom: 0; }
      .cm-endpoints-table td {
        border: none !important;
        padding: 2px 12px;
      }
      .cm-endpoints-table td.cm-fmt {
        width: auto;
        display: inline-block;
        margin-bottom: 2px;
      }
      .cm-endpoint-url { overflow-wrap: anywhere; word-break: break-word; }
    }
  </style>

  <script is:inline>
    (function() {
      var subnavLinks = document.querySelectorAll('.cm-subnav-link');
      if (subnavLinks.length === 0) return;
      var sectionMap = {};
      subnavLinks.forEach(function(link) {
        var sectionId = link.getAttribute('data-section');
        var section = document.getElementById(sectionId);
        if (section) sectionMap[sectionId] = link;
      });
      var activate = function(sectionId) {
        subnavLinks.forEach(function(l) { l.classList.remove('cm-subnav-active'); });
        if (sectionMap[sectionId]) sectionMap[sectionId].classList.add('cm-subnav-active');
      };
      var observer = new IntersectionObserver(function(entries) {
        var visible = entries.filter(function(e) { return e.isIntersecting; });
        if (visible.length === 0) return;
        visible.sort(function(a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
        activate(visible[0].target.id);
      }, { rootMargin: '-120px 0px -60% 0px', threshold: 0 });
      Object.keys(sectionMap).forEach(function(id) {
        var section = document.getElementById(id);
        if (section) observer.observe(section);
      });
    })();
  </script>
