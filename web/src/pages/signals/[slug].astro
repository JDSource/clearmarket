    /* Scroll-margin offsets so anchor jumps land at the section header rather than
       halfway down. Matches /events/[slug] convention (~120px = sticky chrome height). */
    #briefs { scroll-margin-top: 120px; }
    #evaluation { scroll-margin-top: 120px; }
