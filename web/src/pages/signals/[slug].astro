                  {claim.lead_lag_minutes_kalshi != null && <div class="cm-kv-row"><dt>lead_lag_kalshi</dt><dd><span class="cm-num">{claim.lead_lag_minutes_kalshi >= 0 ? '+' : ''}{claim.lead_lag_minutes_kalshi}min</span> <span class="cm-kv-aside">{claim.lead_lag_minutes_kalshi < 0 ? 'before headline' : 'after headline'}</span></dd></div>}
