---
/* PREVIEW ROUTE — CM Signal page, telemetry-node primitive.
 * Inherits event-page chrome (Site.astro layout, sub-nav, horizon strip,
 * lowercase mono pattern). Body is typed atomic-claim fields with per-claim
 * provenance. No card chrome. No editorial brand watermarks. No prose bullets.
 *
 * Compare side-by-side with /events/fed-april-2026-rate-decision/ —
 * the two pages should look like siblings of one product.
 *
 * Field structure mirrors the canonical atomic-field telemetry mapping
 * locked 2026-05-22; fields tagged [schema_extension_pending] are not yet
 * in the signal content collection schema but render here so the layout
 * can be validated. Promote to real schema fields when the signal page
 * leaves preview. */

import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { displayTitle, composeTelemetry } from '../../lib/signal-display';
import '../../styles/tokens.css';
import { createHash } from 'node:crypto';

// Canonical-JSON serializer (deterministic key ordering) for the SHA-256 watermark.
// Two consumers that hash the same record must get the same digest regardless of
// the order keys happen to appear in the source. Recursive sort.
function canonicalize(value: any): string {
  if (value === null || typeof value !== 'object') return JSON.stringify(value);
  if (Array.isArray(value)) return '[' + value.map(canonicalize).join(',') + ']';
  const keys = Object.keys(value).sort();
  return '{' + keys.map((k) => JSON.stringify(k) + ':' + canonicalize(value[k])).join(',') + '}';
}

export async function getStaticPaths() {
  const signals = await getCollection('signals');
  return signals.map((signal) => ({
    params: { slug: signal.data.signal_slug },
    props: { signal },
  }));
}

const { signal } = Astro.props;
const data = signal.data;

// Tier definitions — short-form, used as <abbr title=...> tooltips on inline tier
// labels AND echoed in the JSON-LD cm:provenanceRegistry + REST JSON _provenance_registry.
// Full spec ships at /schema/provenance/v1 when build item #16 lands.
const tierDefs = {
  direct: 'Unaltered extraction from primary venue/source API (e.g., polymarket_clob_api, kalshi_api, BLS, FRED). Highest trust tier.',
  mediated: 'Information fetched via grounded agentic retrieval (e.g., perplexity_grounded). MUST carry source_url to the underlying primary source.',
  derived: 'Algorithmic computation from listed inputs. Chain only as fresh as the oldest input timestamp (see as_of).',
  editorial: 'Interpretive classification produced by a versioned LLM prompt template (prompts auditable in github.com/JDSource/clearmarket/prompts).',
};

// ----- per-field provenance hint renderer.
// Returns a bracketed inline hint showing tier · method · source · retrieved_at
// for any value field that carries a field_provenance entry. Pattern matches
// Marconi's atomic-claim-with-provenance frame + Terminalist's "preserve fragmentation"
// (we don't blend, we label each value with where it came from).
// Tiers: direct (venue API) / mediated (Perplexity → external) / derived (computed) / editorial (LLM/human).
// effectiveAsOf — for a given field, return the most-conservative timestamp:
// - if the field's provenance has retrieved_at directly, use it
// - if the field is derived from upstream inputs, walk them and return the OLDEST
//   (the chain is only as fresh as its weakest input). Recursive.
function effectiveAsOf(claim: any, fieldName: string): string | undefined {
  const fp = claim?.field_provenance?.[fieldName];
  if (!fp) return undefined;
  if (fp.retrieved_at) return fp.retrieved_at;
  if (fp.tier === 'derived' && fp.inputs?.length) {
    const inputTimes: string[] = [];
    for (const inp of fp.inputs) {
      // inputs may carry parentheticals like "poly_price (cm_marks_history)" —
      // strip to the bare field name before lookup
      const base = (inp.split(' ')[0] || '').replace(/[(),]/g, '');
      const t = effectiveAsOf(claim, base);
      if (t) inputTimes.push(t);
    }
    if (inputTimes.length) return inputTimes.sort()[0]; // oldest
  }
  return undefined;
}

function provBracket(claim: any, fieldName: string): { tier: string; rest: string; url?: string } | null {
  const fp = claim?.field_provenance?.[fieldName];
  if (!fp || !fp.tier) return null;
  const head: string[] = [];
  if (fp.method) head.push(fp.method);
  if (fp.source) head.push(fp.source);
  let rest = head.join(' → ');
  if (fp.inputs?.length) rest += ` ← ${fp.inputs.join(', ')}`;
  const ts = effectiveAsOf(claim, fieldName);
  if (ts) rest += ` · as_of ${ts}`;
  if (fp.note) rest += ` · ${fp.note}`;
  return { tier: fp.tier, rest, url: fp.source_url };
}

// ----- formatting helpers -----
function fmtPct(p: number | null | undefined): string {
  if (p == null) return '—';
  return `${(p * 100).toFixed(1)}%`;
}
function fmtVol(v: number | null | undefined): string {
  if (v == null) return '—';
  if (v >= 1e9) return `$${(v / 1e9).toFixed(2)}B`;
  if (v >= 1e6) return `$${(v / 1e6).toFixed(2)}M`;
  if (v >= 1e3) return `$${(v / 1e3).toFixed(1)}K`;
  return `$${v.toFixed(0)}`;
}
function fmtPp(left: number | null | undefined, right: number | null | undefined): string {
  if (left == null || right == null) return '—';
  return `${Math.abs(left - right) * 100}pp`;
}

// ----- title split: durable semantic anchor (indexed) + as-of telemetry (muted) -----
const titleText = displayTitle(data);
const telemetryText = composeTelemetry(data);

// ----- derived spread (for Bucket A) -----
const primary = data.primary_market;
const related = data.related_markets?.[0] ?? null;
// Read the related-venue price directly from the structured field (schema: related_markets[].current_price).
// Replaces the old headline-regex scrape — telemetry now lives in fields, never parsed out of the title.
const leftPrice = primary.current_price;
const rightPrice = related?.current_price ?? null;
const spreadPp = (leftPrice != null && rightPrice != null)
  ? Math.abs(leftPrice - rightPrice) * 100
  : null;

// ----- 30d historical boundary (mocked for demo; schema extension) -----
const priorMaxPp = 7.2;
const priorMaxDate = '2026-05-04';
const deltaPp = spreadPp != null ? spreadPp - priorMaxPp : null;

// ----- benchmark (Bucket B) — read from the structured benchmark_divergence claim,
// NOT a label regex or a hardcoded mock. The claim is the authoritative origin for
// benchmark_source / benchmark_source_url / benchmark_value; trust it, don't re-guess.
// (Fixed 2026-05-25: prior code regex-matched /fedwatch|cme/ over source labels, which
// mis-cited the benchmark on every non-Fed-rate wire, and hardcoded benchmarkValue=0.36.)
const benchmarkClaim = data.atomic_claims?.find((c: any) => c.type === 'benchmark_divergence') ?? null;
const benchmarkSource = benchmarkClaim?.benchmark_source_url
  ? { label: benchmarkClaim.benchmark_source ?? 'benchmark', url: benchmarkClaim.benchmark_source_url }
  : null;
const benchmarkValue: number | null = benchmarkClaim?.benchmark_value ?? null;
const polyOffsetPp = (leftPrice != null && benchmarkValue != null) ? (leftPrice - benchmarkValue) * 100 : null;
const kalshiOffsetPp = (rightPrice != null && benchmarkValue != null) ? (rightPrice - benchmarkValue) * 100 : null;

// ----- velocity (mocked for demo; bullets carry this in prose form) -----
const polyVolWow = 0.43;
const kalshiVolWow = -0.08;

// ----- evaluation — detection_path aware -----
// Cross-venue + benchmark-drift wires pass through an LLM judge gate ("is this divergence
// worth surfacing?"). News-cycle wires do NOT — per PRD §5.1 news-cycle is
// deterministic-floor: top news stories scanned → mechanical entity match →
// publish. No editorial gate. Coverage is the product. So judge fields are null for those.
const isNewsCycle = data.detection_path === 'news_cycle';
const isBenchmarkDrift = data.detection_path === 'benchmark_drift';
const isVolumeSpike = data.detection_path === 'volume_spike';
// judge_engine uses llm_judge_ prefix so the reader knows it's an LLM without
// being locked to a specific model name. Specific model + version lives in the
// changelog at /schema/judge/v1 (when shipped).
const judgeEngine = isNewsCycle
  ? 'none — deterministic news-cycle scan'
  : 'llm_judge_cm_signal_v1';
const judgeVerdict = isNewsCycle ? 'auto_published' : 'wire_eligible';
const judgeConfidence: number | null = isNewsCycle
  ? null
  : (isBenchmarkDrift ? data.judge_confidence ?? 0.78
     : isVolumeSpike ? data.judge_confidence ?? 0.81
     : data.judge_confidence ?? 0.84);
const promptTemplate = data.prompt_template ?? (
  isNewsCycle ? 'news_cycle_v1'
  : isBenchmarkDrift ? 'benchmark_drift_v1'
  : isVolumeSpike ? 'volume_spike_v1'
  : 'cross_venue_v1'
);
const matchMethod = isNewsCycle ? 'entity_slug_match (mechanical)' : null;

// ----- citation graph -----
const eventHref = `/events/${data.event_slug}/`;
// Kalshi has a stable by-ticker market URL; Polymarket has no public by-conditionId
// page (the conditionId path 404s), so we don't emit a deep link that breaks — we
// show the venue + id as text instead. Avoids a dead link on the cross-venue claim.
const venueHref = (m: any) =>
  m && m.platform === 'kalshi' ? `https://kalshi.com/markets/${m.platform_market_id}` : null;
const venueLabel = (m: any) => (m ? `${m.platform} · ${m.platform_market_id}` : null);
const venueAUrl = venueHref(primary);
const venueBUrl = venueHref(related);
const venueALabel = venueLabel(primary);
const venueBLabel = venueLabel(related);

// ----- canonical URLs + JSON-LD -----
const canonicalURL = `https://clearmarket.fyi/signals/${data.signal_slug}/`;
const jsonURL = `https://clearmarket.fyi/signals/${data.signal_slug}.json`;

// ----- helpers to map per-field provenance + significance into JSON-LD =====
// Marconi/Terminalist standard: the structured-data layer must carry the same
// provenance the visible HTML shows. Crawlers reading only <script type="application/ld+json">
// (and there are many) should see tier/method/source/inputs per value.
//
// PROV-O mapping:
//   direct    → prov:wasGeneratedBy (the API/source-of-truth produced it)
//   mediated  → prov:wasDerivedFrom (linked to underlying source URL)
//   derived   → prov:wasDerivedFrom (linked to upstream field IDs)
//   editorial → prov:wasAttributedTo (the LLM/human agent responsible)
function unitFor(fieldName: string): string | undefined {
  if (fieldName.endsWith('_pp')) return 'pp';
  if (fieldName.endsWith('_usd')) return 'USD';
  if (fieldName.endsWith('_ratio') || fieldName.endsWith('_vs_baseline')) return 'ratio';
  if (fieldName.startsWith('corr_') || fieldName === 'percentile_30d') return 'index';
  if (fieldName.endsWith('_at') || fieldName.endsWith('_date')) return 'iso8601';
  if (fieldName.endsWith('_minutes_poly') || fieldName.endsWith('_minutes_kalshi')) return 'minutes';
  return undefined;
}
function buildVariablesMeasured(claims: any[]) {
  const vars: any[] = [];
  for (const claim of claims) {
    const fp = claim.field_provenance ?? {};
    for (const fieldName of Object.keys(fp)) {
      const value = claim[fieldName];
      if (value === undefined || value === null) continue;
      const prov = fp[fieldName];
      const pv: any = {
        '@type': 'PropertyValue',
        '@id': `#${claim.type}/${fieldName}`,
        propertyID: fieldName,
        name: fieldName,
        'cm:claimType': claim.type,
        'cm:tier': prov.tier,
        'cm:method': prov.method,
      };
      if (typeof value === 'number' || typeof value === 'string') {
        pv.value = value;
      } else if (typeof value === 'object') {
        pv.valueReference = value;
      }
      const unit = unitFor(fieldName);
      if (unit) pv.unitText = unit;
      if (prov.source) pv['cm:source'] = prov.source;
      if (prov.source_url) pv['cm:sourceUrl'] = prov.source_url;
      if (prov.retrieved_at) pv['cm:retrievedAt'] = prov.retrieved_at;
      if (prov.note) pv['cm:note'] = prov.note;
      if (prov.inputs?.length) pv['cm:inputs'] = prov.inputs;
      // PROV-O mapping
      if (prov.tier === 'mediated' && prov.source_url) {
        pv['prov:wasDerivedFrom'] = { '@id': prov.source_url, 'cm:source': prov.source };
      } else if (prov.tier === 'derived' && prov.inputs?.length) {
        pv['prov:wasDerivedFrom'] = prov.inputs.map((inp: string) => ({ '@id': `#${claim.type}/${inp}` }));
      } else if (prov.tier === 'direct') {
        pv['prov:wasGeneratedBy'] = {
          '@type': 'prov:Activity',
          'prov:atTime': prov.retrieved_at,
          'cm:method': prov.method,
        };
      } else if (prov.tier === 'editorial') {
        pv['prov:wasAttributedTo'] = { '@type': 'prov:Agent', name: prov.method };
      }
      vars.push(pv);
    }
  }
  return vars;
}
function buildAtomicClaims(claims: any[]) {
  return claims.map((claim: any) => {
    const fp = claim.field_provenance ?? {};
    const entry: any = {
      '@type': 'cm:AtomicClaim',
      'cm:type': claim.type,
      'cm:fields': Object.keys(fp),
    };
    if (claim.significance) {
      entry['cm:significance'] = {
        threshold: claim.significance.threshold,
        thresholdUnit: claim.significance.threshold_unit,
        current: claim.significance.current,
        passed: claim.significance.passed,
        percentile30d: claim.significance.percentile_30d,
        reason: claim.significance.reason,
      };
    }
    return entry;
  });
}

const datasetJsonLd = {
  '@context': [
    'https://schema.org',
    {
      'cm': 'https://clearmarket.fyi/schema/v1#',
      'prov': 'http://www.w3.org/ns/prov#',
    },
  ],
  '@type': 'Dataset',
  '@id': canonicalURL,
  name: titleText,
  description: `CM Signal wire item: ${data.category_tag.toLowerCase().replace(/_/g, ' ')} detection on event ${data.event_id}`,
  identifier: data.signal_id,
  url: canonicalURL,
  keywords: [data.category_tag, ...(data.secondary_tags ?? [])],
  datePublished: data.published_at,
  variableMeasured: buildVariablesMeasured(data.atomic_claims ?? []),
  'cm:atomicClaims': buildAtomicClaims(data.atomic_claims ?? []),
  measurementTechnique: 'Mechanical detection on cross-venue + benchmark + news-cycle + volume axes; LLM judge classification (except news-cycle which is deterministic-floor). Per-field provenance with four-tier model (direct/mediated/derived/editorial) at variableMeasured; per-claim significance at cm:atomicClaims.',
  creator: { '@type': 'Organization', name: 'ClearMarket', url: 'https://clearmarket.fyi' },
  license: 'https://creativecommons.org/licenses/by/4.0/',
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${jsonURL}` },
    { '@type': 'DataDownload', encodingFormat: 'text/html', contentUrl: canonicalURL },
  ],
  isBasedOn: { '@type': 'Dataset', '@id': `https://clearmarket.fyi/events/${data.event_slug}/` },
};

const claimReviewJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ClaimReview',
  url: canonicalURL,
  datePublished: data.published_at,
  claimReviewed: titleText,
  reviewBody: data.bullets.join(' '),
  author: { '@type': 'Organization', name: 'ClearMarket' },
  itemReviewed: { '@type': 'Dataset', '@id': `https://clearmarket.fyi/events/${data.event_slug}/` },
};

// ----- visible JSON record (round-trip check for the four-format rule) =====
// Mirrors the on-page atomic claims exactly — both surfaces read from
// data.atomic_claims. Same payload, different presentation.
const machineRecord = {
  $schema: 'https://clearmarket.fyi/schema/signal/v1.json',
  provenance_version: '0.2.0',
  record_id: data.signal_id,
  published_at: data.published_at,
  detection: data.detection_path,
  category_tag: data.category_tag,
  secondary_tags: data.secondary_tags ?? [],
  pre_news_classification: data.pre_news_classification,
  target_event_id: data.event_id,
  target_event_slug: data.event_slug,
  event_question: data.event_question,
  bullets: data.bullets,
  atomic_claims: data.atomic_claims ?? [],
  evaluation: {
    judge_engine: judgeEngine,
    judge_verdict: judgeVerdict,
    judge_confidence: judgeConfidence,
    prompt_template: promptTemplate,
  },
  citations: {
    internal: { cm_event: `/events/${data.event_slug}/`, related: data.linked_event_ids ?? [] },
    external: {
      venue_a: venueAUrl,
      venue_b: venueBUrl,
      benchmark: benchmarkSource?.url ?? null,
    },
  },
  sources: data.sources ?? [],
  field_provenance: data.field_provenance ?? null,
};

// SHA-256 watermark of the canonical record. Lets downstream consumers verify the
// wire wasn't modified post-publication. Hash is computed AFTER the record is built
// from the immutable specimen frontmatter; deterministic key ordering via canonicalize().
const canonicalRecord = canonicalize(machineRecord);
const signature = 'sha256-' + createHash('sha256').update(canonicalRecord).digest('hex');

// Patch the signature into the dataset JSON-LD — done here rather than in the
// datasetJsonLd literal above because the signature can only be computed AFTER
// machineRecord is built (and machineRecord depends on derived values from earlier
// in the file). Order matters; don't try to inline this back into the literal.
(datasetJsonLd as any)['cm:signature'] = signature;
(datasetJsonLd as any)['cm:signatureAlgorithm'] = 'sha256-canonicalJSON';
// Inline provenance registry so AI crawlers don't need a secondary HTTP fetch to
// resolve tier vocabulary. Canonical URL also exposed for the full DefinedTermSet.
(datasetJsonLd as any)['cm:provenanceRegistry'] = tierDefs;
(datasetJsonLd as any)['cm:provenanceCanonical'] = 'https://clearmarket.fyi/schema/provenance/v1';

function colorizeJson(obj: unknown): string {
  return JSON.stringify(obj, null, 2)
    .replace(/("[^"]+")\s*:/g, '<span class="t-key">$1</span>:')
    .replace(/: (".*?")/g, ': <span class="t-str">$1</span>')
    .replace(/: (-?\d+\.?\d*)/g, ': <span class="t-num">$1</span>')
    .replace(/: (true|false|null)/g, ': <span class="t-num">$1</span>');
}

const categoryDisplay = data.category_tag.toLowerCase().replace(/_/g, '-');
---

<Site title={`${titleText} · CM Signal`} description={`Atomic-claim wire item for ${data.event_question}`} canonical={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(datasetJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(claimReviewJsonLd)} slot="head" />

  <nav class="cm-subnav" aria-label="Signal sections" slot="subnav">
    <a href="#briefs" data-section="briefs" class="cm-subnav-link cm-subnav-active"><span class="cm-active-mark">&#9614;</span>Briefs</a>
    <a href="#evaluation" data-section="evaluation" class="cm-subnav-link"><span class="cm-active-mark">&#9614;</span>Evaluation</a>
    <a href="#citations" data-section="citations" class="cm-subnav-link"><span class="cm-active-mark">&#9614;</span>Citations</a>
    <a href="#api" data-section="api" class="cm-subnav-link"><span class="cm-active-mark">&#9614;</span>API</a>
    <span class="cm-subnav-snapshot">published <span class="cm-dot-positive">&#9679;</span> {data.published_at.slice(0, 10)}</span>
  </nav>

  <article class="cm-v2" data-cm-signal-id={data.signal_id}>

    <nav class="cm-crumb" aria-label="Breadcrumb">
      <a href="/signals/">&larr; CM Signal &middot; all wires</a>
    </nav>

    <h1 class="cm-h1" data-cm-field="semantic_title">{titleText}</h1>
    {telemetryText && <div class="cm-h1-telem" data-cm-field="telemetry">{telemetryText}</div>}

    {/* Internal taxonomy fields (bucket, detection_path, pre_news_classification)
        live in JSON-LD + the .json endpoint only — they're not reader-facing.
        Chrome shows: canonical record ID, human-readable category, event back-link
        (closes the citation loop), and published timestamp. */}
    <div class="cm-horizon">
      <span class="cm-horizon-token">
        <span class="cm-horizon-label">record:</span>
        <span class="cm-horizon-value" data-cm-field="signal_id">{data.signal_id}</span>
      </span>
      <span class="cm-horizon-pipe">|</span>
      <span class="cm-horizon-token">
        <span class="cm-horizon-label">category:</span>
        <span class="cm-horizon-value" data-cm-field="category_tag">{categoryDisplay}</span>
      </span>
      <span class="cm-horizon-pipe">|</span>
      <span class="cm-horizon-token">
        <span class="cm-horizon-label">target:</span>
        <a class="cm-horizon-value cm-horizon-link" href={eventHref} data-cm-field="event_id">{data.event_id}</a>
      </span>
      <span class="cm-horizon-pipe">|</span>
      <span class="cm-horizon-token">
        <span class="cm-horizon-label">published:</span>
        <span class="cm-horizon-value" data-cm-field="published_at">{data.published_at.slice(0, 10)}</span>
      </span>
    </div>

    {/* ===== WIRE BODY — the 5-bullet prose summary (canonical PRD §4 + §6.5.5) =====
         Narrative layer. LinkedIn-shareable. Sits above the typed atomic claims so
         a first-time reader gets the human-readable read, then drills into the
         structured fields below. The bullets here populate JSON-LD ClaimReview.reviewBody. */}
    <section class="cm-wire-body" data-cm-field="bullets">
      <div class="cm-callout-label">{data.bullets.length}-bullet brief <span class="cm-callout-tag">| narrative</span></div>
      <ul class="cm-wire-bullets">
        {data.bullets.map((b: string) => <li>{b}</li>)}
      </ul>
    </section>

    {/* ===== ATOMIC CLAIMS — data-driven, rendered per claim.type =====
         Each bucket carries 2 claims (the measurement + the context that explains it).
         Bucket A: cross_venue_spread + divergence_context
         Bucket B: benchmark_wedge + wedge_context
         Bucket C: news_event + pm_response */}
    <section id="briefs" class="cm-section">
      <div class="cm-section-h">atomic briefs <span class="cm-section-tag">| structured for retrieval</span></div>

      {(data.atomic_claims ?? []).map((claim: any, idx: number) => {
        const num = String(idx + 1).padStart(2, '0');
        return (
          <div class="cm-claim" data-cm-claim-type={claim.type}>
            <div class="cm-claim-head">
              <span class="cm-claim-num">[{num}]</span>
              <span class="cm-claim-type">{claim.type}</span>
            </div>
            {/* Liquidity context — verification variable for price-move claims.
                A 16pp move on $5K of volume reads differently from the same move
                on $5M. Rendered as a compact strip so consumers don't have to
                scroll to the wire envelope for the signal-vs-noise check. */}
            {claim.liquidity_context && (
              <div class="cm-liquidity">
                <span class="cm-sig-label">liquidity</span>
                {claim.liquidity_context.poly_vol_24h_usd != null && (
                  <span class="cm-sig-metric"><span class="cm-sig-aside">poly_vol_24h:</span> <span class="cm-num">{fmtVol(claim.liquidity_context.poly_vol_24h_usd)}</span></span>
                )}
                {claim.liquidity_context.kalshi_vol_24h_usd != null && (
                  <span class="cm-sig-metric"><span class="cm-sig-aside">kalshi_vol_24h:</span> <span class="cm-num">{fmtVol(claim.liquidity_context.kalshi_vol_24h_usd)}</span></span>
                )}
                {claim.liquidity_context.poly_vol_7d_usd != null && (
                  <span class="cm-sig-metric"><span class="cm-sig-aside">poly_vol_7d:</span> <span class="cm-num">{fmtVol(claim.liquidity_context.poly_vol_7d_usd)}</span></span>
                )}
                {claim.liquidity_context.kalshi_vol_7d_usd != null && (
                  <span class="cm-sig-metric"><span class="cm-sig-aside">kalshi_vol_7d:</span> <span class="cm-num">{fmtVol(claim.liquidity_context.kalshi_vol_7d_usd)}</span></span>
                )}
                {claim.liquidity_context.poly_open_interest_usd != null && (
                  <span class="cm-sig-metric"><span class="cm-sig-aside">poly_oi:</span> <span class="cm-num">{fmtVol(claim.liquidity_context.poly_open_interest_usd)}</span></span>
                )}
                {claim.liquidity_context.depth_to_100bp_usd != null && (
                  <span class="cm-sig-metric"><span class="cm-sig-aside">depth_100bp:</span> <span class="cm-num">{fmtVol(claim.liquidity_context.depth_to_100bp_usd)}</span></span>
                )}
              </div>
            )}

            {/* Significance sub-block — "why this wire crossed the bar."
                Uniform across main claims regardless of wire type. Machine reads
                claim.significance for the standard "is this important + why" signal
                without having to know per-type semantics. */}
            {claim.significance && (
              <div class="cm-significance" data-cm-significance="true">
                <span class="cm-sig-label">significance</span>
