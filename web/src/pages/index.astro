---
import Base from '../layouts/Base.astro';

import { getCollection } from 'astro:content';
import { getAllEvents } from '../lib/universe';
import { displayTitle, composeTelemetry, dedupeActiveWires } from '../lib/signal-display';

// Live event count from the same universe the /events/ index renders — never hardcode.
const eventCount = getAllEvents().length;

// Latest signals pulled live from the content collection at build time. The homepage
// streams the actual wire log (same records as /signals/), truncated to the most recent few.
const latestSignals = dedupeActiveWires(await getCollection('signals'))
  .sort((a, b) => new Date(b.data.published_at).getTime() - new Date(a.data.published_at).getTime())
  .slice(0, 5);

function typeLabel(dp: string): string {
  const m: Record<string, string> = {
    cross_venue_divergence: 'cross-venue',
    benchmark_drift: 'benchmark-drift',
    news_cycle: 'news-cycle',
    volume_spike: 'volume-spike',
  };
  return m[dp] ?? dp;
}

function fmtFeedTime(iso: string): string {
  return new Date(iso).toLocaleString('en-US', {
    month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false,
  });
}

function venueCodes(s: any): string {
  const code = (p: string) => (p === 'polymarket' ? 'POLY' : p === 'kalshi' ? 'KAL' : p.slice(0, 4).toUpperCase());
  const codes: string[] = [];
  if (s.data.primary_market?.platform) codes.push(code(s.data.primary_market.platform));
  for (const m of s.data.related_markets ?? []) {
    const c = code(m.platform);
    if (!codes.includes(c)) codes.push(c);
  }
  return codes.join('·');
}

// Hero "machine view" JSON. A CM events-table row.
// Real values from samples/fed-apr-2026/specimen.json in the repo.
// This is the DATA layer (CM). The wire briefs below are the EDITORIAL layer (CM Signal).
const schemaJson = `{
  <span class="t-key">"event_id"</span>:           <span class="t-id">"CM-EVT-CYQ4MMGJN4"</span>,
  <span class="t-key">"slug"</span>:               <span class="t-str">"fed-april-2026-rate-decision"</span>,
  <span class="t-key">"category"</span>:           <span class="t-str">"macro"</span>,
  <span class="t-key">"tags"</span>: [<span class="t-str">"fed-rate-decisions"</span>, <span class="t-str">"fomc"</span>, <span class="t-str">"monetary-policy"</span>],
  <span class="t-key">"primary_market_id"</span>:  <span class="t-id">"CM-MKT-001013"</span>,
  <span class="t-key">"catalyst_dates"</span>: [
    { <span class="t-key">"date"</span>: <span class="t-num">"2026-04-29"</span>, <span class="t-key">"event"</span>: <span class="t-str">"FOMC meeting Day 1"</span> },
    { <span class="t-key">"date"</span>: <span class="t-num">"2026-04-30"</span>, <span class="t-key">"event"</span>: <span class="t-str">"FOMC statement + presser"</span> }
  ],
  <span class="t-key">"venues_covered"</span>:     [<span class="t-str">"kalshi"</span>, <span class="t-str">"polymarket"</span>],
  <span class="t-key">"cross_platform_link"</span>: {
    <span class="t-key">"kalshi"</span>:     { <span class="t-key">"market_count"</span>: <span class="t-num">11</span> },
    <span class="t-key">"polymarket"</span>: { <span class="t-key">"market_count"</span>: <span class="t-num">4</span> }
  },
  <span class="t-key">"resolution"</span>: {
    <span class="t-key">"source_name"</span>:  <span class="t-src">"Federal Reserve Board of Governors"</span>,
    <span class="t-key">"source_type"</span>:  <span class="t-src">"central_bank"</span>,
    <span class="t-key">"mechanism"</span>:    <span class="t-str">"deterministic"</span>
  },
  <span class="t-key">"field_provenance"</span>: {
    <span class="t-key">"tags"</span>:                <span class="t-prov">"clearmarket_editorial"</span>,
    <span class="t-key">"cross_platform_link"</span>: <span class="t-prov">"derived"</span>
  }
}`;
---
<Base title="ClearMarket: Reference layer for prediction markets" description="Reference data layer for prediction markets. Events linked across venues with the catalysts that move them. ClearMarket Signal is the daily wire built on it." ogTitle="The reference layer for prediction markets" ogDescription="Every prediction-market event, linked across Kalshi and Polymarket, graded for resolution clarity, and tagged with the catalysts that move it." bare>
  <div class="va">
    <div class="va-hero">
      <header class="va-head">
        <a class="va-brand" href="/">
          <span class="va-mark">CM</span>
          <span class="va-wordmark">ClearMarket</span>
        </a>
        <nav>
          <a class="va-nav-product" href="/events/">CM Data</a>
          <a class="va-nav-product" href="/signals/">CM Signal</a>
          <span class="va-nav-sep" aria-hidden="true">·</span>
          <a href="/methodology/">Methodology</a>
          <a href="https://github.com/JDSource/clearmarket">GitHub</a>
          <a href="mailto:hello@clearmarket.fyi">Contact</a>
        </nav>
      </header>

      <div class="va-hero-grid">
        <div class="va-hero-text">
          <div class="va-eyebrow">API · MCP · DAILY WIRE</div>
          <h1>
            the reference layer for<br/>
            <em>prediction markets.</em>
          </h1>
          <p class="va-sub">Read by desks. Queried by agents.</p>
          <p class="va-lede">
            Graded resolutions · Cross-venue linked · Catalysts tagged
          </p>
          <form class="va-hero-search" action="/events/" method="get" role="search">
            <span class="va-hero-search-prompt" aria-hidden="true">&gt;</span>
            <input
              class="va-hero-search-input"
              type="text"
              name="q"
              autocomplete="off"
              spellcheck="false"
              aria-label="Search the event universe"
              placeholder="SEARCH UNIVERSE — FED, ISRAEL, RECESSION, BITCOIN…"
            />
            <button class="va-hero-search-go" type="submit" aria-label="Search">↵</button>
          </form>
          <div class="va-hero-search-sub">
            <a class="va-hero-count" href="/events/">{eventCount.toLocaleString()} events</a> · cross-venue linked · graded resolutions
          </div>

          <div class="va-cta" role="group" aria-label="Product surfaces">
            <a href="/api/#rest" class="va-btn va-btn-secondary" target="_blank" rel="noopener">[ FREE API&nbsp;→ ]</a>
            <a href="/api/#mcp" class="va-btn va-btn-secondary" target="_blank" rel="noopener">[ FREE MCP&nbsp;→ ]</a>
            <a href="/signals/" class="va-btn va-btn-secondary">[ DAILY WIRE&nbsp;→ ]</a>
          </div>
        </div>

        <aside class="va-hero-schema" id="data" aria-label="Example CM events row">
          <div class="va-schema-tab">
            <span class="va-schema-method">GET</span>
            <span class="va-schema-endpoint">/events/fed-april-2026-rate-decision</span>
            <span class="va-schema-status">
              <span class="va-schema-dot" aria-hidden="true"></span>
              <span class="va-schema-status-label">live</span>
            </span>
          </div>
          <pre class="va-schema-code"><code set:html={schemaJson}></code></pre>
        </aside>
      </div>
    </div>

    <section class="va-wires" id="wires">
      <div class="va-signal-header">
        <div class="va-signal-intro">
          <div class="va-signal-eyebrow">CLEARMARKET <span class="va-signal-mark">SIGNAL</span></div>
          <h2 class="va-signal-title">the intelligence layer.</h2>
          <p class="va-signal-tagline">Prediction markets turn live opinion into a price. CM Signal flags where those prices diverge: from each other, from benchmarks, from the news, or on unusual volume.<br/>Published daily.</p>
        </div>
      </div>

      <div class="va-feed">
        <div class="va-feed-h">latest automated alerts <span class="va-feed-h-tag">· system feed</span></div>
        <table class="va-ledger">
          <tbody>
            {latestSignals.map((s) => (
              <tr class="va-ledger-row">
                <td class="va-l-time">{fmtFeedTime(s.data.published_at)}</td>
                <td class="va-l-id">{s.data.signal_id}</td>
                <td class={`va-l-type va-type-${s.data.detection_path}`}>{typeLabel(s.data.detection_path).toUpperCase()}</td>
                <td class="va-l-head"><a href={`/signals/${s.data.signal_slug}/`}>{displayTitle(s.data)}</a>{composeTelemetry(s.data) && <span class="va-l-telem">{composeTelemetry(s.data)}</span>}</td>
                <td class="va-l-venues">{venueCodes(s)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="va-feed-foot">
          <a href="/signals/">View all active wires →</a>
          <a href="/api/">Ingest via REST API →</a>
        </div>
      </div>
    </section>

    <footer class="va-foot">
      <div class="va-foot-row">
        <a href="/signals/">Signals</a>
        <a href="/api/">API</a>
        <a href="/api/">MCP</a>
        <a href="/methodology/">Methodology</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="https://github.com/JDSource/clearmarket">GitHub</a>
        <a href="mailto:hello@clearmarket.fyi">hello@clearmarket.fyi</a>
      </div>
      <div class="va-foot-mono">
        Atomic claims · JSON-LD · MCP · v0.2.0
      </div>
    </footer>
  </div>

  <style>
    .va {
      --va-bg: #0e1014;
      --va-bg-2: #14181d;
      --va-surface: #1a1e25;
      --va-fg: #e6e8eb;
      --va-fg-muted: #aab0b8;
      --va-fg-faint: #6c727a;
      --va-border: #232830;
      --va-rule: #1d2128;
      --va-accent: #76b8ff;
      --va-up: #6fdd9d;
      --va-down: #e08272;
      --va-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      --va-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--va-bg);
      color: var(--va-fg);
      font-family: var(--va-sans);
      min-height: 100vh;
      margin: -48px -24px -96px;
      padding: 0;
    }
    .va a { color: inherit; }

    /* HERO */
    .va-hero {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      background:
        radial-gradient(ellipse 80% 60% at 78% 25%, rgba(118,184,255,0.07), transparent 60%),
        radial-gradient(ellipse 60% 50% at 18% 80%, rgba(118,184,255,0.025), transparent 60%);
    }

    .va-head {
      max-width: 1280px;
      margin: 0 auto;
      padding: 28px 40px;
      display: flex; justify-content: space-between; align-items: center;
      position: relative; z-index: 2;
    }
    .va-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .va-mark {
      width: 28px; height: 28px;
      background: var(--va-fg); color: var(--va-bg);
      font-family: var(--va-mono); font-size: 10.5px; font-weight: 700;
      display: inline-flex; align-items: center; justify-content: center;
      border-radius: 2px; letter-spacing: 0.04em;
    }
    .va-wordmark {
      font-family: var(--va-mono);
      font-size: 14px; font-weight: 600;
      letter-spacing: 0.04em; color: var(--va-accent);
    }
    .va-head nav { display: flex; gap: 22px; align-items: center; }
    .va-head nav a {
      font-family: var(--va-mono); font-size: 11.5px;
      color: var(--va-fg-muted); text-decoration: none;
      letter-spacing: 0.04em;
    }
    .va-head nav a:hover { color: var(--va-fg); }
    .va-nav-product {
      color: var(--va-accent) !important;
      font-weight: 600;
    }
    .va-nav-sep {
      font-family: var(--va-mono);
      font-size: 11.5px;
      color: var(--va-fg-faint);
      letter-spacing: 0.04em;
    }
    .va-cta-mini {
      border: 1px solid var(--va-border);
      padding: 6px 12px; border-radius: 2px;
    }
    .va-cta-mini:hover { border-color: var(--va-fg); }

    .va-hero-grid {
      max-width: 1280px;
      margin: 0 auto;
      padding: 32px 40px 24px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      gap: 56px;
      align-items: start;
      position: relative; z-index: 1;
    }
    .va-hero-text { max-width: 580px; }
    .va-eyebrow {
      font-family: var(--va-mono);
      font-size: 11.5px;
      letter-spacing: 0.16em;
      color: var(--va-fg-muted);
      margin-bottom: 20px;
      font-weight: 500;
    }
    .va-hero-text h1 {
      font-family: var(--va-mono);
      font-size: clamp(26px, 3.2vw, 40px);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin: 0 0 22px;
      color: var(--va-fg);
      text-transform: lowercase;
    }
    .va-hero-text h1 em {
      font-style: normal;
    }
    .va-sub {
      font-family: var(--va-mono);
      font-size: 14px;
      color: var(--va-accent);
      letter-spacing: 0.02em;
      margin: 0 0 28px;
      font-weight: 500;
    }
    .va-lede {
      font-family: var(--va-sans);
      font-size: 18px;
      line-height: 1.6;
      color: var(--va-fg-muted);
      max-width: 560px;
      margin: 0 0 36px;
      font-weight: 400;
    }
    /* HERO SEARCH — the human door. Terminal-prompt field, accent border at rest,
       crisp white on focus (no soft glow), matching the /events/ + nav search treatment. */
    .va-hero-search {
      display: flex;
      align-items: stretch;
      gap: 0;
      max-width: 560px;
      margin: 0 0 16px;
      border: 1px solid var(--va-accent);
      background: var(--va-bg-2);
      transition: border-color .12s ease;
    }
    .va-hero-search:focus-within { border-color: var(--va-fg); }
    .va-hero-search-prompt {
      display: inline-flex; align-items: center;
      padding: 0 10px 0 14px;
      font-family: var(--va-mono); font-size: 14px; font-weight: 700;
      color: var(--va-accent);
      user-select: none;
    }
    .va-hero-search-input {
      flex: 1; min-width: 0;
      background: transparent; border: 0; outline: 0;
      font-family: var(--va-mono); font-size: 13.5px;
      color: var(--va-fg);
      padding: 13px 8px 13px 0;
      letter-spacing: 0.01em;
    }
    .va-hero-search-input::placeholder { color: var(--va-fg-faint); }
    /* Unboxed: no fill, no divider — a low-contrast carriage-return macro that
       brightens to accent on hover/focus. Keyboard-first terminal language. */
    .va-hero-search-go {
      flex: none;
      background: transparent; border: 0;
      font-family: var(--va-mono); font-size: 15px; font-weight: 400;
      color: var(--va-fg-faint);
      padding: 0 14px;
      cursor: pointer;
      transition: color .12s ease;
    }
    .va-hero-search-go:hover { color: var(--va-accent); }
    .va-hero-search:focus-within .va-hero-search-go { color: var(--va-fg-muted); }
    .va-hero-search-sub {
      font-family: var(--va-mono); font-size: 10.5px;
      color: var(--va-fg-faint); letter-spacing: 0.08em;
      text-transform: uppercase;
      margin: 14px 0 34px;
    }
    .va-hero-count { color: var(--va-fg-muted); font-weight: 600; text-decoration: none; }
    .va-hero-count:hover { color: var(--va-accent); text-decoration: underline; }

    .va-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 32px; }
    .va-btn {
      display: inline-flex; align-items: center;
      font-family: var(--va-mono); font-size: 12.5px;
      padding: 14px 24px;
      border-radius: 0;
      text-decoration: none;
      letter-spacing: 0.04em;
      border: 1px solid transparent;
      transition: transform .12s ease, border-color .12s ease, background .12s ease, box-shadow .12s ease, color .12s ease;
    }
    /* Primary: institutional sheen — gentle vertical gradient + a 1px inset top highlight
       (reads like a physical key, not a SaaS bubble). Accent-bordered, subtle lift on hover. */
    .va a.va-btn-primary {
      background: linear-gradient(180deg, #8cc4ff 0%, var(--va-accent) 100%);
      color: #08111c;
      border: 1px solid #9fccff;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.28);
      font-weight: 600;
    }
    .va a.va-btn-primary:hover {
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.4), 0 0 0 1px var(--va-accent);
      transform: translateY(-1px);
    }
    /* Secondary: a real surface with a visible outline (was near-invisible). Accent on hover. */
    .va a.va-btn-secondary {
      background: rgba(118,184,255,0.05); color: var(--va-fg);
      border-color: rgba(118,184,255,0.42);
      font-weight: 500;
    }
    .va a.va-btn-secondary:hover {
      border-color: var(--va-accent);
      background: rgba(118,184,255,0.11);
      color: var(--va-accent);
      transform: translateY(-1px);
    }
    .va-meta {
      font-family: var(--va-mono); font-size: 11px;
      color: var(--va-fg-faint);
      letter-spacing: 0.04em;
      display: flex; gap: 8px; flex-wrap: wrap;
    }
    .va-dot { color: var(--va-border); }

    /* HERO SCHEMA: atomic record machine view */
    /* Flat panel: institutional terminal, not SaaS. No glow, blur, gradient, or radius. */
    .va-hero-schema {
      position: relative;
      padding: 18px 22px 20px;
      background: var(--va-bg-2);
      border: 1px solid var(--va-border);
    }
    .va-schema-tab {
      position: relative; z-index: 1;
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: var(--va-mono);
      font-size: 11.5px;
      letter-spacing: 0.02em;
      margin: -4px -6px 16px;
      padding: 8px 10px;
      background: rgba(118,184,255,0.06);
      border: 1px solid rgba(118,184,255,0.18);
    }
    .va-schema-method {
      background: var(--va-accent);
      color: var(--va-bg);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      padding: 3px 8px;
    }
    .va-schema-endpoint {
      color: var(--va-fg);
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-weight: 500;
    }
    .va-schema-status {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: var(--va-mono);
      font-size: 10px;
      color: var(--va-up);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .va-schema-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--va-up);
      box-shadow: 0 0 10px rgba(111,221,157,0.6);
    }
    .va-schema-code {
      position: relative; z-index: 1;
      font-family: var(--va-mono);
      font-size: 11.5px;
      line-height: 1.7;
      color: #5a6068;
      margin: 0;
      max-height: 392px;
      overflow: hidden;
      background: transparent;
      white-space: pre;
      tab-size: 2;
    }
    /* Bottom fade — the record continues; reads as a live window, not a cut-off. */
    .va-hero-schema::after {
      content: "";
      position: absolute;
      left: 1px; right: 1px; bottom: 1px;
      height: 84px;
      background: linear-gradient(180deg, rgba(20,24,29,0), var(--va-bg-2));
      pointer-events: none;
      z-index: 2;
    }
    /* Syntax colors moved to global block below. Astro scoping breaks set:html spans */
    .va-schema-access {
      margin-top: 36px;
      padding-top: 20px;
      border-top: 1px solid var(--va-border);
      max-width: 480px;
    }
    .va-schema-access-label {
      font-family: var(--va-mono);
      font-size: 10.5px;
      color: var(--va-accent);
      letter-spacing: 0.16em;
      margin-bottom: 12px;
      font-weight: 600;
    }
    .va a.va-schema-access-row {
      display: grid;
      grid-template-columns: 68px 1fr auto;
      gap: 14px;
      font-family: var(--va-mono);
      font-size: 13px;
      line-height: 2.0;
      align-items: baseline;
      color: inherit;
      text-decoration: none;
      padding: 4px 8px;
      margin: 0 -8px;
      border-radius: 3px;
      transition: background 0.15s, color 0.15s;
    }
    .va a.va-schema-access-row:hover {
      background: rgba(118,184,255,0.08);
    }
    .va a.va-schema-access-row:hover .va-schema-access-val,
    .va a.va-schema-access-row:hover .va-schema-access-arrow {
      color: var(--va-fg);
    }
    .va-schema-access-key {
      color: var(--va-accent);
      font-size: 11px;
      letter-spacing: 0.10em;
      font-weight: 700;
    }
    .va-schema-access-val {
      color: var(--va-fg-muted);
      transition: color 0.15s;
    }
    .va-schema-access-arrow {
      color: var(--va-fg-faint);
      font-size: 12px;
      transition: color 0.15s;
    }
    .va-schema-access-note {
      font-family: var(--va-mono);
      font-size: 11px;
      color: var(--va-fg-faint);
      letter-spacing: 0.04em;
      margin-top: 10px;
      padding-top: 6px;
    }
    .va-schema-foot {
      position: relative; z-index: 1;
      font-family: var(--va-mono);
      font-size: 12.5px;
      color: var(--va-fg-muted);
      letter-spacing: 0.04em;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid var(--va-border);
    }

    /* WIRES */
    .va-wires {
      max-width: 1280px;
      margin: 0 auto;
      padding: 24px 40px 40px;
    }
    .va-signal-header {
      margin-bottom: 32px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--va-border);
    }
    .va-signal-intro {
      margin-bottom: 22px;
      max-width: 720px;
    }
    .va-signal-eyebrow {
      font-family: var(--va-mono);
      font-size: 13px;
      letter-spacing: 0.18em;
      color: var(--va-accent);
      font-weight: 700;
      margin-bottom: 18px;
    }
    .va-signal-mark {
      color: var(--va-fg);
      background: rgba(118,184,255,0.10);
      padding: 2px 8px;
      margin-left: 4px;
      border-radius: 2px;
    }
    .va-signal-title {
      font-family: var(--va-mono);
      font-size: clamp(24px, 3vw, 34px);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.015em;
      text-transform: lowercase;
      margin: 0 0 14px;
      color: var(--va-fg);
    }
    .va-signal-tagline {
      font-family: var(--va-sans);
      font-size: 15.5px;
      line-height: 1.55;
      color: var(--va-fg-muted);
      margin: 0;
    }

    /* Homepage live signal feed (truncated /signals/ ledger) */
    .va-feed { max-width: 1280px; }
    .va-feed-h {
      font-family: var(--va-mono);
      font-size: 10.5px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--va-fg-muted);
      padding-bottom: 8px; margin-bottom: 4px;
      border-bottom: 1px solid var(--va-rule);
    }
    .va-feed-h-tag { color: var(--va-fg-faint); font-weight: 400; }
    .va-ledger {
      width: 100%; border-collapse: collapse;
      font-family: var(--va-mono); font-size: 11.5px;
    }
    .va-ledger td {
      padding: 7px 14px 7px 0;
      border-bottom: 1px solid var(--va-rule);
      vertical-align: baseline; white-space: nowrap;
    }
    .va-ledger tr:last-child td { border-bottom: 0; }
    .va-ledger-row { cursor: pointer; }
    /* hover-only — touch devices "stick" :hover after a tap, which left one headline blue */
    @media (hover: hover) {
      .va-ledger-row:hover td { background: var(--va-bg-2); }
      .va-ledger-row:hover .va-l-head a { color: var(--va-accent); }
    }
    .va-l-time { color: var(--va-fg-faint); font-variant-numeric: tabular-nums; }
    .va-l-id { color: var(--va-accent); }
    .va-l-type { font-weight: 700; font-size: 10.5px; letter-spacing: 0.08em; }
    .va-type-cross_venue_divergence { color: var(--va-accent); }
    .va-type-benchmark_drift { color: #d4b850; }
    .va-type-news_cycle { color: var(--va-up); }
    .va-type-volume_spike { color: var(--va-down); }
    .va-l-head { white-space: normal; width: 100%; }
    .va-l-head a { color: var(--va-fg); text-decoration: none; }
    .va-l-telem { margin-left: 0.6em; color: var(--va-fg-muted, var(--va-fg)); font-size: 11px; opacity: 0.6; white-space: nowrap; }
    @media (hover: hover) { .va-l-head a:hover { color: var(--va-accent); } }
    .va-l-venues { color: var(--va-fg-faint); font-size: 10.5px; letter-spacing: 0.04em; }
    .va-feed-foot {
      display: flex; gap: 22px; flex-wrap: wrap;
      margin-top: 14px; padding-top: 12px;
      border-top: 1px solid var(--va-rule);
      font-family: var(--va-mono); font-size: 11px; letter-spacing: 0.04em;
    }
    .va-feed-foot a { color: var(--va-fg-muted); text-decoration: none; text-transform: uppercase; letter-spacing: 0.1em; }
    .va-feed-foot a:hover { color: var(--va-accent); text-decoration: underline; }

    /* FOOTER */
    .va-foot {
      max-width: 1080px;
      margin: 40px auto 0;
      padding: 28px 40px 60px;
      border-top: 1px solid var(--va-border);
      display: flex; justify-content: space-between; flex-wrap: wrap;
      gap: 14px;
    }
    .va-foot-row { display: flex; gap: 20px; flex-wrap: wrap; }
    .va-foot-row a {
      font-family: var(--va-mono); font-size: 11px;
      color: var(--va-fg-muted); text-decoration: none;
      letter-spacing: 0.04em;
    }
    .va-foot-row a:hover { color: var(--va-fg); }
    .va-foot-mono {
      font-family: var(--va-mono); font-size: 10.5px;
      color: var(--va-fg-faint); letter-spacing: 0.04em;
    }

    @media (max-width: 960px) {
      .va-hero-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 36px;
        padding: 48px 24px 72px;
      }
      .va-hero-text { max-width: none; }
      .va-schema-code { font-size: 10.5px; }
      .va-wire-foot { flex-direction: column; align-items: flex-start; }
    }

    /* MOBILE (~390px). Additive only — contain wide children, wrap the nav,
       and keep the .va shell from widening the page past the viewport. */
    @media (max-width: 640px) {
      /* .va breaks out of Base's 24px body padding via -24px side margins.
         Clamp the horizontal break-out so the shell never exceeds the viewport. */
      .va { margin-left: -24px; margin-right: -24px; max-width: 100vw; overflow-x: hidden; }
      .va-head { padding: 18px 18px; flex-wrap: wrap; gap: 12px 16px; }
      .va-head nav { flex-wrap: wrap; gap: 10px 14px; row-gap: 8px; }
      .va-nav-sep { display: none; }
      .va-hero-grid { padding: 28px 18px 56px; gap: 28px; }
      .va-wires { padding: 24px 18px 40px; }
      .va-foot { padding: 24px 18px 48px; }
      /* JSON record scrolls inside its own panel instead of stretching the page */
      .va-hero-schema { padding: 16px 14px 18px; max-width: 100%; overflow: hidden; }
      .va-schema-code { max-width: 100%; overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch; }
      .va-hero-search { max-width: 100%; }

      /* Product buttons were different-width boxes (content-sized, wrapping 2+1). Stack them
         full-width + uniform on phones. */
      .va-cta { flex-direction: column; gap: 10px; }
      .va a.va-btn { width: 100%; justify-content: center; box-sizing: border-box; }

      /* WIRE LEDGER — headlines were clipped at the right edge (5-col nowrap table).
         Reflow each row to a stacked block: a top meta line (time · id · type · venues)
         then the full headline wrapping below. The row is a flex/wrap container so the
         meta cells flow as one line and the headline is forced full-width on its own
         line via order + flex-basis. Mirrors the events-index card reflow. Nothing clipped. */
      .va-ledger, .va-ledger tbody {
        display: block; width: 100%; box-sizing: border-box;
      }
      .va-ledger-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        width: 100%;
        box-sizing: border-box;
        border: 1px solid var(--va-rule);
        padding: 10px 12px;
        margin-bottom: 8px;
      }
      .va-ledger-row td { border: none; padding: 0; white-space: normal; }
      /* meta cells reflow inline as the top line */
      .va-ledger-row .va-l-time,
      .va-ledger-row .va-l-id,
      .va-ledger-row .va-l-type,
      .va-ledger-row .va-l-venues {
        order: 1; margin-right: 10px; font-size: 10.5px; line-height: 1.6;
      }
      /* headline forced onto its own full-width line below the meta, wraps fully */
      .va-ledger-row .va-l-head { order: 2; flex-basis: 100%; width: 100%; margin-top: 6px; }
      .va-ledger-row .va-l-head a { font-size: 14px; line-height: 1.35; }
    }
  </style>

  <style is:global>
    /* JSON syntax colors. Three categories: labels (keys), data (values), counts (numbers). */
    .va-schema-code .t-key  { color: #7faedb; }                    /* sky blue: labels (keys) */
    .va-schema-code .t-str  { color: #d4d7dc; }                    /* off-white: data (all values) */
    .va-schema-code .t-num  { color: #d4b850; }                    /* amber: counts (numbers) */
    .va-schema-code .t-src  { color: #d4d7dc; }                    /* same as t-str: source names are data */
    .va-schema-code .t-prov { color: #d4d7dc; }                    /* same as t-str: provenance values are data */
    .va-schema-code .t-id   { color: #d4d7dc; font-weight: 600; }  /* same color, bolder weight: the anchor */
  </style>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />

  <script is:inline>
    // Whole-row click on the signal feed (matches /signals/ index behavior).
    document.querySelectorAll('.va-ledger-row').forEach((row) => {
      row.addEventListener('click', (ev) => {
        if (ev.target.closest('a')) return;
        const a = row.querySelector('.va-l-head a');
        if (a) window.location.href = a.getAttribute('href');
      });
    });
  </script>
</Base>
