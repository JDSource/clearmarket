---
import Base from './Base.astro';
import { coverageLabel } from '../lib/universe';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  /**
   * Skip the inner site chrome (nav + container).
   * Use this when the page wants to fully control its own hero
   * (e.g. demo/a.astro renders its own header inside .va).
   */
  bareChrome?: boolean;
}

const { title, description, canonical, noindex, bareChrome } = Astro.props;
// The events index has its own full-width terminal search; the global nav search there is
// redundant (the dual-search bug). Suppress it on that route only — it returns on every other page.
const path = Astro.url.pathname.replace(/\/+$/, '');
const isEventsIndex = path === '/events';
---
<Base title={title} description={description} canonical={canonical} noindex={noindex} bare>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <slot name="head" />
  </Fragment>

  <div class="va">
    {!bareChrome && (
      <div class="va-sticky-chrome">
        <header class="va-head">
          <a class="va-brand" href="/">
            <span class="va-mark">CM</span>
            <span class="va-wordmark">ClearMarket</span>
          </a>
          <nav>
            <a class="va-nav-product" href="/events/">CM Data</a>
            <a class="va-nav-product" href="/signals/">CM Signal</a>
            <span class="va-nav-sep" aria-hidden="true">·</span>
            <a href="/api/">API / MCP</a>
            <a href="/screens/">Screens</a>
            <a href="/schema/">Schema</a>
            <a href="/methodology/" target="_blank" rel="noopener">Methodology</a>
            <a href="https://github.com/JDSource/clearmarket">GitHub</a>
            {!isEventsIndex && (
              <form class="va-nav-search" role="search" action="/events/" method="get">
                <input type="search" name="q" id="cm-search-input" placeholder="SEARCH EVENTS…" aria-label="Search events" autocomplete="off" />
                <div class="cm-search-results" id="cm-search-results" hidden></div>
              </form>
            )}
          </nav>
        </header>
        {/* Global system status bar — running grid header on every page (Gemini design direction).
           TRUE values only: prices refresh hourly; live computed coverage; no daily-signal
           cadence claim until CM Signal ships. */}
        <div class="va-statusbar">
          <span class="va-sb-dot" aria-hidden="true"></span>
          <span>SYSTEM: LIVE</span>
          <span class="va-sb-sep">·</span>
          <span>PRICES: HOURLY REFRESH</span>
          <span class="va-sb-sep">·</span>
          <span>COVERAGE: {coverageLabel().toUpperCase()}</span>
          <span class="va-sb-sep">·</span>
          <span>KALSHI + POLYMARKET</span>
        </div>
        {/* Sub-nav slot — pages pass a <nav slot="subnav"> here. Renders directly under
           main header, sticky together as a single chrome block per patch brief. */}
        <slot name="subnav" />
      </div>
    )}

    <main class="va-main">
      <slot />
    </main>

    {!bareChrome && (
      <footer class="va-foot">
        <div class="va-foot-row">
          <a href="/signals/">Signals</a>
          <a href="/screens/">Screens</a>
          <a href="/methodology/" target="_blank" rel="noopener">Methodology</a>
          <a href="/research/resolution-clarity-index/">Resolution backtest</a>
          <a href="/api/">API</a>
          <a href="/schema/">Schema</a>
          <a href="/api/#mcp">MCP</a>
          <a href="/llms.txt">llms.txt</a>
          <a href="https://github.com/JDSource/clearmarket">GitHub</a>
          <a href="mailto:hello@clearmarket.fyi">hello@clearmarket.fyi</a>
        </div>
        <div class="va-foot-mono">
          Atomic claims · JSON-LD · MCP · v0.2.0
        </div>
      </footer>
    )}
  </div>

  <script is:inline>
    // Header search — fetch the build-time index once, filter client-side, keyboard-navigable dropdown.
    (() => {
      const input = document.getElementById('cm-search-input');
      const box = document.getElementById('cm-search-results');
      if (!input || !box) return;
      let idx = null, timer = null, active = -1;
      const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      async function load() {
        if (idx === null) { try { idx = await (await fetch('/search-index.json')).json(); } catch (e) { idx = []; } }
        return idx;
      }
      function render(q) {
        const ql = q.trim().toLowerCase();
        active = -1;
        if (ql.length < 2) { box.hidden = true; box.innerHTML = ''; return; }
        const hits = idx.filter((e) => e.q.indexOf(ql) !== -1).slice(0, 8);
        box.innerHTML = hits.length
          ? hits.map((e) => '<a class="cm-search-hit" href="/events/' + e.s + '/">' + esc(e.t) + '</a>').join('')
          : '<div class="cm-search-empty">no match</div>';
        box.hidden = false;
      }
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(async () => { await load(); render(input.value); }, 160);
      });
      input.addEventListener('keydown', (ev) => {
        const hits = Array.from(box.querySelectorAll('.cm-search-hit'));
        if (ev.key === 'ArrowDown' && hits.length) { ev.preventDefault(); active = Math.min(active + 1, hits.length - 1); }
        else if (ev.key === 'ArrowUp' && hits.length) { ev.preventDefault(); active = Math.max(active - 1, 0); }
        else if (ev.key === 'Enter') {
          // Only intercept Enter when the user has arrow-selected a specific suggestion — jump
          // straight to that event. Otherwise let the form submit to /events/?q=… (the full
          // index results page), which is the expected behavior (esp. on mobile where the
          // typeahead dropdown isn't easily navigable).
          if (active >= 0 && hits[active]) { ev.preventDefault(); location.href = hits[active].getAttribute('href'); }
          return;
        }
        else if (ev.key === 'Escape') { box.hidden = true; return; }
        else return;
        hits.forEach((h, i) => h.classList.toggle('cm-search-active', i === active));
      });
      document.addEventListener('click', (ev) => {
        const wrap = input.closest('.va-nav-search');
        if (wrap && !wrap.contains(ev.target)) box.hidden = true;
      });
    })();
  </script>

  <style>
    .va {
      --va-bg: #0e1014;
      --va-bg-2: #14181d;
      --va-surface: #1a1e25;
      --va-fg: #e6e8eb;
      --va-fg-muted: #aab0b8;
      --va-fg-faint: #6c727a;
      --va-border: #232830;
      --va-rule: #1d2128;
      --va-accent: #76b8ff;
      --va-up: #6fdd9d;
      --va-down: #e08272;
      --va-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      --va-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--va-bg);
      color: var(--va-fg);
      font-family: var(--va-sans);
      min-height: 100vh;
      /* break out of Base.astro's 48px / 24px / 96px padding */
      margin: -48px -24px -96px;
      padding: 0;
    }
    .va a { color: inherit; }

    /* STICKY CHROME — main header + optional sub-nav slot, sticky together at top */
    .va-sticky-chrome {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(14,16,20,0.96);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--va-border);
      margin-bottom: 28px;
    }
    .va-head {
      max-width: 1280px;
      margin: 0 auto;
      padding: 18px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .va-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
    }
    .va-mark {
      width: 28px;
      height: 28px;
      background: var(--va-fg);
      color: var(--va-bg);
      font-family: var(--va-mono);
      font-size: 10.5px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 0;
      letter-spacing: 0.04em;
    }
    .va-wordmark {
      font-family: var(--va-mono);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--va-accent);
    }
    .va-head nav {
      display: flex;
      gap: 22px;
      align-items: center;
    }
    .va-head nav a {
      font-family: var(--va-mono);
      font-size: 11.5px;
      color: var(--va-fg-muted);
      text-decoration: none;
      letter-spacing: 0.04em;
    }
    .va-head nav a:hover { color: var(--va-fg); }
    .va-nav-product {
      color: var(--va-accent) !important;
      font-weight: 600;
    }
    .va-nav-search { margin: 0; display: flex; }
    .va-nav-search input {
      font-family: var(--va-mono);
      font-size: 11.5px;
      color: var(--va-fg);
      background: var(--va-bg-surface, rgba(255,255,255,0.04));
      border: 1px solid var(--va-accent);
      border-radius: 0;
      padding: 5px 9px;
      width: 150px;
      outline: none;
      letter-spacing: 0.02em;
      transition: border-color 0.12s, width 0.12s;
    }
    .va-nav-search input::placeholder { color: var(--va-fg-faint); }
    .va-nav-search input:focus { border-color: var(--va-fg); width: 190px; }
    /* iOS auto-zooms focused inputs under 16px and never zooms back — pin to 16px on touch. */
    @media (pointer: coarse) { .va-nav-search input { font-size: 16px; } }
    .va-nav-search { position: relative; }

    /* Global status bar — institutional running header, zero-radius, hard rule */
    .va-statusbar {
      max-width: 1280px;
      margin: 0 auto;
      padding: 7px 40px;
      border-top: 1px solid var(--va-rule);
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--va-mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      color: var(--va-fg-muted);
      text-transform: uppercase;
      overflow-x: auto;
      white-space: nowrap;
    }
    .va-sb-dot {
      width: 6px;
      height: 6px;
      background: var(--va-up);
      flex: 0 0 auto;
    }
    .va-sb-sep { color: var(--va-border); }
    .va-nav-sep {
      font-family: var(--va-mono);
      font-size: 11.5px;
      color: var(--va-fg-faint);
      letter-spacing: 0.04em;
    }
    .va-cta-mini {
      border: 1px solid var(--va-border);
      padding: 6px 12px;
      border-radius: 0;
    }
    .va-cta-mini:hover { border-color: var(--va-fg); }

    /* INNER PAGE MAIN — max-width container for inner pages */
    .va-main {
      max-width: 1080px;
      margin: 0 auto;
      padding: 24px 40px 40px;
    }

    /* FOOTER — shared */
    .va-foot {
      max-width: 1080px;
      margin: 40px auto 0;
      padding: 28px 40px 60px;
      border-top: 1px solid var(--va-border);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
    }
    .va-foot-row {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }
    .va-foot-row a {
      font-family: var(--va-mono);
      font-size: 11px;
      color: var(--va-fg-muted);
      text-decoration: none;
      letter-spacing: 0.04em;
    }
    .va-foot-row a:hover { color: var(--va-fg); }
    .va-foot-mono {
      font-family: var(--va-mono);
      font-size: 10.5px;
      color: var(--va-fg-faint);
      letter-spacing: 0.04em;
    }

    @media (max-width: 720px) {
      /* Chrome must never widen the page: the sticky block and its rows clamp to viewport. */
      /* Gemini direction: let the global header + search scroll OUT of view on small screens;
         only the section sub-nav stays pinned (sticky rule on .cm-subnav in cm-event.css). */
      .va-sticky-chrome { position: static; max-width: 100%; overflow-x: hidden; }
      .va-head { padding: 16px 18px; flex-wrap: wrap; gap: 10px 14px; max-width: 100%; }
      .va-head nav { gap: 12px 14px; flex-wrap: wrap; row-gap: 8px; max-width: 100%; }
      .va-nav-sep { display: none; }
      .va-nav-search { order: 99; flex-basis: 100%; min-width: 0; }
      .va-nav-search input { width: 100%; }
      .va-nav-search input:focus { width: 100%; }
      /* status bar scrolls horizontally inside its own bar (already nowrap), never the page */
      /* Cull the SYSTEM:LIVE / COVERAGE status strip on small screens — it was sticky chrome
         crowding the title, and the info isn't essential on mobile. */
      .va-statusbar { display: none; }
      .va-main { padding: 16px 18px 40px; max-width: 100%; }
      .va-foot { padding: 24px 18px 48px; max-width: 100%; }
    }
  </style>

  <style is:global>
    /* Dark page root so macOS rubber-band overscroll reveals the dark theme, not a white gap
       (the .va shell is dark but sits inside Base.astro's light html/body). */
    html { background: #0e1014; }
    /* Search dropdown — GLOBAL (not scoped) because the result rows are created by JS innerHTML and
       never receive Astro's scope attribute, so scoped rules would not match them (the wall-of-text bug). */
    .cm-search-results {
      position: absolute; top: 100%; right: 0; margin-top: 4px;
      width: 340px; max-width: 78vw; max-height: 360px; overflow-y: auto; z-index: 200;
      background: #14181d; border: 1px solid #232830;
    }
    .cm-search-hit {
      display: block; padding: 8px 11px;
      font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 12.5px;
      color: #e6e8eb; text-decoration: none; border-bottom: 1px solid #1d2128;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cm-search-hit:last-child { border-bottom: 0; }
    .cm-search-hit:hover, .cm-search-hit.cm-search-active { background: #1a1e25; color: #76b8ff; }
    .cm-search-empty { padding: 8px 11px; font-size: 12px; color: #6c727a; }
    /* JSON syntax colors. Three categories: labels (keys), data (values), counts (numbers).
       Defined globally because Astro scoping breaks set:html span scoping. */
    .va-schema-code .t-key  { color: #7faedb; }
    .va-schema-code .t-str  { color: #d4d7dc; }
    .va-schema-code .t-num  { color: #d4b850; }
    .va-schema-code .t-src  { color: #d4d7dc; }
    .va-schema-code .t-prov { color: #d4d7dc; }
    .va-schema-code .t-id   { color: #d4d7dc; font-weight: 600; }

    /* Number emphasis in prose — used in wire bullets and similar */
    .va .num {
      color: var(--va-fg);
      font-weight: 600;
    }
  </style>
</Base>
