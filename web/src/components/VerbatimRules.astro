---
/* VerbatimRules — the #resolution section. Two parts:
 *   1. RESOLUTION ARCHITECTURE grid — one row per venue: proposer / source / citation /
 *      source-type / arbitration / class / analyst notes (jargon mapped via labels.ts).
 *   2. VERBATIM RULES — the platform's exact resolution-rules text per venue.
 * The grid is the structured-governance differentiator; the verbatim text is the proof.
 */
import type { Event, Market, ResolutionLogEntry } from '../lib/universe';
import { arbiterLabel, proposerLabel, isPlaceholderCitation } from '../lib/labels';
const { event, markets, resolutionLog = [] } = Astro.props as { event: Event; markets: Market[]; resolutionLog?: ResolutionLogEntry[] };

// Resolved-history ledger: one row per settled market. The distinguisher comes from the market's
// own question; venue + date + final price are verbatim from the price/date snapshot. Outcome is
// YES/NO when the final price was decisive, PENDING when the snapshot predates settlement.
const mByIdVR = new Map(markets.map((m) => [m.market_id, m]));
function fmtDay(s: string | null | undefined): string { return s ? s.slice(0, 10) : '—'; }
function fmtPrice(p: number | null): string { return p === null || p === undefined ? '—' : `${Math.round(p * 100)}%`; }

const VENUES = Array.from(new Set(markets.map((m) => m.platform))) as ('kalshi' | 'polymarket')[];
const blocks = VENUES.map((v) => {
  const vm = markets.filter((m) => m.platform === v);
  const rep = vm[0];
  return {
    venue: v,
    count: vm.length,
    rules: rep?.resolution_rules_raw ?? null,
    source: rep?.resolution_source ?? null,
    sourceUrl: rep?.source_citation ?? null,
    sourceType: (rep as any)?.resolution_source_type ?? (rep as any)?.source_type ?? null,
    underlyingRef: rep?.underlying_reference ?? null,
    proposer: rep?.resolution_proposer ?? null,
    arbiter: rep?.arbitration_model ?? null,
    regClass: ((rep as any)?.regulatory_class ?? 'Other') as string,
    notes: (rep as any)?.analyst_notes ?? null,
    commitment: (rep as any)?.source_commitment ?? null,
    hedge: (rep as any)?.source_hedge_text ?? null,
    provenance: (rep as any)?.resolution_source_provenance ?? null,
    // full source set (source-layer refactor): every venue-listed source + prose-surfaced
    // authorities, each tagged with its provenance tier. This is what makes the
    // menu-vs-committed-authority distinction VISIBLE, not just baked into the grade.
    sources: (((rep as any)?.resolution_source_list ?? null) as
      { name?: string | null; url?: string | null; provenance?: string | null }[] | null),
    sourceOfRecord: (rep as any)?.source_of_record ?? null,
    mechanism: (rep as any)?.source_mechanism ?? null,
    // exchange-notice conflict (v3.7): the venue's own page banner names a settlement
    // source that differs from its committed settlement_sources entry. The grade cap is
    // computed at enrich; here we NARRATE it — a page that grades C for a source conflict
    // must say so where the sources are listed, not leave the reader to reconstruct it.
    noticeConflict: Boolean((rep as any)?.source_notice_conflict),
    noticeText: (((rep as any)?.exchange_notice ?? null) as { text?: string } | null)?.text ?? '',
  };
});
// Feed identity from a citation URL: last two path segments, %2F-decoded — turns
// https://pythdata.app/explore/Metal.XAU%2FUSD into "Metal.XAU/USD". Null when the URL
// has no meaningful slug (bare domains).
function feedSlug(u: string | null | undefined): string | null {
  if (!u) return null;
  try {
    const path = decodeURIComponent(new URL(u.startsWith('http') ? u : `https://${u}`).pathname);
    const segs = path.split('/').filter(Boolean);
    if (!segs.length) return null;
    const tail = segs.slice(-2).join('/');
    // require it to look like a feed identifier, not a generic path
    return /[A-Z]{2,}|\./.test(tail) ? tail : null;
  } catch { return null; }
}
// Auto analyst note when the conflict flag is set and no hand-written note exists.
const CONFLICT_NOTE =
  "The venue's own page notice names a settlement source different from its committed " +
  "settlement_sources entry; no rules mechanism governs the transition. Grade capped.";
const MECH_LABEL: Record<string, string> = {
  single_authority: 'single authority',
  precedence: 'stated precedence rule',
  quorum: 'quorum — multiple sources must agree',
};
// The LITERAL platform field + raw value, no normalizing. Maps our provenance tag back to the
// actual platform API field, and shows the verbatim value the platform returned (Kalshi's
// settlement_sources name, or the URL literally present in Polymarket's description) — never our
// shortened "bea.gov" or our "uncommitted" label (those are our classifications, in the table above).
function realUrl(u: string | null): string | null {
  return u && !isPlaceholderCitation(u) ? u : null;
}
function verbatimSource(b: any): { field: string; val: string; href: string | null } {
  const u = realUrl(b.sourceUrl);
  if (b.provenance === 'kalshi_series_settlement_sources' && b.source)
    return { field: 'settlement_sources', val: `"${b.source}"`, href: u };
  if (b.provenance === 'polymarket_description' && u)
    return { field: 'description', val: u, href: u };
  if (b.provenance === 'polymarket_description' && b.source)
    return { field: 'description', val: `"${b.source}"`, href: null };
  if (b.commitment === 'uncommitted')
    return { field: 'resolutionSource', val: '∅  no committed source — see rules text above', href: null };
  if (b.source) return { field: 'resolution_source', val: `"${b.source}"`, href: u };
  return { field: 'resolutionSource', val: '∅  none returned', href: null };
}
---
<section id="resolution" class="vr-sec">
  <div class="cm-section-h">resolution architecture</div>
  <div class="cm-table-wrap">
    <table class="cm-res-table">
      <thead>
        <tr>
          <th scope="col">venue</th>
          <th scope="col" class="cm-tt cm-th-help" data-tt="Who proposes the resolution answer. Exchange Staff: venue employees. Whitelisted Proposers: approved oracle proposers.">proposer</th>
          <th scope="col" class="cm-tt cm-th-help" data-tt="The venue's committed resolution source. A named authority = committed. 'uncommitted' = the venue gave only illustrative/placeholder language (e.g. 'a consensus of credible reporting') without naming a definitive source. 'not provided' = no source language at all.">source</th>
          <th scope="col" class="cm-tt cm-th-help" data-tt="Direct URL to the stated source. 'not provided' = no link given, or only a venue homepage (not a real citation).">citation</th>
          <th scope="col" class="cm-tt cm-th-help" data-tt="Dispute-resolution path. Kalshi Staff: internal review, CFTC backstop. Optimistic Oracle (UMA): on-chain token-holder vote on dispute.">arbitration</th>
          <th scope="col" class="cm-tt cm-th-help" data-tt="Regulatory class. DCM: CFTC-regulated Designated Contract Market. DeFi: token-vote-arbitrated protocol.">class</th>
          <th scope="col">analyst notes</th>
        </tr>
      </thead>
      <tbody>
        {blocks.map((b) => (
          <tr data-cm-venue={b.venue}>
            <td class="cm-res-td-venue">{b.venue}</td>
            <td>{b.proposer ? <code class="cm-code-pill">{proposerLabel(b.proposer)}</code> : '—'}</td>
            <td class="cm-res-td-src">{
              b.source ? <span class="cm-verbatim">{b.source}</span>
              : b.commitment === 'uncommitted'
                ? <span class="cm-dd-uncommitted cm-tt" data-tt={b.hedge ? `Venue named no definitive source — illustrative/placeholder language only: “${b.hedge}”` : 'Venue named candidate sources but did not commit to a definitive one (illustrative / placeholder language). See verbatim rules below.'}>uncommitted</span>
                : <span class="cm-dd-empty">not provided</span>
            }</td>
            <td>{b.sourceUrl && !isPlaceholderCitation(b.sourceUrl) ? <a class="cm-res-link" href={b.sourceUrl} rel="noopener nofollow">link</a> : <span class="cm-dd-empty">not provided</span>}</td>
            <td>{b.arbiter ? <code class="cm-code-pill">{arbiterLabel(b.arbiter)}</code> : '—'}</td>
            <td><code class={`cm-class-chip cm-class-${b.regClass.toLowerCase()}`}>{b.regClass}</code></td>
            <td class="cm-res-td-notes">{b.notes ?? (b.noticeConflict ? <span class="vr-conflict-note">{CONFLICT_NOTE}</span> : <span class="cm-dd-empty">—</span>)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="vr-rules-h">verbatim rules</div>
  {blocks.map((b) => (
    <div class="vr-block">
      <div class="vr-head">
        <span class="vr-venue">{b.venue}</span>
        <span class="vr-meta">{b.count} {b.count === 1 ? 'market' : 'markets'} · share this text</span>
      </div>
      {b.rules
        ? <div class="vr-text">{b.rules}</div>
        : <div class="vr-text vr-empty">No verbatim resolution text captured for this venue.</div>}
      {(() => { const vs = verbatimSource(b); return (
        <div class="vr-src-line">
          <span class="vr-k">platform source field</span>
          <code class="vr-src-code"><span class="vr-src-key">{b.venue}.{vs.field}</span> → {
            vs.href && vs.val === vs.href
              ? <a class="cm-res-link" href={vs.href} rel="noopener nofollow">{vs.href}</a>
              : vs.val
          }{vs.href && vs.val !== vs.href ? <> <a class="cm-res-link" href={vs.href} rel="noopener nofollow">↗</a></> : null}</code>
        </div>
      ); })()}
      {b.sources && b.sources.length > 0 && (
        <div class="vr-srcs">
          {/* Header: muted count; conflict state is a borderless amber string, not a chip —
              one badge style per block, tabular rows below (badging reduced per Jeremy +
              design review: unified tag typography, grid alignment, no outline pills). */}
          <span class="vr-k">sources ({b.sources.length}){!b.noticeConflict && b.mechanism
            ? ` · ${MECH_LABEL[b.mechanism] ?? b.mechanism}` : ''}</span>
          {b.noticeConflict && <span class="vr-src-warn"> · source conflict</span>}
          {/* compact 3-column grid (name | feed id | tag) in a soft sub-card — max-content
              columns keep the tag NEAR the name instead of fleeing to the card edge
              (the 1fr + justify-end version opened a 600px scanning chasm) */}
          <div class="vr-src-grid">
            {b.sources.map((s) => {
              const isNoticeSrc = b.noticeConflict && s.name && b.noticeText.includes(s.name);
              const isSor = b.sourceOfRecord && s.name && s.name === b.sourceOfRecord;
              const slug = b.noticeConflict && s.url && s.name ? feedSlug(s.url) : null;
              return (
                <>
                  <span class="vr-src-cell">
                    {s.url
                      ? <a class="cm-res-link" href={s.url.startsWith('http') ? s.url : `https://${s.url}`} rel="noopener nofollow">{s.name ?? s.url}</a>
                      : <span class="vr-src-name">{s.name}</span>}
                  </span>
                  {/* feed identity from the citation URL — without it a conflict row reads
                      as "Pyth gold vs Pyth gold" and the contradiction is invisible */}
                  <span class="vr-src-cell vr-src-slug">{slug && !s.name!.includes(slug) ? slug : ''}</span>
                  {/* ONE plain-language tag per row: "committed source" = controlling AND
                      from the venue's formal commitment (kills the source-of-record ·
                      venue-listed jargon pair) */}
                  <span class="vr-src-cell">
                    {isSor
                      ? <span class="vr-src-tag is-sor">committed source</span>
                      : isNoticeSrc
                        ? <span class="vr-src-tag is-notice">from page notice</span>
                        : <span class="vr-src-tag">{s.provenance === 'clearmarket_editorial' ? 'from rules text' : 'venue-listed'}</span>}
                  </span>
                </>
              );
            })}
          </div>
        </div>
      )}
    </div>
  ))}

  {resolutionLog.length > 0 && (
    <div class="rl-wrap">
      <div class="vr-rules-h">resolution history</div>
      <div class="cm-table-wrap">
        <table class="cm-res-table rl-table">
          <thead>
            <tr>
              <th scope="col">outcome</th>
              <th scope="col">market</th>
              <th scope="col">venue</th>
              <th scope="col">resolved</th>
              <th scope="col" class="cm-tt cm-th-help" data-tt="Final price observed at/after settlement. YES near 100%, NO near 0%. PENDING = the snapshot predates settlement; the next refresh upgrades it to a real outcome.">final price</th>
            </tr>
          </thead>
          <tbody>
            {resolutionLog.map((r) => (
              <tr>
                <td><span class={`rl-badge rl-${(r.to_value || 'pending').toLowerCase()}`}>{r.to_value}</span></td>
                <td class="rl-mkt">{mByIdVR.get(r.market_id)?.question_raw ?? r.market_id}</td>
                <td class="cm-res-td-venue">{r.platform}</td>
                <td><code class="rl-date">{r.occurred_basis === 'deadline' ? `by ${fmtDay(r.occurred_at)}` : fmtDay(r.occurred_at)}</code></td>
                <td><code class="rl-date">{fmtPrice(r.final_price)}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="rl-note">Resolution dates are the venue's settlement timestamps ({resolutionLog.length} resolved {resolutionLog.length === 1 ? 'market' : 'markets'}). Rows shown as "by [date]" carry the contract deadline: the venue no longer exposes a settlement time for them. PENDING upgrades to a final outcome on the next refresh.</div>
    </div>
  )}
</section>

<style>
  .vr-sec { margin-bottom: var(--cm-space-section-rule); scroll-margin-top: 120px; }
  .vr-rules-h {
    font-family: var(--cm-font-mono); font-size: 10px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.16em; color: var(--cm-fg-muted);
    margin: 22px 0 10px;
  }
  .vr-block {
    border: 1px solid var(--cm-border-hairline); background: var(--cm-bg-surface);
    padding: 14px 16px; margin-bottom: 12px;
  }
  .vr-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 8px; }
  .vr-venue {
    font-family: var(--cm-font-mono); font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--cm-fg-primary);
  }
  .vr-meta { font-family: var(--cm-font-mono); font-size: 10px; color: var(--cm-fg-muted); }
  .vr-ref { font-family: var(--cm-font-sans); font-size: 11.5px; color: var(--cm-fg-secondary); padding-bottom: 8px; }
  .vr-k { font-family: var(--cm-font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--cm-fg-faint); margin-right: 6px; }
  .vr-text {
    font-family: var(--cm-font-sans); font-size: 12px; line-height: 1.55; color: var(--cm-fg-secondary);
    white-space: pre-wrap; padding-left: 12px; border-left: 2px solid var(--cm-border-rule);
  }
  .vr-empty { color: var(--cm-fg-faint); font-style: italic; }
  /* full source set */
  .vr-srcs { margin-top: 8px; }
  /* tabular source rows: name+identifier | role/origin tags — aligned grid, unified tag
     typography, no outline pills (one style of metadata text, tinted by role) */
  .vr-src-grid {
    display: inline-grid; grid-template-columns: max-content max-content max-content;
    column-gap: 20px; row-gap: 7px; align-items: baseline;
    margin-top: 7px; padding: 7px 10px;
    border-radius: 4px;
    background: color-mix(in srgb, currentColor 4%, transparent);
    font-family: var(--cm-font-mono); font-size: 11px; color: var(--cm-fg-secondary);
  }
  .vr-src-cell { min-width: 0; }
  .vr-src-name { color: var(--cm-fg-primary); }
  .vr-src-slug { font-family: var(--cm-font-mono, monospace); color: var(--cm-fg-faint); }
  /* soft pills: low-contrast fill, no border — bounded without being loud */
  .vr-src-tag {
    font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em;
    color: var(--cm-fg-faint); padding: 1px 6px; border-radius: 3px;
    background: color-mix(in srgb, currentColor 11%, transparent);
  }
  .vr-src-tag.is-sor { color: var(--cm-dot-positive, #36c08a); }
  .vr-src-tag.is-notice { color: var(--cm-grade-c, #d9a53f); }
  .vr-src-warn {
    font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em;
    color: var(--cm-grade-c, #d9a53f);
  }
  .vr-conflict-note { color: var(--cm-grade-c, #d9a53f); }
  /* resolution history ledger */
  .rl-wrap { margin-top: 22px; }
  .rl-table .rl-mkt { font-family: var(--cm-font-sans); font-size: 11.5px; color: var(--cm-fg-secondary); }
  .rl-date { font-family: var(--cm-font-mono); font-size: 11px; color: var(--cm-fg-secondary); }
  .rl-badge {
    font-family: var(--cm-font-mono); font-size: 9.5px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em; padding: 1px 6px; border-radius: 2px;
    border: 1px solid var(--cm-border-hairline);
  }
  .rl-yes { color: var(--cm-dot-positive, #36c08a); border-color: color-mix(in srgb, currentColor 45%, transparent); }
  .rl-no { color: var(--cm-fg-muted); }
  .rl-pending { color: var(--cm-accent, #c8a24a); border-color: color-mix(in srgb, currentColor 45%, transparent); }
  .rl-note { font-family: var(--cm-font-mono); font-size: 9.5px; color: var(--cm-fg-faint); margin-top: 8px; }
</style>
